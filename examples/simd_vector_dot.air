# Fixed-width SIMD: dot product of two f32 arrays of n elements (n a multiple of 4), four
# lanes at a time in 128-bit vectors, with a fused multiply-add accumulator and a lane sum.
# For any length and the CPU's full vector width, see saxpy_vx.air and kernels/.
fn simd_dot(a:ptr, b:ptr, n:i64)->f32
  b0:
    z = cst 0.0:f32
    acc0 = splat z:v128
    jmp loop(0:i64, acc0)
  loop(i:i64, acc:v128):
    more = lt i, n
    br more, body, done
  body:
    off = mul i, 4:i64
    pa = add a, off
    pb = add b, off
    va = ld pa:v128
    vb = ld pb:v128
    acc2 = vfma va, vb, acc:f32
    i2 = add i, 4:i64
    jmp loop(i2, acc2)
  done:
    s = vsum acc:f32
    ret s
