# 128-bit SIMD Parallel Vector Dot Product with Dynamic Heap Allocation
# Computes 4 parallel f32 multiplications per cycle using hardware SIMD registers
fn simd_dot(p0:ptr, p1:ptr, n:i64)->f32
  b0:
    zero_f = cst 0.0:f32
    vzero = splat zero_f:v128
    zero_i = cst 0:i64
    jmp b1(zero_i, vzero)
  b1(i:i64, vacc:v128):
    cond = lt i, n
    br cond, b2, b3
  b2:
    # 16 bytes per 4xf32 SIMD vector
    sixteen = cst 16:i64
    byte_off = mul i, sixteen
    a_ptr = add p0, byte_off
    b_ptr = add p1, byte_off
    va = ld a_ptr:v128
    vb = ld b_ptr:v128
    vprod = vmul va, vb:f32
    next_vacc = vadd vacc, vprod:f32
    one = cst 1:i64
    next_i = add i, one
    jmp b1(next_i, next_vacc)
  b3:
    # Horizontal accumulation across 4 SIMD lanes
    l0 = extlane vacc, 0:f32
    l1 = extlane vacc, 1:f32
    l2 = extlane vacc, 2:f32
    l3 = extlane vacc, 3:f32
    s01 = add l0, l1
    s23 = add l2, l3
    res = add s01, s23
    ret res
