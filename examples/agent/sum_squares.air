# 0^2 + 1^2 + ... + (n-1)^2: a loop as an agent writes it, with its state in block parameters
fn sum_squares(n:i64)->i64
  b0:
    jmp loop(0:i64, 0:i64)
  loop(i:i64, acc:i64):
    more = lt i, n
    br more, body, done
  body:
    sq = mul i, i
    acc2 = add acc, sq
    i2 = add i, 1:i64
    jmp loop(i2, acc2)
  done:
    ret acc
