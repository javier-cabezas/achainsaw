# Dot product of two f32 arrays: a loop with its state in block parameters
fn dot(a:ptr, b:ptr, n:i64)->f32
  b0:
    jmp loop(0:i64, 0.0:f32)
  loop(i:i64, acc:f32):
    more = lt i, n
    br more, body, done
  body:
    x = ld a[i]:f32
    y = ld b[i]:f32
    p = mul x, y
    acc2 = add acc, p
    i2 = add i, 1:i64
    jmp loop(i2, acc2)
  done:
    ret acc
