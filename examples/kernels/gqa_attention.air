# Grouped-query attention for one decode step (Llama 3, Mistral, Qwen), on all cores: nh
# query heads share nkv KV heads (nh / nkv per group) over positions 0 .. t_len - 1 of a
# bf16 KV cache:
#   out[h] = sum_t softmax_t(q[h] . K[g][t] / sqrt(hd)) V[g][t],   g = h / (nh / nkv)
# q: f32 [nh x hd]; kc, vc: bf16 [nkv x max_ctx x hd], head-major like PyTorch's
# [batch, heads, positions, dim] caches; out: f32 [nh x hd]. Any hd; t_len <= max_ctx.
#
# Flash-decoding: the first `par` runs one task per (KV head, 256-position split), so even a
# single sequence keeps every core busy. Each task is the standard library's attn_split: it
# scores its positions for the group's heads, 4 at a time with their dot products in
# registers and each K vector widened from bf16 once for the 4; takes the split's softmax;
# and accumulates P V one vector of columns at a time over its positions, again 4 heads in
# registers. It leaves per head and split the max, the sum of exponentials and the
# unnormalized output. The second `par`, one task per query head, merges the splits
# (attn_merge), each rescaled by exp(m_split - m), and divides by the total.

use attn_split, attn_merge

fn gqa_attention(q:ptr, kc:ptr, vc:ptr, out:ptr, nh:i64, nkv:i64, hd:i64, t_len:i64, max_ctx:i64)
  b0:
    t255 = add t_len, 255:i64
    splits = udiv t255, 256:i64
    # per head and split: max, sum, then hd outputs (f32)
    hd2 = add hd, 2:i64
    per_head = mul splits, hd2
    pn = mul nh, per_head
    pbytes = mul pn, 4:i64
    part = alloc pbytes
    tasks = mul nkv, splits
    hdf = itof hd:f32
    sq = sqrt hdf
    scale = div 1.0:f32, sq
    par tasks, attend_split(q, kc, vc, part, nh, nkv, hd, t_len, max_ctx, splits, scale)
    par nh, merge_head(part, out, hd, splits)
    free part
    ret

# Positions 256 s .. of KV head g for its group's query heads (task = g * splits + s).
fn attend_split(task:i64, q:ptr, kc:ptr, vc:ptr, part:ptr, nh:i64, nkv:i64, hd:i64, t_len:i64, max_ctx:i64, splits:i64, scale:f32)
  b0:
    g = udiv task, splits
    s = urem task, splits
    t0 = mul s, 256:i64
    t_end0 = add t0, 256:i64
    t1 = min t_end0, t_len
    nt = sub t1, t0
    group = udiv nh, nkv
    h0 = mul g, group
    row2 = mul hd, 2:i64
    hd4 = mul hd, 4:i64
    # rows t0 .. of KV head g
    g_rows = mul g, max_ctx
    first = add g_rows, t0
    kv_off = mul first, row2
    kb = add kc, kv_off
    vb = add vc, kv_off
    q_off = mul h0, hd4
    qg = add q, q_off
    # part row of head h for split s: (h * splits + s) * (hd + 2) f32
    hd2 = add hd, 2:i64
    prow_b = mul hd2, 4:i64
    head_b = mul splits, prow_b
    g_part0 = mul h0, head_b
    s_part = mul s, prow_b
    g_part1 = add g_part0, s_part
    pg = add part, g_part1
    call attn_split(qg, kb, vb, pg, group, hd, nt, scale, head_b)
    ret

# Query head h: merges its splits' partial results into out[h].
fn merge_head(h:i64, part:ptr, out:ptr, hd:i64, splits:i64)
  b0:
    hd2 = add hd, 2:i64
    rowb = mul hd2, 4:i64
    hb0 = mul h, splits
    hb1 = mul hb0, rowb
    hp = add part, hb1
    hd4 = mul hd, 4:i64
    oo = mul h, hd4
    oh = add out, oo
    call attn_merge(hp, splits, rowb, hd, oh)
    ret
