# Numerically stable softmax over n f32 values:
#   out_i = exp(x_i - max(x)) / sum_j exp(x_j - max(x))
# Returns the sum of exponentials. The max and the normalization run at full vector width;
# exp is a scalar libm call per element. A masked load would pad the max with zeros, so
# the max uses full vectors plus a scalar tail instead.
extfn expf(x:f32)->f32

fn softmax(x:ptr, out:ptr, n:i64)->f32
  b0:
    first = ld x:f32
    w = vl f32
    vmax0 = splat first:vx
    jmp max_vec(0:i64, vmax0)
  max_vec(i:i64, vm:vx):
    end = add i, w
    full = le end, n
    br full, max_vec_body, max_reduce(i, vm)
  max_vec_body:
    off = mul i, 4:i64
    px = add x, off
    v = ld px:vx
    vm2 = vmax vm, v:f32
    jmp max_vec(end, vm2)
  max_reduce(t:i64, vfinal:vx):
    m0 = vmaxr vfinal:f32
    jmp max_tail(t, m0)
  max_tail(k:i64, m:f32):
    more_k = lt k, n
    br more_k, max_tail_body, exps(0:i64, 0.0:f32, m)
  max_tail_body:
    off_k = mul k, 4:i64
    pk = add x, off_k
    xk = ld pk:f32
    m2 = max m, xk
    k2 = add k, 1:i64
    jmp max_tail(k2, m2)
  exps(e:i64, total:f32, mx:f32):
    more_e = lt e, n
    br more_e, exps_body, norm_init(total)
  exps_body:
    off_e = mul e, 4:i64
    pe = add x, off_e
    xe = ld pe:f32
    shifted = sub xe, mx
    ev = call expf(shifted)
    po = add out, off_e
    st po, ev
    total2 = add total, ev
    e2 = add e, 1:i64
    jmp exps(e2, total2, mx)
  norm_init(s:f32):
    inv = div 1.0:f32, s
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, n
    br more_j, norm_body, done
  norm_body:
    rest = sub n, j
    off_j = mul j, 4:i64
    pj = add out, off_j
    ej = ldm pj:vx, rest:f32
    pj2 = vmul ej, vinv:f32
    stm pj, pj2, rest:f32
    j2 = add j, w
    jmp norm(j2)
  done:
    ret s
