# Numerically stable softmax over n f32 values:
#   out_i = exp(x_i - max(x)) / sum_j exp(x_j - max(x))
# Returns the sum of exponentials. Everything runs at full vector width, exp included
# (`vexp`, about 1 ulp; no libm call). A masked load would pad the max with zeros, so the
# max uses full vectors plus a scalar tail; the sum of the final partial vector is taken from
# the stored outputs, whose masked reload zeroes the padding.
fn softmax(x:ptr, out:ptr, n:i64)->f32
  b0:
    first = ld x:f32
    w = vl f32
    vmax0 = splat first:vx
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    jmp max_vec(0:i64, vmax0)
  max_vec(i:i64, vm:vx):
    end = add i, w
    full = le end, n
    br full, max_vec_body, max_reduce(i, vm)
  max_vec_body:
    off = mul i, 4:i64
    px = add x, off
    v = ld px:vx
    vm2 = vmax vm, v:f32
    jmp max_vec(end, vm2)
  max_reduce(t:i64, vfinal:vx):
    m0 = vmaxr vfinal:f32
    jmp max_tail(t, m0)
  max_tail(k:i64, m:f32):
    more_k = lt k, n
    br more_k, max_tail_body, exps_init(m)
  max_tail_body:
    off_k = mul k, 4:i64
    pk = add x, off_k
    xk = ld pk:f32
    m2 = max m, xk
    k2 = add k, 1:i64
    jmp max_tail(k2, m2)

  # out = exp(x - max), summed as it goes.
  exps_init(mx:f32):
    v_mx = splat mx:vx
    jmp exps(0:i64, v_zero)
  exps(e:i64, acc:vx):
    more_e = lt e, n
    br more_e, exps_body, norm_init(acc)
  exps_body:
    rest = sub n, e
    off_e = mul e, 4:i64
    pe = add x, off_e
    po = add out, off_e
    xv = ldm pe:vx, rest:f32
    x0 = vsub xv, v_mx:f32
    ev = vexp x0:f32
    stm po, ev, rest:f32
    # Re-read what was stored: lanes past n come back as zeros and add nothing.
    kept = ldm po:vx, rest:f32
    acc2 = vadd acc, kept:f32
    e2 = add e, w
    jmp exps(e2, acc2)

  norm_init(total:vx):
    s = vsum total:f32
    inv = div 1.0:f32, s
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, n
    br more_j, norm_body, done
  norm_body:
    rest_j = sub n, j
    off_j = mul j, 4:i64
    pj = add out, off_j
    ej = ldm pj:vx, rest_j:f32
    pj2 = vmul ej, vinv:f32
    stm pj, pj2, rest_j:f32
    j2 = add j, w
    jmp norm(j2)
  done:
    ret s
