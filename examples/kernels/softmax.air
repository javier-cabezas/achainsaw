# Numerically Stable Softmax Kernel
# Computes: y_i = exp(x_i - max(x)) / sum(exp(x_j - max(x)))
extfn expf(x:f32)->f32

fn softmax(p_in:ptr, p_out:ptr, n:i64)->f32
  b0:
    zero_i = cst 0:i64
    init_max = ld p_in:f32
    one_i = cst 1:i64
    jmp b_max_loop(one_i, init_max)
  b_max_loop(i:i64, cur_max:f32):
    cond_max = lt i, n
    br cond_max, b_max_body, b_max_done(cur_max)
  b_max_body:
    four = cst 4:i64
    byte_off = mul i, four
    curr_ptr = add p_in, byte_off
    val = ld curr_ptr:f32
    is_greater = gt val, cur_max
    one = cst 1:i64
    next_i = add i, one
    br is_greater, b_new_max(next_i, val), b_keep_max(next_i, cur_max)
  b_new_max(ni1:i64, m1:f32):
    jmp b_max_loop(ni1, m1)
  b_keep_max(ni2:i64, m2:f32):
    jmp b_max_loop(ni2, m2)
  b_max_done(max_val:f32):
    zero_f = cst 0.0:f32
    zero_idx = cst 0:i64
    jmp b_exp_loop(zero_idx, zero_f, max_val)
  b_exp_loop(j:i64, cur_sum:f32, m_val:f32):
    cond_exp = lt j, n
    br cond_exp, b_exp_body, b_exp_done(cur_sum)
  b_exp_body:
    four_b = cst 4:i64
    in_off = mul j, four_b
    in_p = add p_in, in_off
    x_val = ld in_p:f32
    shifted = sub x_val, m_val
    e_val = call expf(shifted)
    out_p = add p_out, in_off
    st out_p, e_val
    next_sum = add cur_sum, e_val
    one_b = cst 1:i64
    next_j = add j, one_b
    jmp b_exp_loop(next_j, next_sum, m_val)
  b_exp_done(total_sum:f32):
    zero_k = cst 0:i64
    jmp b_norm_loop(zero_k, total_sum)
  b_norm_loop(k:i64, t_sum:f32):
    cond_norm = lt k, n
    br cond_norm, b_norm_body, b_norm_done(t_sum)
  b_norm_body:
    four_c = cst 4:i64
    norm_off = mul k, four_c
    out_pk = add p_out, norm_off
    raw_e = ld out_pk:f32
    prob = div raw_e, t_sum
    st out_pk, prob
    one_c = cst 1:i64
    next_k = add k, one_c
    jmp b_norm_loop(next_k, t_sum)
  b_norm_done(res_sum:f32):
    ret res_sum
