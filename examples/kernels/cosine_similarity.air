# Cosine similarity of two f32 vectors of n elements:
#   dot(a, b) / (sqrt(dot(a, a)) * sqrt(dot(b, b)) + 1e-12)
# Vector-length agnostic: `vl` lanes per step at the backend's full width (`vx`), with a
# masked load for the final partial vector.
fn cosine_similarity(a:ptr, b:ptr, n:i64)->f32
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    w = vl f32
    jmp loop(0:i64, zero, zero, zero)
  loop(i:i64, dot:vx, na:vx, nb:vx):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    off = mul i, 4:i64
    pa = add a, off
    pb = add b, off
    va = ldm pa:vx, rest:f32
    vb = ldm pb:vx, rest:f32
    dot2 = vfma va, vb, dot:f32
    na2 = vfma va, va, na:f32
    nb2 = vfma vb, vb, nb:f32
    i2 = add i, w
    jmp loop(i2, dot2, na2, nb2)
  done:
    sd = vsum dot:f32
    sa = vsum na:f32
    sb = vsum nb:f32
    ra = sqrt sa
    rb = sqrt sb
    denom = mul ra, rb
    safe = add denom, 0.000000000001:f32
    sim = div sd, safe
    ret sim
