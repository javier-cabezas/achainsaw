# One Llama-style decode step in a single call: token in, next token (greedy) out.
#
# Megakernel-style fusion for CPUs: every elementwise op runs inside the pass that produces
# or consumes its data, so a layer is 2 serial norms and 5 `par` regions:
#   1. RMSNorm + Q8 quantization of the input                (serial, d values)
#   2. Q/K/V projections + RoPE + KV-cache append              (par, one task per head)
#   3. attention + Q8 quantization of its output               (par, one task per q head)
#   4. O projection + residual add                             (par, 64 rows per task)
#   5. RMSNorm + Q8 quantization                               (serial)
#   6. gate and up projections + SwiGLU + Q8 quantization      (par, 64 rows per task)
#   7. down projection + residual add                          (par, 64 rows per task)
# then the final RMSNorm and the LM head with a fused argmax: each task keeps only the best
# of its 64 logits, so the logits are never written.
#
# llama_prefill runs n prompt tokens through the same passes in one call: every projection
# task applies its weights to 4 tokens at a time (qmat_batch), so a weight matrix is read
# once per 4 tokens rather than once per token, and attention, norms and epilogues run per
# token. Its results are exactly those of n llama_decode calls.
#
# Each weight matrix is Q8_0, Q4_0 or Q6_K, chosen per matrix: 8-, 4- or 6-bit weights with
# f16 scales per 32 (Q6_K: 16) values of a row, packed in chunks of 64 output rows;
# activations are quantized to int8 per 32-block on the fly and the int8 dots run on `vdotu`
# (weights stored unsigned; the activation sums of quantize_q8 remove their offset).
# The matrix chunks (qmat_chunk), the quantization, RoPE, softmax's exp (vexp, no libm call)
# and SwiGLU's gating come from the AIR standard library (`use`).
#
# Shapes: d, ffn and vocab multiples of 64; head_dim a multiple of 64; heads a multiple of
# kv_heads (grouped-query attention); pos < max_ctx.
#
# cfg (i64[8]): d, layers, heads, kv_heads, head_dim, ffn, vocab, max_ctx
# model (table of 8-byte words): a matrix takes 3 words, its packed weights, its scales and
# its format (0: Q8_0, 1: Q4_0, 2: Q6_K), and functions receive a pointer to those words.
#   [0] token embedding f32 [vocab x d]   [1] final norm weight f32 [d]
#   [2..4] LM head [vocab x d]
#   [5] RoPE cos f32 [max_ctx x head_dim/2]   [6] RoPE sin (same shape)
#   then 14 per layer, at 7 + 14 * l:
#   attention norm f32 [d]; QKV [(heads + 2 kv_heads) * head_dim x d] (rows: all q heads,
#   then k heads, then v heads); O [d x heads * head_dim]; MLP norm f32 [d]; gate/up
#   [2 ffn x d], chunks interleaved (gate rows 64c.., then up rows 64c..); down [d x ffn]
# cache: per layer, K then V, each f32 [max_ctx x kv_heads x head_dim]
# h: f32 [d], the residual stream; holds the final hidden state on return.
use qmat_chunk, qmat_batch, quantize_q8, rope_half, exp_shift, silu_mul

fn llama_decode(model:ptr, cfg:ptr, cache:ptr, token:i64, pos:i64, h:ptr, eps:f32)->i64
  b0:
    d, nl, nh, nkv, hd, f, vocab, max_ctx = call load_cfg(cfg)
    embd, norm_out, lm, cos_t, sin_t = call model_globals(model)
    w = vl f32
    d4 = mul d, 4:i64
    # h = embedding row of the token.
    e_off = mul token, d4
    e_row = add embd, e_off
    jmp embed(0:i64)
  embed(ei:i64):
    e_more = lt ei, d
    br e_more, embed_body, setup
  embed_body:
    e_rest = sub d, ei
    ev = ldm e_row[ei]:vx, e_rest:f32
    stm h[ei], ev, e_rest:f32
    ei2 = add ei, w
    jmp embed(ei2)

  setup:
    qd = mul nh, hd
    kmax0 = max d, qd
    kmax = max kmax0, f
    xn = alloc d4
    qd4 = mul qd, 4:i64
    qbuf = alloc qd4
    xq = alloc kmax
    nbmax = udiv kmax, 32:i64
    nb16 = mul nbmax, 16:i64
    dx = alloc nb16
    aq = alloc f
    nbf = udiv f, 32:i64
    nbf16 = mul nbf, 16:i64
    adx = alloc nbf16
    half = udiv hd, 2:i64
    rope_row = mul half, 4:i64
    rope_off = mul pos, rope_row
    cos_r = add cos_t, rope_off
    sin_r = add sin_t, rope_off
    kv_row = mul nkv, hd
    kv_plane0 = mul max_ctx, kv_row
    kv_plane = mul kv_plane0, 4:i64
    kv_layer = mul kv_plane, 2:i64
    heads_all0 = mul nkv, 2:i64
    heads_all = add nh, heads_all0
    dchunks = udiv d, 64:i64
    fchunks = udiv f, 64:i64
    jmp layers(0:i64)

  layers(l:i64):
    l_more = lt l, nl
    br l_more, layer_body, final
  layer_body:
    attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn = call layer_weights(model, l)
    kc_off = mul l, kv_layer
    kc = add cache, kc_off
    vc = add kc, kv_plane
    call norm_quant(h, attn_norm, xn, xq, dx, d, eps)
    par heads_all, qkv_head(m_qkv, xq, dx, qbuf, kc, vc, d, nh, nkv, hd, pos, cos_r, sin_r)
    par nh, attn_head(qbuf, kc, vc, xq, dx, nh, nkv, hd, pos)
    par dchunks, proj_add(m_o, xq, dx, h, qd)
    call norm_quant(h, ffn_norm, xn, xq, dx, d, eps)
    par fchunks, gate_up(m_gu, xq, dx, aq, adx, d)
    par dchunks, proj_add(m_dn, aq, adx, h, f)
    l2 = add l, 1:i64
    jmp layers(l2)

  final:
    call norm_quant(h, norm_out, xn, xq, dx, d, eps)
    next = call lm_argmax(lm, xq, dx, d, vocab)
    free adx
    free aq
    free dx
    free xq
    free qbuf
    free xn
    ret next

# Greedy next token: the LM head on the quantized final hidden state (xq, dx) with a fused
# argmax (lm_chunk); the first index wins ties.
fn lm_argmax(lm:ptr, xq:ptr, dx:ptr, d:i64, vocab:i64)->i64
  b0:
    vchunks = udiv vocab, 64:i64
    vb4 = mul vchunks, 4:i64
    best = alloc vb4
    vb8 = mul vchunks, 8:i64
    best_idx = alloc vb8
    par vchunks, lm_chunk(lm, xq, dx, best, best_idx, d)
    b_first = ld best:f32
    i_first = ld best_idx:i64
    jmp pick(1:i64, b_first, i_first)
  pick(pc:i64, pv:f32, pi:i64):
    pc_more = lt pc, vchunks
    br pc_more, pick_body, done
  pick_body:
    cv = ld best[pc]:f32
    ci = ld best_idx[pc]:i64
    better = gt cv, pv
    pv2 = select better, cv, pv
    pi2 = select better, ci, pi
    pc2 = add pc, 1:i64
    jmp pick(pc2, pv2, pi2)
  done:
    free best_idx
    free best
    ret pi

# xn = RMSNorm(h) * w, then xq/dx = Q8 quantization of xn.
fn norm_quant(h:ptr, wt:ptr, xn:ptr, xq:ptr, dx:ptr, d:i64, eps:f32)
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    w = vl f32
    jmp sum(0:i64, zero)
  sum(i:i64, acc:vx):
    more = lt i, d
    br more, sum_body, scale
  sum_body:
    rest = sub d, i
    hv = ldm h[i]:vx, rest:f32
    acc2 = vfma hv, hv, acc:f32
    i2 = add i, w
    jmp sum(i2, acc2)
  scale:
    ss = vsum acc:f32
    nf = itof d:f32
    mean = div ss, nf
    mean_eps = add mean, eps
    rms = sqrt mean_eps
    inv = div 1.0:f32, rms
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, d
    br more_j, norm_body, quant
  norm_body:
    rest_j = sub d, j
    hv_j = ldm h[j]:vx, rest_j:f32
    wv = ldm wt[j]:vx, rest_j:f32
    hs = vmul hv_j, vinv:f32
    y = vmul hs, wv:f32
    stm xn[j], y, rest_j:f32
    j2 = add j, w
    jmp norm(j2)
  quant:
    call quantize_q8(xn, xq, dx, d)
    ret

# Q, K or V head t: 64-row chunks of the QKV projection written straight to their
# destination (the q buffer, or this position's KV-cache slot), then RoPE for q and k.
fn qkv_head(t:i64, mat:ptr, xq:ptr, dx:ptr, qbuf:ptr, kc:ptr, vc:ptr, d:i64, nh:i64, nkv:i64, hd:i64, pos:i64, cos_r:ptr, sin_r:ptr)
  b0:
    hd4 = mul hd, 4:i64
    is_q = lt t, nh
    nhk = add nh, nkv
    is_k = lt t, nhk
    q_off = mul t, hd4
    q_dst = add qbuf, q_off
    slot0 = mul pos, nkv
    tk = sub t, nh
    k_slot = add slot0, tk
    k_off = mul k_slot, hd4
    k_dst = add kc, k_off
    tv = sub t, nhk
    v_slot = add slot0, tv
    v_off = mul v_slot, hd4
    v_dst = add vc, v_off
    kv_dst = select is_k, k_dst, v_dst
    dst = select is_q, q_dst, kv_dst
    per_head = udiv hd, 64:i64
    c0 = mul t, per_head
    jmp chunks(0:i64)
  chunks(i:i64):
    i_more = lt i, per_head
    br i_more, chunk_body, epilogue
  chunk_body:
    c = add c0, i
    o = mul i, 256:i64
    out = add dst, o
    call qmat_chunk(c, mat, xq, dx, out, d)
    i2 = add i, 1:i64
    jmp chunks(i2)
  epilogue:
    br is_k, rotate, done
  rotate:
    call rope_half(dst, hd, cos_r, sin_r)
    jmp done
  done:
    ret

# Attention of q head hq over positions 0..pos of its KV head, written back Q8-quantized
# (into xq/dx at the head's offset) for the O projection.
fn attn_head(hq:i64, qbuf:ptr, kc:ptr, vc:ptr, xq:ptr, dx:ptr, nh:i64, nkv:i64, hd:i64, pos:i64)
  b0:
    w = vl f32
    group = udiv nh, nkv
    kvh = udiv hq, group
    hd4 = mul hd, 4:i64
    q_off = mul hq, hd4
    q = add qbuf, q_off
    npos = add pos, 1:i64
    np4 = mul npos, 4:i64
    scores = alloc np4
    out = alloc hd4
    row = mul nkv, hd4
    head_off = mul kvh, hd4
    kbase = add kc, head_off
    vbase = add vc, head_off
    hdf = itof hd:f32
    sq = sqrt hdf
    scale = div 1.0:f32, sq
    zf = cst 0.0:f32
    zero = splat zf:vx
    neg_big = cst -1000000000000000000000000000000.0:f32
    jmp score(0:i64, neg_big)
  score(t:i64, mx:f32):
    t_more = lt t, npos
    br t_more, score_start, softmax(mx)
  score_start:
    kt_off = mul t, row
    kt = add kbase, kt_off
    jmp dot(0:i64, zero)
  dot(j:i64, acc:vx):
    j_more = lt j, hd
    br j_more, dot_body, dot_done
  dot_body:
    rest = sub hd, j
    qv = ldm q[j]:vx, rest:f32
    kv = ldm kt[j]:vx, rest:f32
    acc2 = vfma qv, kv, acc:f32
    j2 = add j, w
    jmp dot(j2, acc2)
  dot_done:
    s0 = vsum acc:f32
    s = mul s0, scale
    st scores[t], s
    mx2 = max mx, s
    t2 = add t, 1:i64
    jmp score(t2, mx2)
  softmax(m:f32):
    total = call exp_shift(scores, npos, m)
    inv = div 1.0:f32, total
    jmp zero_out(0:i64)
  zero_out(z:i64):
    z_more = lt z, hd
    br z_more, zero_out_body, mix(0:i64)
  zero_out_body:
    z_rest = sub hd, z
    stm out[z], zero, z_rest:f32
    z2 = add z, w
    jmp zero_out(z2)
  # out = sum_t p_t * V_t / total
  mix(u:i64):
    u_more = lt u, npos
    br u_more, mix_start, quant
  mix_start:
    pr = ld scores[u]:f32
    p = mul pr, inv
    vp = splat p:vx
    vt_off = mul u, row
    vt = add vbase, vt_off
    jmp mix_cols(0:i64)
  mix_cols(c:i64):
    c_more = lt c, hd
    br c_more, mix_body, mix_next
  mix_body:
    c_rest = sub hd, c
    vv = ldm vt[c]:vx, c_rest:f32
    ov = ldm out[c]:vx, c_rest:f32
    ov2 = vfma vp, vv, ov:f32
    stm out[c], ov2, c_rest:f32
    c2 = add c, w
    jmp mix_cols(c2)
  mix_next:
    u2 = add u, 1:i64
    jmp mix(u2)
  quant:
    xq_off = mul hq, hd
    xq_h = add xq, xq_off
    blocks = udiv hd, 32:i64
    dx_off0 = mul hq, blocks
    dx_off = mul dx_off0, 16:i64
    dx_h = add dx, dx_off
    call quantize_q8(out, xq_h, dx_h, hd)
    free out
    free scores
    ret

# h[64c .. 64c + 64] += (W x)[64c .. 64c + 64]: a projection fused with the residual add.
fn proj_add(c:i64, mat:ptr, xq:ptr, dx:ptr, h:ptr, k:i64)
  b0:
    w = vl f32
    tmp = alloc 256:i64
    call qmat_chunk(c, mat, xq, dx, tmp, k)
    h_off = mul c, 256:i64
    hc = add h, h_off
    jmp add_loop(0:i64)
  add_loop(j:i64):
    more = lt j, 64:i64
    br more, add_body, done
  add_body:
    rest = sub 64:i64, j
    tv = ldm tmp[j]:vx, rest:f32
    hv = ldm hc[j]:vx, rest:f32
    s = vadd hv, tv:f32
    stm hc[j], s, rest:f32
    j2 = add j, w
    jmp add_loop(j2)
  done:
    free tmp
    ret

# MLP rows 64c..64c+63: gate and up chunks, SwiGLU, then Q8 quantization for the down
# projection (two 32-blocks per task).
fn gate_up(c:i64, mat:ptr, xq:ptr, dx:ptr, aq:ptr, adx:ptr, k:i64)
  b0:
    g = alloc 256:i64
    u = alloc 256:i64
    a = alloc 256:i64
    cg = mul c, 2:i64
    cu = add cg, 1:i64
    call qmat_chunk(cg, mat, xq, dx, g, k)
    call qmat_chunk(cu, mat, xq, dx, u, k)
    call silu_mul(g, u, a, 64:i64)
    q_off = mul c, 64:i64
    aq_c = add aq, q_off
    d_off = mul c, 32:i64
    adx_c = add adx, d_off
    call quantize_q8(a, aq_c, adx_c, 64:i64)
    free a
    free u
    free g
    ret

# LM head rows 64c..64c+63, keeping only the best logit (first on ties) and its token.
fn lm_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, best:ptr, best_idx:ptr, k:i64)
  b0:
    tmp = alloc 256:i64
    call qmat_chunk(c, mat, xq, dx, tmp, k)
    first = ld tmp:f32
    jmp scan(1:i64, first, 0:i64)
  scan(j:i64, bv:f32, bj:i64):
    more = lt j, 64:i64
    br more, scan_body, done
  scan_body:
    v = ld tmp[j]:f32
    better = gt v, bv
    bv2 = select better, v, bv
    bj2 = select better, j, bj
    j2 = add j, 1:i64
    jmp scan(j2, bv2, bj2)
  done:
    st best[c], bv
    base = mul c, 64:i64
    tok = add base, bj
    st best_idx[c], tok
    free tmp
    ret

# Prefill: n prompt tokens (i64 [n] at `tokens`) at positions pos .. pos + n - 1, with the
# model, cache and h of llama_decode (pos + n <= max_ctx). Returns the greedy token after
# the last one; h holds the last token's final hidden state. Per layer: 2 norm passes over
# the tokens, then the same 5 `par` regions as llama_decode, each task computing its rows
# for every token (4 tokens per weight load); attention runs per token over the cache up to
# its own position, so tokens never see later ones.
fn llama_prefill(model:ptr, cfg:ptr, cache:ptr, tokens:ptr, n:i64, pos:i64, h:ptr, eps:f32)->i64
  b0:
    d, nl, nh, nkv, hd, f, vocab, max_ctx = call load_cfg(cfg)
    embd, norm_out, lm, cos_t, sin_t = call model_globals(model)
    w = vl f32
    d4 = mul d, 4:i64
    # hs: the residual streams of the n tokens, f32 [n x d].
    hs_sz = mul n, d4
    hs = alloc hs_sz
    jmp embed_tok(0:i64)
  embed_tok(s:i64):
    s_more = lt s, n
    br s_more, embed_start, setup
  embed_start:
    tok = ld tokens[s]:i64
    e_off = mul tok, d4
    e_row = add embd, e_off
    h_off = mul s, d4
    h_row = add hs, h_off
    jmp embed(0:i64)
  embed(ei:i64):
    e_more = lt ei, d
    br e_more, embed_body, embed_next
  embed_body:
    e_rest = sub d, ei
    ev = ldm e_row[ei]:vx, e_rest:f32
    stm h_row[ei], ev, e_rest:f32
    ei2 = add ei, w
    jmp embed(ei2)
  embed_next:
    s2 = add s, 1:i64
    jmp embed_tok(s2)

  setup:
    qd = mul nh, hd
    kmax0 = max d, qd
    # xs: bytes per token in the int8 activation buffers (any projection's input fits).
    xs = max kmax0, f
    xn = alloc hs_sz
    qd4 = mul qd, 4:i64
    qb_sz = mul n, qd4
    qbuf = alloc qb_sz
    xq_sz = mul n, xs
    xq = alloc xq_sz
    aq = alloc xq_sz
    dx_sz = udiv xq_sz, 2:i64
    dx = alloc dx_sz
    adx = alloc dx_sz
    kv_row = mul nkv, hd
    kv_plane0 = mul max_ctx, kv_row
    kv_plane = mul kv_plane0, 4:i64
    kv_layer = mul kv_plane, 2:i64
    heads_all0 = mul nkv, 2:i64
    heads_all = add nh, heads_all0
    dchunks = udiv d, 64:i64
    fchunks = udiv f, 64:i64
    jmp layers(0:i64)

  layers(l:i64):
    l_more = lt l, nl
    br l_more, layer_body, final
  layer_body:
    attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn = call layer_weights(model, l)
    kc_off = mul l, kv_layer
    kc = add cache, kc_off
    vc = add kc, kv_plane
    par n, norm_tok(hs, attn_norm, xn, xq, dx, d, eps, xs)
    par heads_all, qkv_head_n(m_qkv, xq, dx, qbuf, kc, vc, d, nh, nkv, hd, pos, cos_t, sin_t, n, xs)
    par nh, attn_head_n(qbuf, kc, vc, xq, dx, nh, nkv, hd, pos, n, xs)
    par dchunks, proj_add_n(m_o, xq, dx, hs, qd, n, xs, d)
    par n, norm_tok(hs, ffn_norm, xn, xq, dx, d, eps, xs)
    par fchunks, gate_up_n(m_gu, xq, dx, aq, adx, d, n, xs)
    par dchunks, proj_add_n(m_dn, aq, adx, hs, f, n, xs, d)
    l2 = add l, 1:i64
    jmp layers(l2)

  final:
    last = sub n, 1:i64
    last_off = mul last, d4
    h_last = add hs, last_off
    jmp copy(0:i64)
  copy(ci:i64):
    c_more = lt ci, d
    br c_more, copy_body, head
  copy_body:
    c_rest = sub d, ci
    cv = ldm h_last[ci]:vx, c_rest:f32
    stm h[ci], cv, c_rest:f32
    ci2 = add ci, w
    jmp copy(ci2)
  head:
    call norm_quant(h, norm_out, xn, xq, dx, d, eps)
    next = call lm_argmax(lm, xq, dx, d, vocab)
    free adx
    free dx
    free aq
    free xq
    free qbuf
    free xn
    free hs
    ret next

# norm_quant for token s of a prefill: its residual stream row of hs, its xn row, and its
# int8 activations xs bytes apart (block records xs / 2 apart).
fn norm_tok(s:i64, hs:ptr, wt:ptr, xn:ptr, xq:ptr, dx:ptr, d:i64, eps:f32, xs:i64)
  b0:
    d4 = mul d, 4:i64
    r_off = mul s, d4
    h_s = add hs, r_off
    xn_s = add xn, r_off
    q_off = mul s, xs
    xq_s = add xq, q_off
    ds = udiv xs, 2:i64
    d_off = mul s, ds
    dx_s = add dx, d_off
    call norm_quant(h_s, wt, xn_s, xq_s, dx_s, d, eps)
    ret

# qkv_head for n tokens: head t's 64-row chunks for every token (qmat_batch), each token's
# rows written to its q row or its position's KV-cache slot, then RoPE at its position.
fn qkv_head_n(t:i64, mat:ptr, xq:ptr, dx:ptr, qbuf:ptr, kc:ptr, vc:ptr, d:i64, nh:i64, nkv:i64, hd:i64, pos:i64, cos_t:ptr, sin_t:ptr, n:i64, xs:i64)
  b0:
    w = vl f32
    hd4 = mul hd, 4:i64
    qd4 = mul nh, hd4
    is_q = lt t, nh
    nhk = add nh, nkv
    is_k = lt t, nhk
    q_off = mul t, hd4
    tk = sub t, nh
    tv = sub t, nhk
    kv_head = select is_k, tk, tv
    kv_off = mul kv_head, hd4
    row = mul nkv, hd4
    kv_base0 = select is_k, kc, vc
    kv_base = add kv_base0, kv_off
    half = udiv hd, 2:i64
    rope_row = mul half, 4:i64
    per_head = udiv hd, 64:i64
    c0 = mul t, per_head
    tmp_sz = mul n, 256:i64
    tmp = alloc tmp_sz
    jmp chunks(0:i64)
  chunks(i:i64):
    i_more = lt i, per_head
    br i_more, chunk_body, rope(0:i64)
  chunk_body:
    c = add c0, i
    call qmat_batch(c, mat, xq, dx, tmp, d, n, xs)
    o = mul i, 256:i64
    jmp scatter(0:i64)
  scatter(s:i64):
    s_more = lt s, n
    br s_more, scatter_start, chunk_next
  scatter_start:
    sq = mul s, qd4
    q_dst0 = add qbuf, sq
    q_dst = add q_dst0, q_off
    p = add pos, s
    kv_slot = mul p, row
    kv_dst = add kv_base, kv_slot
    dst0 = select is_q, q_dst, kv_dst
    dst = add dst0, o
    st_off = mul s, 256:i64
    src = add tmp, st_off
    jmp copy(0:i64)
  copy(j:i64):
    j_more = lt j, 64:i64
    br j_more, copy_body, scatter_next
  copy_body:
    j_rest = sub 64:i64, j
    v = ldm src[j]:vx, j_rest:f32
    stm dst[j], v, j_rest:f32
    j2 = add j, w
    jmp copy(j2)
  scatter_next:
    s2 = add s, 1:i64
    jmp scatter(s2)
  chunk_next:
    i2 = add i, 1:i64
    jmp chunks(i2)
  rope(r:i64):
    r_more = lt r, n
    br r_more, rope_body, done
  rope_body:
    br is_k, rotate, done
  rotate:
    rq0 = mul r, qd4
    rq1 = add qbuf, rq0
    rq = add rq1, q_off
    rp = add pos, r
    rkv0 = mul rp, row
    rkv = add kv_base, rkv0
    x = select is_q, rq, rkv
    rr = mul rp, rope_row
    cos_r = add cos_t, rr
    sin_r = add sin_t, rr
    call rope_half(x, hd, cos_r, sin_r)
    r2 = add r, 1:i64
    jmp rope(r2)
  done:
    free tmp
    ret

# attn_head for n tokens: q head hq of token s attends over positions 0 .. pos + s and
# writes its Q8 output into token s's activations.
fn attn_head_n(hq:i64, qbuf:ptr, kc:ptr, vc:ptr, xq:ptr, dx:ptr, nh:i64, nkv:i64, hd:i64, pos:i64, n:i64, xs:i64)
  b0:
    qd = mul nh, hd
    qd4 = mul qd, 4:i64
    ds = udiv xs, 2:i64
    jmp toks(0:i64)
  toks(s:i64):
    s_more = lt s, n
    br s_more, tok_body, done
  tok_body:
    q_off = mul s, qd4
    q_s = add qbuf, q_off
    x_off = mul s, xs
    xq_s = add xq, x_off
    d_off = mul s, ds
    dx_s = add dx, d_off
    p = add pos, s
    call attn_head(hq, q_s, kc, vc, xq_s, dx_s, nh, nkv, hd, p)
    s2 = add s, 1:i64
    jmp toks(s2)
  done:
    ret

# proj_add for n tokens: rows 64c..64c+63 of every token's residual stream += (W x).
fn proj_add_n(c:i64, mat:ptr, xq:ptr, dx:ptr, hs:ptr, k:i64, n:i64, xs:i64, d:i64)
  b0:
    w = vl f32
    tmp_sz = mul n, 256:i64
    tmp = alloc tmp_sz
    call qmat_batch(c, mat, xq, dx, tmp, k, n, xs)
    d4 = mul d, 4:i64
    c_off = mul c, 256:i64
    jmp toks(0:i64)
  toks(s:i64):
    s_more = lt s, n
    br s_more, tok_start, done
  tok_start:
    r_off = mul s, d4
    row = add hs, r_off
    hc = add row, c_off
    t_off = mul s, 256:i64
    ts = add tmp, t_off
    jmp add_loop(0:i64)
  add_loop(j:i64):
    more = lt j, 64:i64
    br more, add_body, tok_next
  add_body:
    rest = sub 64:i64, j
    tv = ldm ts[j]:vx, rest:f32
    hv = ldm hc[j]:vx, rest:f32
    sum = vadd hv, tv:f32
    stm hc[j], sum, rest:f32
    j2 = add j, w
    jmp add_loop(j2)
  tok_next:
    s2 = add s, 1:i64
    jmp toks(s2)
  done:
    free tmp
    ret

# gate_up for n tokens: MLP rows 64c..64c+63 of every token, SwiGLU, then Q8 quantization
# into the token's down-projection input.
fn gate_up_n(c:i64, mat:ptr, xq:ptr, dx:ptr, aq:ptr, adx:ptr, k:i64, n:i64, xs:i64)
  b0:
    tmp_sz = mul n, 256:i64
    g = alloc tmp_sz
    u = alloc tmp_sz
    a = alloc 256:i64
    cg = mul c, 2:i64
    cu = add cg, 1:i64
    call qmat_batch(cg, mat, xq, dx, g, k, n, xs)
    call qmat_batch(cu, mat, xq, dx, u, k, n, xs)
    ds = udiv xs, 2:i64
    q_off = mul c, 64:i64
    d_off = mul c, 32:i64
    jmp toks(0:i64)
  toks(s:i64):
    s_more = lt s, n
    br s_more, tok_body, done
  tok_body:
    t_off = mul s, 256:i64
    gs = add g, t_off
    us = add u, t_off
    call silu_mul(gs, us, a, 64:i64)
    x_off = mul s, xs
    aq_s = add aq, x_off
    aq_c = add aq_s, q_off
    dd_off = mul s, ds
    adx_s = add adx, dd_off
    adx_c = add adx_s, d_off
    call quantize_q8(a, aq_c, adx_c, 64:i64)
    s2 = add s, 1:i64
    jmp toks(s2)
  done:
    free a
    free u
    free g
    ret

# The 8 words of cfg: d, layers, heads, kv_heads, head_dim, ffn, vocab, max_ctx.
inline fn load_cfg(cfg:ptr)->(i64, i64, i64, i64, i64, i64, i64, i64)
  b0:
    d = ld cfg[0]:i64
    nl = ld cfg[1]:i64
    nh = ld cfg[2]:i64
    nkv = ld cfg[3]:i64
    hd = ld cfg[4]:i64
    f = ld cfg[5]:i64
    vocab = ld cfg[6]:i64
    max_ctx = ld cfg[7]:i64
    ret d, nl, nh, nkv, hd, f, vocab, max_ctx

# The model table's global entries: embedding, final norm, the LM head's 3 words, RoPE
# cos and sin tables.
inline fn model_globals(model:ptr)->(ptr, ptr, ptr, ptr, ptr)
  b0:
    embd = ld model[0]:ptr
    norm_out = ld model[1]:ptr
    lm = add model, 16:i64
    cos_t = ld model[5]:ptr
    sin_t = ld model[6]:ptr
    ret embd, norm_out, lm, cos_t, sin_t

# Layer l's entries (14 words at 7 + 14 l): its two norm weights, and pointers to the
# 3-word entries of its QKV, O, gate/up and down matrices.
inline fn layer_weights(model:ptr, l:i64)->(ptr, ptr, ptr, ptr, ptr, ptr)
  b0:
    slot0 = mul l, 14:i64
    slot = add slot0, 7:i64
    lp_off = shl slot, 3:i64
    lp = add model, lp_off
    attn_norm = ld lp[0]:ptr
    m_qkv = add lp, 8:i64
    m_o = add lp, 32:i64
    ffn_norm = ld lp[7]:ptr
    m_gu = add lp, 64:i64
    m_dn = add lp, 88:i64
    ret attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn
