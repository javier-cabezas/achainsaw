# One Llama-style decode step in a single call: token in, next token (greedy) out.
#
# Megakernel-style fusion for CPUs: every elementwise op runs inside the pass that produces
# or consumes its data, so a layer is 2 serial norms and 5 `par` regions:
#   1. RMSNorm + Q8 quantization of the input                (serial, d values)
#   2. Q/K/V projections + RoPE + KV-cache append              (par, one task per head)
#   3. attention: splits of 256 positions                     (par, per KV head and split)
#      merged per query head + Q8 quantization of its output     (par, one task per q head)
#   4. O projection + residual add                             (par, 64 rows per task)
#   5. RMSNorm + Q8 quantization                               (serial)
#   6. gate and up projections + SwiGLU + Q8 quantization      (par, 64 rows per task)
#   7. down projection + residual add                          (par, 64 rows per task)
# then the final RMSNorm and the LM head with a fused argmax: each task keeps only the best
# of its 64 logits, so the logits are never written.
#
# llama_prefill runs n prompt tokens through the same passes in one call: every projection
# task applies its weights to 8 tokens at a time (qmat_batch; 4 with 128-bit vectors), so a
# weight matrix is read once per 8 tokens rather than once per token; attention runs per
# token in tiles of 8, the splits all 8 see whole once for the tile's query heads; norms and
# epilogues run per token. Its results are exactly those of n llama_decode calls.
#
# Each weight matrix is Q8_0, Q4_0, Q6_K, Q4_K, Q5_K or Q4_1, chosen per matrix (and per part
# of a fused matrix: Q, K and V may differ): 8-, 4-, 6- or 5-bit weights with f16 scales per
# 32 (Q6_K: 16) values of a row (Q4_1 an f16 min too), or for Q4_K and Q5_K a 6-bit scale
# and min per 32 under f16 factors per 256, packed in chunks of 64 output rows; activations are quantized to int8 per 32-block on the fly and the int8 dots
# run on `vdotu` (weights stored unsigned; the activation sums of quantize_q8 remove their
# offset or apply the mins).
# The matrix chunks (qmat_chunk), the quantization, RoPE, softmax's exp (vexp, no libm call)
# and SwiGLU's gating come from the AIR standard library (`use`).
#
# Shapes: d, ffn and vocab multiples of 64; head_dim a multiple of 64; heads a multiple of
# kv_heads (grouped-query attention); pos < max_ctx.
#
# cfg (i64[9]): d, layers, heads, kv_heads, head_dim, ffn, vocab, max_ctx, KV cache format
# (0 bf16, 1 int8)
# model (table of 8-byte words): a matrix is a pointer to its parts, 4 words each: packed
# weights, scales, format (0: Q8_0, 1: Q4_0, 2: Q6_K, 3: Q4_K, 4: Q5_K, 5: Q4_1) and number of
# 64-row chunks (see qmat_chunk in the standard library).
#   [0] token embedding f32 [vocab x d]   [1] final norm weight f32 [d]   [2] LM head
#   [vocab x d]   [3] RoPE cos f32 [max_ctx x head_dim/2]   [4] RoPE sin (same shape)
#   then 6 per layer, at 5 + 6 * l:
#   attention norm f32 [d]; QKV [(heads + 2 kv_heads) * head_dim x d] (rows: all q heads,
#   then k heads, then v heads); O [d x heads * head_dim]; MLP norm f32 [d]; gate/up
#   [2 ffn x d], chunks interleaved (gate rows 64c.., then up rows 64c..); down [d x ffn]
# cache: per layer, K then V, each kv_heads x ctx x head_dim bf16 values, ctx = max_ctx
# rounded up to a multiple of 32 (head-major, so a KV head's positions are contiguous): V is
# [kv_heads x ctx x head_dim]; K is in tiles of 32 positions, [kv_heads x ctx / 32 x
# head_dim x 32], so a vector holds one value of consecutive positions. Attention runs on
# the standard library's attn_split and attn_merge (flash-decoding): each 256-position split
# of a KV head is scored with positions in lanes (no horizontal sums) and mixed with V's
# columns in lanes, for the group's query heads 4 at a time, each K and V vector widened
# from bf16 once for the 4. An int8 cache (format 1) takes hd + 4 bytes per position
# instead of 2 hd: per KV head, tiles of 32 positions, each the int8 values (K's plus 128 in
# groups of 4 per position, [head_dim / 4 x 32 x 4]; V [32 x head_dim]) then an f32 scale per
# position (to_q8_kv); attn_split_q8 scores it with int8 dots (`vdotu`) on queries rounded
# to int8.
# h: f32 [d], the residual stream; holds the final hidden state on return.
use qmat_chunk, qmat_batch, quantize_q8, rope_half, silu_mul, attn_split, attn_split_q8, attn_merge

fn llama_decode(model:ptr, cfg:ptr, cache:ptr, token:i64, pos:i64, h:ptr, eps:f32)->i64
  b0:
    d, nl, nh, nkv, hd, f, vocab, max_ctx, kvf = call load_cfg(cfg)
    embd, norm_out, lm, cos_t, sin_t = call model_globals(model)
    w = vl f32
    d4 = mul d, 4:i64
    # h = embedding row of the token.
    e_off = mul token, d4
    e_row = add embd, e_off
    jmp embed(0:i64)
  embed(ei:i64):
    e_more = lt ei, d
    br e_more, embed_body, setup
  embed_body:
    e_rest = sub d, ei
    ev = ldm e_row[ei]:vx, e_rest:f32
    stm h[ei], ev, e_rest:f32
    ei2 = add ei, w
    jmp embed(ei2)

  setup:
    qd = mul nh, hd
    kmax0 = max d, qd
    kmax = max kmax0, f
    xn = alloc d4
    qd4 = mul qd, 4:i64
    qbuf = alloc qd4
    xq = alloc kmax
    nbmax = udiv kmax, 32:i64
    nb16 = mul nbmax, 16:i64
    dx = alloc nb16
    aq = alloc f
    nbf = udiv f, 32:i64
    nbf16 = mul nbf, 16:i64
    adx = alloc nbf16
    half = udiv hd, 2:i64
    rope_row = mul half, 4:i64
    rope_off = mul pos, rope_row
    cos_r = add cos_t, rope_off
    sin_r = add sin_t, rope_off
    rb = call kv_rb(hd, kvf)
    kv_row = mul nkv, rb
    kv_plane = mul max_ctx, kv_row
    kv_layer = mul kv_plane, 2:i64
    heads_all0 = mul nkv, 2:i64
    heads_all = add nh, heads_all0
    dchunks = udiv d, 64:i64
    fchunks = udiv f, 64:i64
    # attention: splits of 256 positions, a record per query head and split (attn_split)
    npos = add pos, 1:i64
    npos255 = add npos, 255:i64
    splits = udiv npos255, 256:i64
    a_tasks = mul nkv, splits
    hd2 = add hd, 2:i64
    rec = mul hd2, 4:i64
    part0 = mul nh, splits
    part_sz = mul part0, rec
    part = alloc part_sz
    scale = call attn_scale(hd)
    jmp layers(0:i64)

  layers(l:i64):
    l_more = lt l, nl
    br l_more, layer_body, final
  layer_body:
    attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn = call layer_weights(model, l)
    kc_off = mul l, kv_layer
    kc = add cache, kc_off
    vc = add kc, kv_plane
    call norm_quant(h, attn_norm, xn, xq, dx, d, eps)
    par heads_all, qkv_head(m_qkv, xq, dx, qbuf, kc, vc, d, nh, nkv, hd, pos, max_ctx, kvf, cos_r, sin_r)
    par a_tasks, attn_task(qbuf, kc, vc, part, nh, nkv, hd, npos, max_ctx, kvf, splits, scale)
    par nh, attn_out(part, xq, dx, hd, splits)
    par dchunks, proj_add(m_o, xq, dx, h, qd)
    call norm_quant(h, ffn_norm, xn, xq, dx, d, eps)
    par fchunks, gate_up(m_gu, xq, dx, aq, adx, d)
    par dchunks, proj_add(m_dn, aq, adx, h, f)
    l2 = add l, 1:i64
    jmp layers(l2)

  final:
    call norm_quant(h, norm_out, xn, xq, dx, d, eps)
    next = call lm_argmax(lm, xq, dx, d, vocab)
    free part
    free adx
    free aq
    free dx
    free xq
    free qbuf
    free xn
    ret next

# Greedy next token: the LM head on the quantized final hidden state (xq, dx) with a fused
# argmax (lm_chunk); the first index wins ties.
fn lm_argmax(lm:ptr, xq:ptr, dx:ptr, d:i64, vocab:i64)->i64
  b0:
    vchunks = udiv vocab, 64:i64
    vb4 = mul vchunks, 4:i64
    best = alloc vb4
    vb8 = mul vchunks, 8:i64
    best_idx = alloc vb8
    par vchunks, lm_chunk(lm, xq, dx, best, best_idx, d)
    b_first = ld best:f32
    i_first = ld best_idx:i64
    jmp pick(1:i64, b_first, i_first)
  pick(pc:i64, pv:f32, pi:i64):
    pc_more = lt pc, vchunks
    br pc_more, pick_body, done
  pick_body:
    cv = ld best[pc]:f32
    ci = ld best_idx[pc]:i64
    better = gt cv, pv
    pv2 = select better, cv, pv
    pi2 = select better, ci, pi
    pc2 = add pc, 1:i64
    jmp pick(pc2, pv2, pi2)
  done:
    free best_idx
    free best
    ret pi

# xn = RMSNorm(h) * w, then xq/dx = Q8 quantization of xn.
fn norm_quant(h:ptr, wt:ptr, xn:ptr, xq:ptr, dx:ptr, d:i64, eps:f32)
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    w = vl f32
    jmp sum(0:i64, zero)
  sum(i:i64, acc:vx):
    more = lt i, d
    br more, sum_body, scale
  sum_body:
    rest = sub d, i
    hv = ldm h[i]:vx, rest:f32
    acc2 = vfma hv, hv, acc:f32
    i2 = add i, w
    jmp sum(i2, acc2)
  scale:
    ss = vsum acc:f32
    nf = itof d:f32
    mean = div ss, nf
    mean_eps = add mean, eps
    rms = sqrt mean_eps
    inv = div 1.0:f32, rms
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, d
    br more_j, norm_body, quant
  norm_body:
    rest_j = sub d, j
    hv_j = ldm h[j]:vx, rest_j:f32
    wv = ldm wt[j]:vx, rest_j:f32
    hs = vmul hv_j, vinv:f32
    y = vmul hs, wv:f32
    stm xn[j], y, rest_j:f32
    j2 = add j, w
    jmp norm(j2)
  quant:
    call quantize_q8(xn, xq, dx, d)
    ret

# Q, K or V head t: 64-row chunks of the QKV projection, then RoPE for q and k. A q head
# lands in the q buffer; a K or V head in a staging row, rounded to bf16 into this position's
# slot of its KV-cache row after RoPE.
fn qkv_head(t:i64, mat:ptr, xq:ptr, dx:ptr, qbuf:ptr, kc:ptr, vc:ptr, d:i64, nh:i64, nkv:i64, hd:i64, pos:i64, max_ctx:i64, kvf:i64, cos_r:ptr, sin_r:ptr)
  b0:
    hd4 = mul hd, 4:i64
    is_q = lt t, nh
    nhk = add nh, nkv
    is_k = lt t, nhk
    q_off = mul t, hd4
    q_dst = add qbuf, q_off
    stage = alloc hd4
    dst = select is_q, q_dst, stage
    ctile, ccol = call kv_slot(t, kc, vc, nh, nkv, hd, pos, max_ctx, kvf)
    per_head = udiv hd, 64:i64
    c0 = mul t, per_head
    jmp chunks(0:i64)
  chunks(i:i64):
    i_more = lt i, per_head
    br i_more, chunk_body, epilogue
  chunk_body:
    c = add c0, i
    o = mul i, 256:i64
    out = add dst, o
    call qmat_chunk(c, mat, xq, dx, out, d)
    i2 = add i, 1:i64
    jmp chunks(i2)
  epilogue:
    br is_k, rotate, store
  rotate:
    call rope_half(dst, hd, cos_r, sin_r)
    jmp store
  store:
    br is_q, done, to_cache
  to_cache:
    call kv_store(stage, ctile, ccol, hd, is_k, kvf)
    jmp done
  done:
    free stage
    ret

# Where K or V head t (t >= nh; a q head gets an unused address) stores position p: the
# tile of positions p - p mod 32 .. in its plane (head * max_ctx + p - p mod 32 positions of
# kv_rb bytes in), and p mod 32, the position's column in it.
fn kv_slot(t:i64, kc:ptr, vc:ptr, nh:i64, nkv:i64, hd:i64, p:i64, max_ctx:i64, kvf:i64)->(ptr, i64)
  b0:
    nhk = add nh, nkv
    is_k = lt t, nhk
    tk = sub t, nh
    tv = sub t, nhk
    kvh = select is_k, tk, tv
    r0 = mul kvh, max_ctx
    col = and p, 31:i64
    p0 = sub p, col
    r1 = add r0, p0
    rb = call kv_rb(hd, kvf)
    off = mul r1, rb
    base = select is_k, kc, vc
    tile = add base, off
    ret tile, col

# K (is_k) or V of one position, src[0 .. hd] after RoPE, into column col of its cache tile:
# rounded to bf16, K's value j at tile + 64 j + 2 col (a [hd x 32] tile) and V's row at
# tile + 2 hd col; or for an int8 cache (kvf 1) as attn_split_q8 reads them (to_q8_kv).
fn kv_store(src:ptr, tile:ptr, col:i64, hd:i64, is_k:i32, kvf:i64)
  b0:
    is_q8 = eq kvf, 1:i64
    br is_q8, q8, bf16
  q8:
    call to_q8_kv(src, tile, col, hd, is_k)
    ret
  bf16:
    br is_k, k, v
  k:
    col2 = shl col, 1:i64
    kt = add tile, col2
    call to_bf16_kt(src, kt, hd)
    ret
  v:
    row0 = mul col, hd
    row1 = shl row0, 1:i64
    vr = add tile, row1
    call to_bf16(src, vr, hd)
    ret

# K or V of one position into column col of an int8 cache tile (see attn_split_q8): src[0 ..
# hd] over d = max |x| / 127, rounded to int8 (half away from zero, as quantize_q8 does); K's
# values plus 128, byte q of group g at tile + 128 g + 4 col + q, V's at tile + hd col; d at
# tile + 32 hd + 4 col.
fn to_q8_kv(src:ptr, tile:ptr, col:i64, hd:i64, is_k:i32)
  b0:
    w = vl f32
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    row = alloc hd
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, hd
    br t_more, amax_body, scale
  amax_body:
    rest = sub hd, t
    v = ldm src[t]:vx, rest:f32
    av = vabs v:f32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    v_id = splat id:vx
    sc0 = shl hd, 5:i64
    col4 = shl col, 2:i64
    sc1 = add sc0, col4
    sp = add tile, sc1
    st sp, d
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, hd
    br s_more, quant_body, place
  quant_body:
    rest_q = sub hd, s
    xv = ldm src[s]:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    rv = vround sv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    cnt = min rest_q, w
    stm row[s:i8], q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  place:
    br is_k, k(0:i64), v_row
  k(g:i64):
    g_more = lt g, hd
    br g_more, k_body, done
  k_body:
    gi = ushr g, 2:i64
    x = ld row[gi]:i32
    xu = xor x, -2139062144:i32
    go = shl g, 5:i64
    ko = add go, col4
    kp = add tile, ko
    st kp, xu
    g2 = add g, 4:i64
    jmp k(g2)
  v_row:
    vo = mul col, hd
    vp = add tile, vo
    call copy_f32(row, vp, hd)
    jmp done
  done:
    free row
    ret

# K of one position into its cache tile: src[0 .. n] rounded to bf16 as to_bf16 does, value
# j at dst + 64 j (column of a [n x 32] tile).
fn to_bf16_kt(src:ptr, dst:ptr, n:i64)
  b0:
    n2 = mul n, 2:i64
    row = alloc n2
    call to_bf16(src, row, n)
    jmp loop(0:i64)
  loop(j:i64):
    more = lt j, n
    br more, body, done
  body:
    v = ld row[j]:i16
    o = mul j, 64:i64
    dj = add dst, o
    st dj, v
    j2 = add j, 1:i64
    jmp loop(j2)
  done:
    free row
    ret

# dst[0 .. n] = src[0 .. n] rounded to bf16 (nearest even).
fn to_bf16(src:ptr, dst:ptr, n:i64)
  b0:
    w16 = vl bf16
    w32 = vl f32
    jmp loop(0:i64)
  loop(j:i64):
    more = lt j, n
    br more, body, done
  body:
    rest = sub n, j
    rest_hi0 = sub rest, w32
    rest_hi = max rest_hi0, 0:i64
    j_hi = add j, w32
    lo = ldm src[j]:vx, rest:f32
    hi = ldm src[j_hi]:vx, rest_hi:f32
    v = vnarrow lo, hi:bf16
    stm dst[j], v, rest:bf16
    j2 = add j, w16
    jmp loop(j2)
  done:
    ret

# 1 / sqrt(hd), the attention scores' scale.
fn attn_scale(hd:i64)->f32
  b0:
    hdf = itof hd:f32
    sq = sqrt hdf
    scale = div 1.0:f32, sq
    ret scale

# Split s of KV head g (task = g * splits + s): positions 256 s .. of the first npos, for the
# group's query heads; records in `part`, head h's split s at (h * splits + s) * (hd + 2) f32.
fn attn_task(task:i64, qbuf:ptr, kc:ptr, vc:ptr, part:ptr, nh:i64, nkv:i64, hd:i64, npos:i64, max_ctx:i64, kvf:i64, splits:i64, scale:f32)
  b0:
    g = udiv task, splits
    s = urem task, splits
    group = udiv nh, nkv
    h0 = mul g, group
    hd4 = mul hd, 4:i64
    q_off = mul h0, hd4
    qg = add qbuf, q_off
    hd2 = add hd, 2:i64
    rec = mul hd2, 4:i64
    head_b = mul splits, rec
    p0 = mul h0, head_b
    p1 = mul s, rec
    p2 = add p0, p1
    pg = add part, p2
    call attn_part(g, s, qg, kc, vc, pg, group, hd, npos, max_ctx, kvf, scale, head_b)
    ret

# One split of attention (attn_split, or attn_split_q8 for an int8 cache) for KV head g:
# positions 256 s .. 256 s + 256 of the first npos, query heads at qg, records from pg
# (head_b bytes per head).
fn attn_part(g:i64, s:i64, qg:ptr, kc:ptr, vc:ptr, pg:ptr, group:i64, hd:i64, npos:i64, max_ctx:i64, kvf:i64, scale:f32, head_b:i64)
  b0:
    t0 = mul s, 256:i64
    t_end0 = add t0, 256:i64
    t1 = min t_end0, npos
    nt = sub t1, t0
    g_rows = mul g, max_ctx
    first = add g_rows, t0
    rb = call kv_rb(hd, kvf)
    kv_off = mul first, rb
    kb = add kc, kv_off
    vb = add vc, kv_off
    is_q8 = eq kvf, 1:i64
    br is_q8, q8, bf16
  bf16:
    call attn_split(qg, kb, vb, pg, group, hd, nt, scale, head_b)
    ret
  q8:
    call attn_split_q8(qg, kb, vb, pg, group, hd, nt, scale, head_b)
    ret

# Query head hq: merges its splits (attn_merge) and writes the result Q8-quantized into
# xq/dx at the head's offset, the O projection's input.
fn attn_out(hq:i64, part:ptr, xq:ptr, dx:ptr, hd:i64, splits:i64)
  b0:
    hd2 = add hd, 2:i64
    rec = mul hd2, 4:i64
    head_b = mul splits, rec
    hp_off = mul hq, head_b
    hp = add part, hp_off
    call merge_quant(hp, splits, hd, hq, xq, dx)
    ret

# attn_merge of a query head's splits (records from hp), quantized into xq/dx at head hq.
fn merge_quant(hp:ptr, splits:i64, hd:i64, hq:i64, xq:ptr, dx:ptr)
  b0:
    hd4 = mul hd, 4:i64
    out = alloc hd4
    hd2 = add hd, 2:i64
    rec = mul hd2, 4:i64
    call attn_merge(hp, splits, rec, hd, out)
    xq_off = mul hq, hd
    xq_h = add xq, xq_off
    blocks = udiv hd, 32:i64
    dx_off0 = mul hq, blocks
    dx_off = mul dx_off0, 16:i64
    dx_h = add dx, dx_off
    call quantize_q8(out, xq_h, dx_h, hd)
    free out
    ret

# h[64c .. 64c + 64] += (W x)[64c .. 64c + 64]: a projection fused with the residual add.
fn proj_add(c:i64, mat:ptr, xq:ptr, dx:ptr, h:ptr, k:i64)
  b0:
    w = vl f32
    tmp = stack 256
    call qmat_chunk(c, mat, xq, dx, tmp, k)
    h_off = mul c, 256:i64
    hc = add h, h_off
    jmp add_loop(0:i64)
  add_loop(j:i64):
    more = lt j, 64:i64
    br more, add_body, done
  add_body:
    rest = sub 64:i64, j
    tv = ldm tmp[j]:vx, rest:f32
    hv = ldm hc[j]:vx, rest:f32
    s = vadd hv, tv:f32
    stm hc[j], s, rest:f32
    j2 = add j, w
    jmp add_loop(j2)
  done:
    ret

# MLP rows 64c..64c+63: gate and up chunks, SwiGLU, then Q8 quantization for the down
# projection (two 32-blocks per task).
fn gate_up(c:i64, mat:ptr, xq:ptr, dx:ptr, aq:ptr, adx:ptr, k:i64)
  b0:
    g = stack 256
    u = stack 256
    a = stack 256
    cg = mul c, 2:i64
    cu = add cg, 1:i64
    call qmat_chunk(cg, mat, xq, dx, g, k)
    call qmat_chunk(cu, mat, xq, dx, u, k)
    call silu_mul(g, u, a, 64:i64)
    q_off = mul c, 64:i64
    aq_c = add aq, q_off
    d_off = mul c, 32:i64
    adx_c = add adx, d_off
    call quantize_q8(a, aq_c, adx_c, 64:i64)
    ret

# LM head rows 64c..64c+63, keeping only the best logit (first on ties) and its token.
fn lm_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, best:ptr, best_idx:ptr, k:i64)
  b0:
    tmp = stack 256
    call qmat_chunk(c, mat, xq, dx, tmp, k)
    first = ld tmp:f32
    jmp scan(1:i64, first, 0:i64)
  scan(j:i64, bv:f32, bj:i64):
    more = lt j, 64:i64
    br more, scan_body, done
  scan_body:
    v = ld tmp[j]:f32
    better = gt v, bv
    bv2 = select better, v, bv
    bj2 = select better, j, bj
    j2 = add j, 1:i64
    jmp scan(j2, bv2, bj2)
  done:
    st best[c], bv
    base = mul c, 64:i64
    tok = add base, bj
    st best_idx[c], tok
    ret

# Prefill: n prompt tokens (i64 [n] at `tokens`) at positions pos .. pos + n - 1, with the
# model, cache and h of llama_decode (pos + n <= max_ctx). Returns the greedy token after
# the last one; h holds the last token's final hidden state. Per layer: 2 norm passes over
# the tokens, then `par` regions like llama_decode's, each projection task computing its rows
# for every token (8 tokens per weight load). Attention runs one task per tile of 8 tokens
# and KV head, each token over the cache up to its own position (so tokens never see later
# ones), with the same splits and merges as llama_decode's (attn_tok).
fn llama_prefill(model:ptr, cfg:ptr, cache:ptr, tokens:ptr, n:i64, pos:i64, h:ptr, eps:f32)->i64
  b0:
    d, nl, nh, nkv, hd, f, vocab, max_ctx, kvf = call load_cfg(cfg)
    embd, norm_out, lm, cos_t, sin_t = call model_globals(model)
    w = vl f32
    d4 = mul d, 4:i64
    # hs: the residual streams of the n tokens, f32 [n x d].
    hs_sz = mul n, d4
    hs = alloc hs_sz
    jmp embed_tok(0:i64)
  embed_tok(s:i64):
    s_more = lt s, n
    br s_more, embed_start, setup
  embed_start:
    tok = ld tokens[s]:i64
    e_off = mul tok, d4
    e_row = add embd, e_off
    h_off = mul s, d4
    h_row = add hs, h_off
    jmp embed(0:i64)
  embed(ei:i64):
    e_more = lt ei, d
    br e_more, embed_body, embed_next
  embed_body:
    e_rest = sub d, ei
    ev = ldm e_row[ei]:vx, e_rest:f32
    stm h_row[ei], ev, e_rest:f32
    ei2 = add ei, w
    jmp embed(ei2)
  embed_next:
    s2 = add s, 1:i64
    jmp embed_tok(s2)

  setup:
    qd = mul nh, hd
    kmax0 = max d, qd
    # xs: bytes per token in the int8 activation buffers (any projection's input fits).
    xs = max kmax0, f
    xn = alloc hs_sz
    qd4 = mul qd, 4:i64
    qb_sz = mul n, qd4
    qbuf = alloc qb_sz
    xq_sz = mul n, xs
    xq = alloc xq_sz
    aq = alloc xq_sz
    dx_sz = udiv xq_sz, 2:i64
    dx = alloc dx_sz
    adx = alloc dx_sz
    rb = call kv_rb(hd, kvf)
    kv_row = mul nkv, rb
    kv_plane = mul max_ctx, kv_row
    kv_layer = mul kv_plane, 2:i64
    heads_all0 = mul nkv, 2:i64
    heads_all = add nh, heads_all0
    dchunks = udiv d, 64:i64
    fchunks = udiv f, 64:i64
    # attention: tiles of 8 tokens per KV head
    tiles0 = add n, 7:i64
    tiles = udiv tiles0, 8:i64
    a_tasks = mul tiles, nkv
    scale = call attn_scale(hd)
    jmp layers(0:i64)

  layers(l:i64):
    l_more = lt l, nl
    br l_more, layer_body, final
  layer_body:
    attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn = call layer_weights(model, l)
    kc_off = mul l, kv_layer
    kc = add cache, kc_off
    vc = add kc, kv_plane
    par n, norm_tok(hs, attn_norm, xn, xq, dx, d, eps, xs)
    par heads_all, qkv_head_n(m_qkv, xq, dx, qbuf, kc, vc, d, nh, nkv, hd, pos, max_ctx, kvf, cos_t, sin_t, n, xs)
    par a_tasks, attn_tok(qbuf, kc, vc, xq, dx, nh, nkv, hd, pos, max_ctx, kvf, scale, xs, n)
    par dchunks, proj_add_n(m_o, xq, dx, hs, qd, n, xs, d)
    par n, norm_tok(hs, ffn_norm, xn, xq, dx, d, eps, xs)
    par fchunks, gate_up_n(m_gu, xq, dx, aq, adx, d, n, xs)
    par dchunks, proj_add_n(m_dn, aq, adx, hs, f, n, xs, d)
    l2 = add l, 1:i64
    jmp layers(l2)

  final:
    last = sub n, 1:i64
    last_off = mul last, d4
    h_last = add hs, last_off
    jmp copy(0:i64)
  copy(ci:i64):
    c_more = lt ci, d
    br c_more, copy_body, head
  copy_body:
    c_rest = sub d, ci
    cv = ldm h_last[ci]:vx, c_rest:f32
    stm h[ci], cv, c_rest:f32
    ci2 = add ci, w
    jmp copy(ci2)
  head:
    call norm_quant(h, norm_out, xn, xq, dx, d, eps)
    next = call lm_argmax(lm, xq, dx, d, vocab)
    free adx
    free dx
    free aq
    free xq
    free qbuf
    free xn
    free hs
    ret next

# norm_quant for token s of a prefill: its residual stream row of hs, its xn row, and its
# int8 activations xs bytes apart (block records xs / 2 apart).
fn norm_tok(s:i64, hs:ptr, wt:ptr, xn:ptr, xq:ptr, dx:ptr, d:i64, eps:f32, xs:i64)
  b0:
    d4 = mul d, 4:i64
    r_off = mul s, d4
    h_s = add hs, r_off
    xn_s = add xn, r_off
    q_off = mul s, xs
    xq_s = add xq, q_off
    ds = udiv xs, 2:i64
    d_off = mul s, ds
    dx_s = add dx, d_off
    call norm_quant(h_s, wt, xn_s, xq_s, dx_s, d, eps)
    ret

# qkv_head for n tokens: head t's 64-row chunks for every token (qmat_batch), each token's
# rows written to its q row or a staging row, then RoPE at its position and, for K and V,
# bf16 into its position's KV-cache slot.
fn qkv_head_n(t:i64, mat:ptr, xq:ptr, dx:ptr, qbuf:ptr, kc:ptr, vc:ptr, d:i64, nh:i64, nkv:i64, hd:i64, pos:i64, max_ctx:i64, kvf:i64, cos_t:ptr, sin_t:ptr, n:i64, xs:i64)
  b0:
    w = vl f32
    hd4 = mul hd, 4:i64
    qd4 = mul nh, hd4
    is_q = lt t, nh
    nhk = add nh, nkv
    is_k = lt t, nhk
    q_off = mul t, hd4
    stage_sz = mul n, hd4
    stage = alloc stage_sz
    half = udiv hd, 2:i64
    rope_row = mul half, 4:i64
    per_head = udiv hd, 64:i64
    c0 = mul t, per_head
    tmp_sz = mul n, 256:i64
    tmp = alloc tmp_sz
    jmp chunks(0:i64)
  chunks(i:i64):
    i_more = lt i, per_head
    br i_more, chunk_body, rope(0:i64)
  chunk_body:
    c = add c0, i
    call qmat_batch(c, mat, xq, dx, tmp, d, n, xs)
    o = mul i, 256:i64
    jmp scatter(0:i64)
  scatter(s:i64):
    s_more = lt s, n
    br s_more, scatter_start, chunk_next
  scatter_start:
    sq = mul s, qd4
    q_dst0 = add qbuf, sq
    q_dst = add q_dst0, q_off
    sg = mul s, hd4
    kv_dst = add stage, sg
    dst0 = select is_q, q_dst, kv_dst
    dst = add dst0, o
    st_off = mul s, 256:i64
    src = add tmp, st_off
    jmp copy(0:i64)
  copy(j:i64):
    j_more = lt j, 64:i64
    br j_more, copy_body, scatter_next
  copy_body:
    j_rest = sub 64:i64, j
    v = ldm src[j]:vx, j_rest:f32
    stm dst[j], v, j_rest:f32
    j2 = add j, w
    jmp copy(j2)
  scatter_next:
    s2 = add s, 1:i64
    jmp scatter(s2)
  chunk_next:
    i2 = add i, 1:i64
    jmp chunks(i2)
  rope(r:i64):
    r_more = lt r, n
    br r_more, rope_body, done
  rope_body:
    rq0 = mul r, qd4
    rq1 = add qbuf, rq0
    rq = add rq1, q_off
    rs = mul r, hd4
    rkv = add stage, rs
    x = select is_q, rq, rkv
    rp = add pos, r
    br is_k, rotate, store
  rotate:
    rr = mul rp, rope_row
    cos_r = add cos_t, rr
    sin_r = add sin_t, rr
    call rope_half(x, hd, cos_r, sin_r)
    jmp store
  store:
    br is_q, rope_next, to_cache
  to_cache:
    ctile, ccol = call kv_slot(t, kc, vc, nh, nkv, hd, rp, max_ctx, kvf)
    call kv_store(x, ctile, ccol, hd, is_k, kvf)
    jmp rope_next
  rope_next:
    r2 = add r, 1:i64
    jmp rope(r2)
  done:
    free stage
    free tmp
    ret

# Attention of a tile of up to 8 tokens s0 .. s0 + tn - 1 for KV head g (task = tile * nkv
# + g), token s over positions 0 .. pos + s: the same splits (attn_part) and merges
# (merge_quant) as llama_decode at that position, in a buffer of its own, so its results are
# llama_decode's bit for bit. The splits that every token of the tile sees whole (all 256
# positions) run once for all of the tile's query heads, so each K and V vector is read
# from memory once for the tile; attn_split computes each head's row on its own, so a row's
# results do not depend on the heads beside it. Each token's remaining splits run on their
# own. Writes the group's Q8 outputs into each token's activations.
fn attn_tok(task:i64, qbuf:ptr, kc:ptr, vc:ptr, xq:ptr, dx:ptr, nh:i64, nkv:i64, hd:i64, pos:i64, max_ctx:i64, kvf:i64, scale:f32, xs:i64, n:i64)
  b0:
    tile = udiv task, nkv
    g = urem task, nkv
    s0 = mul tile, 8:i64
    left = sub n, s0
    tn = min left, 8:i64
    group = udiv nh, nkv
    h0 = mul g, group
    hd4 = mul hd, 4:i64
    qd4 = mul nh, hd4
    # splits every token sees whole, and the last token's split count
    p0 = add pos, s0
    npos0 = add p0, 1:i64
    shared = udiv npos0, 256:i64
    npos_last = add p0, tn
    last255 = add npos_last, 255:i64
    smax = udiv last255, 256:i64
    hd2 = add hd, 2:i64
    rec = mul hd2, 4:i64
    head_b = mul smax, rec
    rows = mul tn, group
    part_sz = mul rows, head_b
    part = alloc part_sz
    # the tile's query heads of KV head g, token by token: rows s * group + r
    gb = mul group, hd4
    qt_sz = mul tn, gb
    qt = alloc qt_sz
    q_h0 = mul h0, hd4
    jmp gather(0:i64)
  gather(gs:i64):
    gs_more = lt gs, tn
    br gs_more, gather_start, shared_splits(0:i64)
  gather_start:
    gtok = add s0, gs
    gq0 = mul gtok, qd4
    gq1 = add qbuf, gq0
    gsrc = add gq1, q_h0
    gd0 = mul gs, gb
    gdst = add qt, gd0
    call copy_f32(gsrc, gdst, gb)
    gs2 = add gs, 1:i64
    jmp gather(gs2)
  shared_splits(sp:i64):
    sp_more = lt sp, shared
    br sp_more, shared_body, tokens(0:i64)
  shared_body:
    sp_off = mul sp, rec
    pg = add part, sp_off
    call attn_part(g, sp, qt, kc, vc, pg, rows, hd, npos0, max_ctx, kvf, scale, head_b)
    sp2 = add sp, 1:i64
    jmp shared_splits(sp2)
  # Token by token: its own splits, then the merge of each of its heads.
  tokens(ts:i64):
    ts_more = lt ts, tn
    br ts_more, token_start, done
  token_start:
    s = add s0, ts
    p = add pos, s
    npos = add p, 1:i64
    npos255 = add npos, 255:i64
    splits = udiv npos255, 256:i64
    t_rows = mul ts, group
    t_part0 = mul t_rows, head_b
    t_part = add part, t_part0
    t_q0 = mul ts, gb
    t_q = add qt, t_q0
    x_off = mul s, xs
    xq_s = add xq, x_off
    ds = udiv xs, 2:i64
    d_off = mul s, ds
    dx_s = add dx, d_off
    jmp split(shared)
  split(tsp:i64):
    tsp_more = lt tsp, splits
    br tsp_more, split_body, merge(0:i64)
  split_body:
    tsp_off = mul tsp, rec
    tpg = add t_part, tsp_off
    call attn_part(g, tsp, t_q, kc, vc, tpg, group, hd, npos, max_ctx, kvf, scale, head_b)
    tsp2 = add tsp, 1:i64
    jmp split(tsp2)
  merge(r:i64):
    r_more = lt r, group
    br r_more, merge_body, token_next
  merge_body:
    hp_off = mul r, head_b
    hp = add t_part, hp_off
    hq = add h0, r
    call merge_quant(hp, splits, hd, hq, xq_s, dx_s)
    r2 = add r, 1:i64
    jmp merge(r2)
  token_next:
    ts2 = add ts, 1:i64
    jmp tokens(ts2)
  done:
    free qt
    free part
    ret

# dst[0 .. bytes] = src[0 .. bytes], bytes a multiple of 4.
fn copy_f32(src:ptr, dst:ptr, bytes:i64)
  b0:
    w = vl f32
    n = udiv bytes, 4:i64
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    v = ldm src[i]:vx, rest:f32
    stm dst[i], v, rest:f32
    i2 = add i, w
    jmp loop(i2)
  done:
    ret

# proj_add for n tokens: rows 64c..64c+63 of every token's residual stream += (W x).
fn proj_add_n(c:i64, mat:ptr, xq:ptr, dx:ptr, hs:ptr, k:i64, n:i64, xs:i64, d:i64)
  b0:
    w = vl f32
    tmp_sz = mul n, 256:i64
    tmp = alloc tmp_sz
    call qmat_batch(c, mat, xq, dx, tmp, k, n, xs)
    d4 = mul d, 4:i64
    c_off = mul c, 256:i64
    jmp toks(0:i64)
  toks(s:i64):
    s_more = lt s, n
    br s_more, tok_start, done
  tok_start:
    r_off = mul s, d4
    row = add hs, r_off
    hc = add row, c_off
    t_off = mul s, 256:i64
    ts = add tmp, t_off
    jmp add_loop(0:i64)
  add_loop(j:i64):
    more = lt j, 64:i64
    br more, add_body, tok_next
  add_body:
    rest = sub 64:i64, j
    tv = ldm ts[j]:vx, rest:f32
    hv = ldm hc[j]:vx, rest:f32
    sum = vadd hv, tv:f32
    stm hc[j], sum, rest:f32
    j2 = add j, w
    jmp add_loop(j2)
  tok_next:
    s2 = add s, 1:i64
    jmp toks(s2)
  done:
    free tmp
    ret

# gate_up for n tokens: MLP rows 64c..64c+63 of every token, SwiGLU, then Q8 quantization
# into the token's down-projection input.
fn gate_up_n(c:i64, mat:ptr, xq:ptr, dx:ptr, aq:ptr, adx:ptr, k:i64, n:i64, xs:i64)
  b0:
    tmp_sz = mul n, 256:i64
    g = alloc tmp_sz
    u = alloc tmp_sz
    a = stack 256
    cg = mul c, 2:i64
    cu = add cg, 1:i64
    call qmat_batch(cg, mat, xq, dx, g, k, n, xs)
    call qmat_batch(cu, mat, xq, dx, u, k, n, xs)
    ds = udiv xs, 2:i64
    q_off = mul c, 64:i64
    d_off = mul c, 32:i64
    jmp toks(0:i64)
  toks(s:i64):
    s_more = lt s, n
    br s_more, tok_body, done
  tok_body:
    t_off = mul s, 256:i64
    gs = add g, t_off
    us = add u, t_off
    call silu_mul(gs, us, a, 64:i64)
    x_off = mul s, xs
    aq_s = add aq, x_off
    aq_c = add aq_s, q_off
    dd_off = mul s, ds
    adx_s = add adx, dd_off
    adx_c = add adx_s, d_off
    call quantize_q8(a, aq_c, adx_c, 64:i64)
    s2 = add s, 1:i64
    jmp toks(s2)
  done:
    free u
    free g
    ret

# The 9 words of cfg: d, layers, heads, kv_heads, head_dim, ffn, vocab, max_ctx and the KV
# cache's format (0 bf16, 1 int8); max_ctx rounded up to a multiple of 32, the cache's
# positions per head (it is stored in tiles of 32 positions).
inline fn load_cfg(cfg:ptr)->(i64, i64, i64, i64, i64, i64, i64, i64, i64)
  b0:
    d = ld cfg[0]:i64
    nl = ld cfg[1]:i64
    nh = ld cfg[2]:i64
    nkv = ld cfg[3]:i64
    hd = ld cfg[4]:i64
    f = ld cfg[5]:i64
    vocab = ld cfg[6]:i64
    ctx = ld cfg[7]:i64
    ctx31 = add ctx, 31:i64
    max_ctx = and ctx31, -32:i64
    kvf = ld cfg[8]:i64
    ret d, nl, nh, nkv, hd, f, vocab, max_ctx, kvf

# Bytes per position of a KV head's K (or V) in the cache: hd bf16 values, or hd int8 values
# and an f32 scale (kvf 1).
inline fn kv_rb(hd:i64, kvf:i64)->i64
  b0:
    is_q8 = eq kvf, 1:i64
    q8b = add hd, 4:i64
    bf = shl hd, 1:i64
    rb = select is_q8, q8b, bf
    ret rb

# The model table's global entries: embedding, final norm, LM head, RoPE cos and sin
# tables.
inline fn model_globals(model:ptr)->(ptr, ptr, ptr, ptr, ptr)
  b0:
    embd = ld model[0]:ptr
    norm_out = ld model[1]:ptr
    lm = ld model[2]:ptr
    cos_t = ld model[3]:ptr
    sin_t = ld model[4]:ptr
    ret embd, norm_out, lm, cos_t, sin_t

# Layer l's entries (6 words at 5 + 6 l): its two norm weights and its QKV, O, gate/up and
# down matrices.
inline fn layer_weights(model:ptr, l:i64)->(ptr, ptr, ptr, ptr, ptr, ptr)
  b0:
    slot0 = mul l, 6:i64
    slot = add slot0, 5:i64
    lp_off = shl slot, 3:i64
    lp = add model, lp_off
    attn_norm = ld lp[0]:ptr
    m_qkv = ld lp[1]:ptr
    m_o = ld lp[2]:ptr
    ffn_norm = ld lp[3]:ptr
    m_gu = ld lp[4]:ptr
    m_dn = ld lp[5]:ptr
    ret attn_norm, m_qkv, m_o, ffn_norm, m_gu, m_dn
