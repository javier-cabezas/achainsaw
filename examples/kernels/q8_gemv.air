# Quantized matrix-vector product y = W x on all cores, Q8_0 style (llama.cpp): W is m x k
# int8 in blocks of 32 along k, each block row with its own f16 scale,
#   W[i][32b + t] = scales[b][i] * q[i][32b + t],
# and x is quantized on the fly the same way: dx[b] = max|x in block b| / 127,
# xq = round(x / dx). Each block contributes scales[b][i] * dx[b] * (q[i] . xq) with an exact
# int32 dot product, so the weights are read once, as 1 byte (plus 1/16 for scales).
#
# Packed layout, for m a multiple of 64 and k a multiple of 32: output rows come in chunks
# of 64; chunk c holds
#   wq     + c * k * 64:        q for its rows, 2048 bytes per block b: byte (g * 64 + j) * 4
#                               + t holds q[64c + j][32b + 4g + t] (g < 8, t < 4), so each
#                               32-bit lane holds 4 consecutive values of one row
#   scales + c * (k/32) * 128:  their scales ([k/32 x 64] f16)
# so each chunk is contiguous and one `par` task computes it with the standard library's
# qmat_chunk: per block, `vdot` multiplies each lane's 4 values by 4 activations (VNNI
# vpdpbusd, Arm sdot) into exact int32 dots, which are converted to f32 (vitof), scaled and
# accumulated into y.

use quantize_q8, qmat_chunk

fn q8_gemv(wq:ptr, scales:ptr, x:ptr, y:ptr, m:i64, k:i64)
  b0:
    nb = udiv k, 32:i64
    xq = alloc k
    nb16 = mul nb, 16:i64
    dx = alloc nb16
    call quantize_q8(x, xq, dx, k)
    # The matrix as qmat_chunk takes it: weights, scales, format (0).
    mat = alloc 24:i64
    st mat, wq
    mat1 = add mat, 8:i64
    st mat1, scales
    mat2 = add mat, 16:i64
    st mat2, 0:i64
    chunks = udiv m, 64:i64
    par chunks, q8_gemv_chunk(mat, xq, dx, y, k)
    free mat
    free dx
    free xq
    ret

# y[64c .. 64c + 64] for chunk c.
fn q8_gemv_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, y:ptr, k:i64)
  b0:
    y_off = mul c, 256:i64
    yc = add y, y_off
    call qmat_chunk(c, mat, xq, dx, yc, k)
    ret
