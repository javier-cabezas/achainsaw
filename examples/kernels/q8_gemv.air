# Quantized matrix-vector product y = W x on all cores, Q8_0 style (llama.cpp): W is m x k
# int8 in blocks of 32 along k, each block row with its own f32 scale,
#   W[i][32b + t] = scales[b][i] * q[i][32b + t],
# and x is quantized on the fly the same way: dx[b] = max|x in block b| / 127,
# xq = round(x / dx). Each block contributes scales[b][i] * dx[b] * (q[i] . xq) with an exact
# int32 dot product, so the weights are read once, as 1 byte (plus 1/8 for scales).
#
# Packed layout, for m a multiple of 64 and k a multiple of 32: output rows come in chunks
# of 64; chunk c holds
#   wq     + c * k * 64:        q for its rows, k-major ([k x 64] i8, row kk = column kk)
#   scales + c * (k/32) * 256:  their scales ([k/32 x 64] f32)
# so each chunk is contiguous and one `par` task computes it: per block, one i8 `mm`
# [1 x 32] . [32 x 64] gives the 64 int32 dots (AMX, SME, vector or Cranelift tiles), which
# are converted to f32 and accumulated into y.
#
# Vectors are untyped bits: an int32 lane p with |p| < 2^22 converts to f32 as
# bits(p + 0x4B400000) - 1.5 * 2^23 (a block's dot is at most 32 * 127 * 127 < 2^19).
fn q8_gemv(wq:ptr, scales:ptr, x:ptr, y:ptr, m:i64, k:i64)
  b0:
    nb = udiv k, 32:i64
    xq = alloc k
    nb4 = mul nb, 4:i64
    dx = alloc nb4
    call quantize_q8(x, xq, dx, k)
    chunks = udiv m, 64:i64
    par chunks, q8_chunk(wq, scales, xq, dx, y, k)
    free dx
    free xq
    ret

# xq[32b + t] = round(x[32b + t] / dx[b]) (halves away from zero), dx[b] = max|x| / 127.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = mul b, 32:i64
    jmp amax(0:i64, zf)
  amax(t:i64, a:f32):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    i = add base, t
    off = mul i, 4:i64
    px = add x, off
    v = ld px:f32
    av = abs v
    a2 = max a, av
    t2 = add t, 1:i64
    jmp amax(t2, a2)
  scale:
    d = div a, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    b_off = mul b, 4:i64
    pd = add dx, b_off
    st pd, d
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    j = add base, s
    j_off = mul j, 4:i64
    pj = add x, j_off
    xj = ld pj:f32
    sv = mul xj, id
    nonneg = ge sv, zf
    half = select nonneg, 0.5:f32, -0.5:f32
    rv = add sv, half
    q32 = ftoi rv:i32
    q = trunc q32:i8
    pq = add xq, j
    st pq, q
    s2 = add s, 1:i64
    jmp quant(s2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# y[64c .. 64c + 64] for chunk c.
fn q8_chunk(c:i64, wq:ptr, scales:ptr, xq:ptr, dx:ptr, y:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    chunk_w = mul k, 64:i64
    w_off = mul c, chunk_w
    wc = add wq, w_off
    chunk_s = mul nb, 256:i64
    s_off = mul c, chunk_s
    sc = add scales, s_off
    y_off = mul c, 256:i64
    yc = add y, y_off
    dots = alloc 256:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    magic = cst 12582912.0:f32
    v_magic = splat magic:vx
    magic_bits = cst 1262485504:i32
    v_magic_bits = splat magic_bits:vx
    jmp zero_y(0:i64)
  zero_y(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_y_body, blocks(0:i64)
  zero_y_body:
    z_rest = sub 64:i64, z
    z_off = mul z, 4:i64
    pz = add yc, z_off
    stm pz, v_zero, z_rest:f32
    z2 = add z, w
    jmp zero_y(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    jmp zero_dots(0:i64)
  zero_dots(zd:i64):
    zd_more = lt zd, 64:i64
    br zd_more, zero_dots_body, block_mm
  zero_dots_body:
    zd_rest = sub 64:i64, zd
    zd_off = mul zd, 4:i64
    pzd = add dots, zd_off
    stm pzd, v_zero, zd_rest:i32
    zd2 = add zd, w
    jmp zero_dots(zd2)
  block_mm:
    xb_off = mul b, 32:i64
    xb = add xq, xb_off
    wb_off = mul b, 2048:i64
    wb = add wc, wb_off
    mm dots, xb, wb, 1:i64, 64:i64, 32:i64:i8
    d_off = mul b, 4:i64
    pd = add dx, d_off
    d = ld pd:f32
    vd = splat d:vx
    sb_off = mul b, 256:i64
    sb = add sc, sb_off
    jmp accum(0:i64)
  accum(j:i64):
    j_more = lt j, 64:i64
    br j_more, accum_body, block_next
  accum_body:
    j_rest = sub 64:i64, j
    j_off = mul j, 4:i64
    pp = add dots, j_off
    ps = add sb, j_off
    py = add yc, j_off
    p = ldm pp:vx, j_rest:i32
    pb = vadd p, v_magic_bits:i32
    pf = vsub pb, v_magic:f32
    s = ldm ps:vx, j_rest:f32
    ds = vmul s, vd:f32
    acc = ldm py:vx, j_rest:f32
    acc2 = vfma pf, ds, acc:f32
    stm py, acc2, j_rest:f32
    j2 = add j, w
    jmp accum(j2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    free dots
    ret
