# Root-Mean-Square Normalization (RMSNorm) Kernel (128-bit SIMD)
# Computes: y_i = (x_i / sqrt(mean(x^2) + eps)) * w_i
# Used in modern LLM architectures (LLaMA, Mistral, Gemma)
extfn sqrtf(x:f32)->f32

fn rmsnorm(p_x:ptr, p_w:ptr, p_out:ptr, n_vecs:i64, inv_n:f32)->f32
  b0:
    zero_f = cst 0.0:f32
    vacc_sq = splat zero_f
    zero_i = cst 0:i64
    jmp b_sum_loop(zero_i, vacc_sq)
  b_sum_loop(i:i64, acc_sq:v128):
    cond_sum = lt i, n_vecs
    br cond_sum, b_sum_body, b_sum_done
  b_sum_body:
    sixteen = cst 16:i64
    off_i = mul i, sixteen
    px_i = add p_x, off_i
    vx_i = ld px_i:v128
    vsq_i = vfmul vx_i, vx_i
    next_acc = vfadd acc_sq, vsq_i
    one = cst 1:i64
    next_i = add i, one
    jmp b_sum_loop(next_i, next_acc)
  b_sum_done:
    l0 = extlane acc_sq, 0:f32
    l1 = extlane acc_sq, 1:f32
    l2 = extlane acc_sq, 2:f32
    l3 = extlane acc_sq, 3:f32
    s01 = add l0, l1
    s23 = add l2, l3
    sum_sq = add s01, s23

    # Calculate RMS scale
    mean_sq = mul sum_sq, inv_n
    eps = cst 0.000001:f32
    mean_eps = add mean_sq, eps
    rms = call sqrtf(mean_eps)
    one_f = cst 1.0:f32
    inv_rms = div one_f, rms
    vinv_rms = splat inv_rms

    zero_j = cst 0:i64
    jmp b_norm_loop(zero_j, vinv_rms, inv_rms)
  b_norm_loop(j:i64, v_scale:v128, final_inv_rms:f32):
    cond_norm = lt j, n_vecs
    br cond_norm, b_norm_body, b_norm_done(final_inv_rms)
  b_norm_body:
    sixteen_b = cst 16:i64
    off_j = mul j, sixteen_b
    px_j = add p_x, off_j
    pw_j = add p_w, off_j
    pout_j = add p_out, off_j
    vx_j = ld px_j:v128
    vw_j = ld pw_j:v128
    vnorm = vfmul vx_j, v_scale
    vy = vfmul vnorm, vw_j
    st pout_j, vy
    one_b = cst 1:i64
    next_j = add j, one_b
    jmp b_norm_loop(next_j, v_scale, final_inv_rms)
  b_norm_done(res_inv_rms:f32):
    ret res_inv_rms
