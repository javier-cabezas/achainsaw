# RMSNorm over n f32 values, as in LLaMA, Mistral and Gemma:
#   out_i = x_i / sqrt(mean(x^2) + 1e-6) * w_i
# Returns the scale 1 / sqrt(mean(x^2) + 1e-6). Vector-length agnostic, with masked
# loads/stores for the final partial vector.
fn rmsnorm(x:ptr, w:ptr, out:ptr, n:i64)->f32
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    lanes = vl f32
    jmp sum(0:i64, zero)
  sum(i:i64, acc:vx):
    more = lt i, n
    br more, sum_body, scale
  sum_body:
    rest = sub n, i
    off = mul i, 4:i64
    px = add x, off
    vx0 = ldm px:vx, rest:f32
    acc2 = vfma vx0, vx0, acc:f32
    i2 = add i, lanes
    jmp sum(i2, acc2)
  scale:
    ss = vsum acc:f32
    nf = itof n:f32
    mean = div ss, nf
    mean_eps = add mean, 0.000001:f32
    rms = sqrt mean_eps
    inv = div 1.0:f32, rms
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, n
    br more_j, norm_body, done
  norm_body:
    rest_j = sub n, j
    off_j = mul j, 4:i64
    px_j = add x, off_j
    pw_j = add w, off_j
    po_j = add out, off_j
    xv = ldm px_j:vx, rest_j:f32
    wv = ldm pw_j:vx, rest_j:f32
    xs = vmul xv, vinv:f32
    y = vmul xs, wv:f32
    stm po_j, y, rest_j:f32
    j2 = add j, lanes
    jmp norm(j2)
  done:
    ret inv
