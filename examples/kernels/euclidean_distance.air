# Euclidean (L2) distance between two f32 vectors of n elements: sqrt(sum((a_i - b_i)^2)).
# Vector-length agnostic, with a masked load for the final partial vector.
fn euclidean_distance(a:ptr, b:ptr, n:i64)->f32
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    w = vl f32
    jmp loop(0:i64, zero)
  loop(i:i64, acc:vx):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    off = mul i, 4:i64
    pa = add a, off
    pb = add b, off
    va = ldm pa:vx, rest:f32
    vb = ldm pb:vx, rest:f32
    d = vsub va, vb:f32
    acc2 = vfma d, d, acc:f32
    i2 = add i, w
    jmp loop(i2, acc2)
  done:
    s = vsum acc:f32
    dist = sqrt s
    ret dist
