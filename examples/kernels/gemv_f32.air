# Matrix-Vector Multiplication (GEMV) Kernel (128-bit SIMD)
# Computes: y = A * x where A is M x (4 * k_vecs) row-major matrix
fn gemv(p_a:ptr, p_x:ptr, p_y:ptr, m:i64, k_vecs:i64)->i64
  b0:
    zero_i = cst 0:i64
    jmp b_row_loop(zero_i)
  b_row_loop(i:i64):
    cond_row = lt i, m
    br cond_row, b_row_init, b_row_done
  b_row_init:
    sixteen = cst 16:i64
    row_bytes = mul k_vecs, sixteen
    row_offset = mul i, row_bytes
    zero_f = cst 0.0:f32
    vdot = splat zero_f
    zero_j = cst 0:i64
    jmp b_col_loop(zero_j, vdot, row_offset, i)
  b_col_loop(j:i64, acc:v128, r_off:i64, cur_i:i64):
    cond_col = lt j, k_vecs
    br cond_col, b_col_body, b_col_done(acc, cur_i)
  b_col_body:
    sixteen_col = cst 16:i64
    col_off = mul j, sixteen_col
    a_elem_off = add r_off, col_off
    p_a_cur = add p_a, a_elem_off
    p_x_cur = add p_x, col_off
    va = ld p_a_cur:v128
    vx = ld p_x_cur:v128
    vprod = vfmul va, vx
    next_acc = vfadd acc, vprod
    one_j = cst 1:i64
    next_j = add j, one_j
    jmp b_col_loop(next_j, next_acc, r_off, cur_i)
  b_col_done(final_acc:v128, done_i:i64):
    l0 = extlane final_acc, 0:f32
    l1 = extlane final_acc, 1:f32
    l2 = extlane final_acc, 2:f32
    l3 = extlane final_acc, 3:f32
    s01 = add l0, l1
    s23 = add l2, l3
    row_sum = add s01, s23

    four = cst 4:i64
    y_off = mul done_i, four
    p_y_cur = add p_y, y_off
    st p_y_cur, row_sum

    one_i = cst 1:i64
    next_i = add done_i, one_i
    jmp b_row_loop(next_i)
  b_row_done:
    ret m
