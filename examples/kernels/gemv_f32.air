# Matrix-vector product y = A x for a row-major m x k f32 matrix A.
# Each row is a vector-length-agnostic dot product with a masked load for the final
# partial vector.
fn gemv(a:ptr, x:ptr, y:ptr, m:i64, k:i64)
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    w = vl f32
    row_bytes = mul k, 4:i64
    jmp rows(0:i64)
  rows(i:i64):
    more_i = lt i, m
    br more_i, row_init, done
  row_init:
    row_off = mul i, row_bytes
    prow = add a, row_off
    jmp cols(0:i64, zero)
  cols(j:i64, acc:vx):
    more_j = lt j, k
    br more_j, cols_body, row_done
  cols_body:
    rest = sub k, j
    off = mul j, 4:i64
    pa = add prow, off
    px = add x, off
    va = ldm pa:vx, rest:f32
    vx0 = ldm px:vx, rest:f32
    acc2 = vfma va, vx0, acc:f32
    j2 = add j, w
    jmp cols(j2, acc2)
  row_done:
    s = vsum acc:f32
    yoff = mul i, 4:i64
    py = add y, yoff
    st py, s
    i2 = add i, 1:i64
    jmp rows(i2)
  done:
    ret
