# Quantized matrix-vector product y = W x on all cores, Q4_0 style (llama.cpp): W is m x k
# with 4-bit weights in blocks of 32 along k, each block row with its own f16 scale,
#   W[i][32b + t] = scales[b][i] * (q[i][32b + t] - 8),   q in 0..15,
# and x quantized on the fly to int8 per 32-block as in q8_gemv. Each block contributes
# scales[b][i] * dx[b] * ((q[i] - 8) . xq) with an exact int32 dot product, so the weights are
# read once, as half a byte (plus 1/16 for scales): 53% of Q8_0's traffic.
#
# Packed layout, for m a multiple of 64 and k a multiple of 32: output rows come in chunks
# of 64; chunk c holds
#   wq     + c * k * 32:        nibbles for its rows, 1024 bytes per block b: byte t * 64 + j
#                               holds q[64c + j][32b + t] (low nibble) and q[64c + j][32b +
#                               16 + t] (high nibble), t < 16
#   scales + c * (k/32) * 128:  their scales ([k/32 x 64] f16)
# so a block unpacks with a mask, a shift and a subtraction per byte into the [32 x 64] i8
# tile that q8_gemv stores directly (low nibbles fill rows 0..15, high nibbles rows 16..31),
# and the same i8 `mm` gives the 64 int32 dots.
fn q4_gemv(wq:ptr, scales:ptr, x:ptr, y:ptr, m:i64, k:i64)
  b0:
    nb = udiv k, 32:i64
    xq = alloc k
    nb4 = mul nb, 4:i64
    dx = alloc nb4
    call quantize_q8(x, xq, dx, k)
    chunks = udiv m, 64:i64
    par chunks, q4_chunk(wq, scales, xq, dx, y, k)
    free dx
    free xq
    ret

# xq[32b + t] = round(x[32b + t] / dx[b]) (halves away from zero), dx[b] = max|x| / 127.
# At full vector width: |x| by clearing the sign bit, rounding by adding 0.5 with the value's
# sign, then vftoi and two saturating vnarrows down to i8, stored a vector's worth at a time.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    abs_bits = cst 2147483647:i32
    v_abs = splat abs_bits:vx
    sign_bits = cst -2147483648:i32
    v_sign = splat sign_bits:vx
    half = cst 0.5:f32
    v_half = splat half:vx
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = mul b, 32:i64
    base4 = mul base, 4:i64
    bx = add x, base4
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    rest = sub 32:i64, t
    to = mul t, 4:i64
    pv = add bx, to
    v = ldm pv:vx, rest:f32
    av = vand v, v_abs:i32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    b_off = mul b, 4:i64
    pd = add dx, b_off
    st pd, d
    v_id = splat id:vx
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    rest_q = sub 32:i64, s
    so = mul s, 4:i64
    pq_in = add bx, so
    xv = ldm pq_in:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    sgn = vand sv, v_sign:i32
    hv = vor sgn, v_half:i32
    rv = vadd sv, hv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    q_off = add base, s
    po = add xq, q_off
    cnt = min rest_q, w
    stm po, q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# y[64c .. 64c + 64] for chunk c: per block, unpack the nibbles into `tile`, then as q8_chunk.
fn q4_chunk(c:i64, wq:ptr, scales:ptr, xq:ptr, dx:ptr, y:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    chunk_w = mul k, 32:i64
    w_off = mul c, chunk_w
    wc = add wq, w_off
    chunk_s = mul nb, 128:i64
    s_off = mul c, chunk_s
    sc = add scales, s_off
    y_off = mul c, 256:i64
    yc = add y, y_off
    dots = alloc 256:i64
    tile = alloc 2048:i64
    w8 = vl i8
    lo_mask = cst 15:i8
    v_lo_mask = splat lo_mask:vx
    eight = cst 8:i8
    v_eight = splat eight:vx
    four = cst 4:i32
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    mag_mask = cst 32767:i32
    v_mag_mask = splat mag_mask:vx
    sign_bit = cst -2147483648:i32
    v_sign_bit = splat sign_bit:vx
    two_112 = cst 2004877312:i32
    v_two_112 = splat two_112:vx
    jmp zero_y(0:i64)
  zero_y(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_y_body, blocks(0:i64)
  zero_y_body:
    z_rest = sub 64:i64, z
    z_off = mul z, 4:i64
    pz = add yc, z_off
    stm pz, v_zero, z_rest:f32
    z2 = add z, w
    jmp zero_y(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    jmp zero_dots(0:i64)
  zero_dots(zd:i64):
    zd_more = lt zd, 64:i64
    br zd_more, zero_dots_body, unpack(0:i64)
  zero_dots_body:
    zd_rest = sub 64:i64, zd
    zd_off = mul zd, 4:i64
    pzd = add dots, zd_off
    stm pzd, v_zero, zd_rest:i32
    zd2 = add zd, w
    jmp zero_dots(zd2)
  unpack(u:i64):
    u_more = lt u, 1024:i64
    br u_more, unpack_body, block_mm
  unpack_body:
    nib_off = mul b, 1024:i64
    nib_base = add wc, nib_off
    pn = add nib_base, u
    nv = ld pn:vx
    lo = vand nv, v_lo_mask:i8
    lo_q = vsub lo, v_eight:i8
    hi = vushr nv, four:i8
    hi_q = vsub hi, v_eight:i8
    plo = add tile, u
    st plo, lo_q
    hi_off = add u, 1024:i64
    phi = add tile, hi_off
    st phi, hi_q
    u2 = add u, w8
    jmp unpack(u2)
  block_mm:
    xb_off = mul b, 32:i64
    xb = add xq, xb_off
    mm dots, xb, tile, 1:i64, 64:i64, 32:i64:i8
    d_off = mul b, 4:i64
    pd = add dx, d_off
    d = ld pd:f32
    vd = splat d:vx
    sb_off = mul b, 128:i64
    sb = add sc, sb_off
    jmp accum(0:i64)
  accum(j:i64):
    j_more = lt j, 64:i64
    br j_more, accum_body, block_next
  accum_body:
    # Two vectors of outputs per step, from one full vector of f16 scales (a partial load
    # would cost a lane-by-lane copy on Cranelift). f16 to f32 is exact for finite values:
    # the magnitude bits shifted into an f32 exponent and mantissa, times 2^112 (the bias
    # difference; also right for subnormals), and the sign of the sign-extended value.
    j_rest = sub 64:i64, j
    sj_off = mul j, 2:i64
    ps = add sb, sj_off
    s16 = ldm ps:vx, j_rest:i16
    j_off = mul j, 4:i64
    pp = add dots, j_off
    py = add yc, j_off
    p = ldm pp:vx, j_rest:i32
    pf = vitof p:f32
    s32 = vwidenlo s16:i32
    s_mag = vand s32, v_mag_mask:i32
    s_exp = vshl s_mag, 13:i32
    s_abs = vmul s_exp, v_two_112:f32
    s_sgn = vand s32, v_sign_bit:i32
    s = vor s_abs, s_sgn:i32
    ds = vmul s, vd:f32
    acc = ldm py:vx, j_rest:f32
    acc2 = vfma pf, ds, acc:f32
    stm py, acc2, j_rest:f32
    jh = add j, w
    jh_rest = sub 64:i64, jh
    jh_off = mul jh, 4:i64
    pph = add dots, jh_off
    pyh = add yc, jh_off
    ph = ldm pph:vx, jh_rest:i32
    pfh = vitof ph:f32
    s32h = vwidenhi s16:i32
    s_magh = vand s32h, v_mag_mask:i32
    s_exph = vshl s_magh, 13:i32
    s_absh = vmul s_exph, v_two_112:f32
    s_sgnh = vand s32h, v_sign_bit:i32
    sh = vor s_absh, s_sgnh:i32
    dsh = vmul sh, vd:f32
    acch = ldm pyh:vx, jh_rest:f32
    acc2h = vfma pfh, dsh, acch:f32
    stm pyh, acc2h, jh_rest:f32
    j2 = add jh, w
    jmp accum(j2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    free tile
    free dots
    ret
