# Residual add fused with RMSNorm, as between transformer sublayers (vLLM's
# fused_add_rms_norm): one pass updates the residual stream and sums its squares, a second
# writes the normalized output.
#   res_i += x_i;   out_i = res_i / sqrt(mean(res^2) + eps) * w_i
# Returns the scale 1 / sqrt(mean(res^2) + eps).
fn add_rmsnorm(x:ptr, res:ptr, w:ptr, out:ptr, n:i64, eps:f32)->f32
  b0:
    z = cst 0.0:f32
    zero = splat z:vx
    lanes = vl f32
    jmp sum(0:i64, zero)
  sum(i:i64, acc:vx):
    more = lt i, n
    br more, sum_body, scale
  sum_body:
    rest = sub n, i
    off = mul i, 4:i64
    px = add x, off
    pr = add res, off
    xv = ldm px:vx, rest:f32
    rv = ldm pr:vx, rest:f32
    r2 = vadd rv, xv:f32
    stm pr, r2, rest:f32
    acc2 = vfma r2, r2, acc:f32
    i2 = add i, lanes
    jmp sum(i2, acc2)
  scale:
    ss = vsum acc:f32
    nf = itof n:f32
    mean = div ss, nf
    mean_eps = add mean, eps
    rms = sqrt mean_eps
    inv = div 1.0:f32, rms
    vinv = splat inv:vx
    jmp norm(0:i64)
  norm(j:i64):
    more_j = lt j, n
    br more_j, norm_body, done
  norm_body:
    rest_j = sub n, j
    off_j = mul j, 4:i64
    pr_j = add res, off_j
    pw_j = add w, off_j
    po_j = add out, off_j
    rv_j = ldm pr_j:vx, rest_j:f32
    wv = ldm pw_j:vx, rest_j:f32
    xs = vmul rv_j, vinv:f32
    y = vmul xs, wv:f32
    stm po_j, y, rest_j:f32
    j2 = add j, lanes
    jmp norm(j2)
  done:
    ret inv
