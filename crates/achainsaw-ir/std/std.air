    call qmat_st8(py_a4, f0a4, f1a4, f2a4, f3a4, f4a4, f5a4, f6a4, f7a4)
    ja42 = add ja4, w
    jmp a4(ja42)
  done:
    free tab
    ret

# Chunk c of `mat` (see qmat_chunk): its weights, its scales, the number of 32-blocks of a
# row, the bytes per block of weights and of scales (of codes for Q4_K and Q5_K), the format,
# and the bias of its unsigned weights (128 for Q8_0, 8 for Q4_0, 32 for Q6_K; 1 for Q4_K,
# Q5_K and Q4_1, whose weights have no offset, so that qmat_block's corrections are the
# activation sums their mins multiply).
inline fn qmat_layout(c:i64, mat:ptr, k:i64)->(ptr, ptr, i64, i64, i64, i64, i32)
  b0:
    jmp find(mat, c)
  find(part:ptr, pc:i64):
    part_chunks = ld part[3]:i64
    past = uge pc, part_chunks
    br past, next_part, found
  next_part:
    pc2 = sub pc, part_chunks
    part2 = add part, 32:i64
    jmp find(part2, pc2)
  found:
    wq = ld part:ptr
    scales = ld part[1]:ptr
    fmt = ld part[2]:i64
    is_q6 = eq fmt, 2:i64
    has_min = uge fmt, 3:i64
    is_q41 = eq fmt, 5:i64
    below_q41 = ult fmt, 5:i64
    is_k = and has_min, below_q41
    is_q5 = eq fmt, 4:i64
    nibbles = and fmt, 1:i64
    is_n = eq nibbles, 1:i64
    nb = udiv k, 32:i64
    # Q4_0, Q4_K and Q4_1 (odd formats) 1024 bytes, Q8_0 2048, Q6_K 1536, Q5_K 1280.
    blk_a = select is_n, 1024:i64, 2048:i64
    blk_b = select is_q6, 1536:i64, blk_a
    blk = select is_q5, 1280:i64, blk_b
    # Scales per block: 128 bytes, 256 for Q6_K and Q4_1; Q4_K and Q5_K add 256 per 8
    # blocks (or fewer, at the end of a row).
    two_sc = or is_q6, is_q41
    sc_blk = select two_sc, 256:i64, 128:i64
    nb7 = add nb, 7:i64
    nsup = ushr nb7, 3:i64
    sup_b = shl nsup, 8:i64
    sup = select is_k, sup_b, 0:i64
    chunk_w = mul nb, blk
    w_off = mul pc, chunk_w
    wc = add wq, w_off
    chunk_b = mul nb, sc_blk
    chunk_s = add chunk_b, sup
    s_off = mul pc, chunk_s
    sc = add scales, s_off
    bias_a = select is_n, 8:i32, 128:i32
    bias_b = select is_q6, 32:i32, bias_a
    bias = select has_min, 1:i32, bias_b
    ret wc, sc, nb, blk, sc_blk, fmt, bias

# Q8_0 weights of groups g and g + 4 for the strip of rows at wb, unsigned (value + 128).
inline fn qmat_w8(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    wl = ld wb[o:i8]:vx
    oh = add o, 1024:i64
    wh = ld wb[oh:i8]:vx
    ret wl, wh

# Q4_0 weights of groups g and g + 4, unsigned (value + 8): the low and high nibbles of one
# byte vector.
inline fn qmat_w4(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    wl = vand nv, mask:i8
    wh = vushr nv, 4:i8
    ret wl, wh

# Q6_K weights of groups g and g + 4, unsigned (value + 32): Q4_0's nibbles with their high
# 2 bits from the second plane (group g % 2, bit pairs g / 2 and g / 2 + 2), each pair moved
# to bits 4..5 with one shift and a mask.
inline fn qmat_w6(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    top2 = splat 48:i8:vx
    l4 = vand nv, mask:i8
    h4 = vushr nv, 4:i8
    gp = and g, 1:i64
    po = shl gp, 8:i64
    ho = add po, 1024:i64
    hp = ld wb[ho:i8]:vx
    pair = ushr g, 1:i64
    sh = shl pair, 1:i64
    up = sub 4:i64, sh
    bl0 = vshl hp, up:i8
    bl = vand bl0, top2:i8
    wl = vor l4, bl:i8
    bh0 = vushr hp, sh:i8
    bh = vand bh0, top2:i8
    wh = vor h4, bh:i8
    ret wl, wh

# Q5_K weights of groups g and g + 4, values 0..31: Q4_0's nibbles with their top bits from
# the second plane (bits g and 4 + g, each moved to bit 4 with one shift and a mask).
inline fn qmat_w5(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    sixteen = splat 16:i8:vx
    l4 = vand nv, mask:i8
    h4 = vushr nv, 4:i8
    hp = ld wb[1024:i8]:vx
    up = sub 4:i64, g
    bl0 = vshl hp, up:i8
    bl = vand bl0, sixteen:i8
    wl = vor l4, bl:i8
    bh0 = vushr hp, g:i8
    bh = vand bh0, sixteen:i8
    wh = vor h4, bh:i8
    ret wl, wh

# One token's dots for groups g and g + 4: dl += wl . x[4g .. 4g + 4] and dh += wh .
# x[16 + 4g .. 20 + 4g] in every 32-bit lane, x being the token's 32-value block at xb and
# the weights unsigned (one vpdpbusd or usdot each); qmat_acc removes their bias.
inline fn qmat_dot(xb:ptr, g:i64, wl:vx, wh:vx, dl:vx, dh:vx)->(vx, vx)
  b0:
    xl = ld xb[g]:i32
    gh = add g, 4:i64
    xh = ld xb[gh]:i32
    vxl = splat xl:vx
    vxh = splat xh:vx
    dl2 = vdotu dl, wl, vxl:i8
    dh2 = vdotu dh, wh, vxh:i8
    ret dl2, dh2

# qmat_dot for 4 tokens with the same weights.
inline fn qmat_dot4(xb0:ptr, xb1:ptr, xb2:ptr, xb3:ptr, g:i64, wl:vx, wh:vx, a0l:vx, a0h:vx, a1l:vx, a1h:vx, a2l:vx, a2h:vx, a3l:vx, a3h:vx)->(vx, vx, vx, vx, vx, vx, vx, vx)
  b0:
    b0l, b0h = call qmat_dot(xb0, g, wl, wh, a0l, a0h)
    b1l, b1h = call qmat_dot(xb1, g, wl, wh, a1l, a1h)
    b2l, b2h = call qmat_dot(xb2, g, wl, wh, a2l, a2h)
    b3l, b3h = call qmat_dot(xb3, g, wl, wh, a3l, a3h)
    ret b0l, b0h, b1l, b1h, b2l, b2h, b3l, b3h

# a + w . x[4gi .. 4gi + 4] in every 32-bit lane, x being a token's 32-value block at xb and
# w unsigned weights (one vpdpbusd or usdot): qmat_chunk8's step, one chain per token;
# qmat_accr removes their bias.
inline fn qmat_dot1(xb:ptr, gi:i64, w:vx, a:vx)->vx
  b0:
    xv = ld xb[gi]:i32
    vxv = splat xv:vx
    r = vdotu a, w, vxv:i8
    ret r

# qmat_dot1 for the 8 tokens of a qmat_chunk8 row at xr (their blocks 32 bytes apart).
inline fn qmat_dot8(xr:ptr, g:i64, w:vx, a0:vx, a1:vx, a2:vx, a3:vx, a4:vx, a5:vx, a6:vx, a7:vx)->(vx, vx, vx, vx, vx, vx, vx, vx)
  b0:
    r0 = call qmat_dot1(xr, g, w, a0)
    x1 = add xr, 32:i64
    r1 = call qmat_dot1(x1, g, w, a1)
    x2 = add xr, 64:i64
    r2 = call qmat_dot1(x2, g, w, a2)
    x3 = add xr, 96:i64
    r3 = call qmat_dot1(x3, g, w, a3)
    x4 = add xr, 128:i64
    r4 = call qmat_dot1(x4, g, w, a4)
    x5 = add xr, 160:i64
    r5 = call qmat_dot1(x5, g, w, a5)
    x6 = add xr, 192:i64
    r6 = call qmat_dot1(x6, g, w, a6)
    x7 = add xr, 224:i64
    r7 = call qmat_dot1(x7, g, w, a7)
    ret r0, r1, r2, r3, r4, r5, r6, r7

# The strip of rows j .. of a block (weights at wb0, scales at sb): its weights, its scale
# group 0 widened to f32, and its outputs at dst + 4j.
inline fn qmat_strip(wb0:ptr, sb:ptr, dst:ptr, j:i64)->(ptr, vx, ptr)
  b0:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    rest = sub 64:i64, j
    s = call qmat_scale(sb, j, rest)
    py = add dst, j4
    ret wb, s, py

# Scale group 1 of the strip of rows j .. (Q6_K's values 16..31, Q4_1's mins).
inline fn qmat_scale1(sb:ptr, j:i64)->vx
  b0:
    jh = add j, 64:i64
    rest = sub 64:i64, j
    s1 = call qmat_scale(sb, jh, rest)
    ret s1

# The strip of rows j .. of a Q4_K or Q5_K block (weights at wb0, codes at sb, its
# super-block's factors at sd): its weights, scales and mins (each a 6-bit code times an f16
# factor, exact in f32) and its outputs at dst + 4j. One plain load reads the strip's codes:
# past row 63 it reads the next block's codes or the chunk's factors, which follow them.
inline fn qmat_kstrip(wb0:ptr, sb:ptr, sd:ptr, dst:ptr, j:i64)->(ptr, vx, vx, ptr)
  b0:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    cv = ld sb[j:i16]:vx
    c32 = vwidenlo cv:i32
    low = splat 255:i32:vx
    sc = vand c32, low:i32
    mn = vushr c32, 8:i32
    scf = vitof sc:f32
    mnf = vitof mn:f32
    rest = sub 64:i64, j
    fs = call qmat_scale(sd, j, rest)
    jh = add j, 64:i64
    fm = call qmat_scale(sd, jh, rest)
    s = vmul scf, fs:f32
    m = vmul mnf, fm:f32
    py = add dst, j4
    ret wb, s, m, py

# The f16 factors of block b's super-block in a Q4_K or Q5_K chunk whose scales are at sc
# (nb blocks of codes, then one entry per 8 blocks; see qmat_chunk).
inline fn qmat_ksup(sc:ptr, nb:i64, b:i64)->ptr
  b0:
    co = shl nb, 7:i64
    sup = ushr b, 3:i64
    so = shl sup, 8:i64
    o = add co, so
    sd = add sc, o
    ret sd

# One token's dots for a strip of Q8_0 weights at wb, groups 0..3 unrolled (see
# qmat_dot): the int32 sums of values 0..15 and of values 16..31.
inline fn qmat_dots8(wb:ptr, xb:ptr)->(vx, vx)
  b0:
    z = splat 0:i32:vx
    w0l, w0h = call qmat_w8(wb, 0:i64)
    a0l, a0h = call qmat_dot(xb, 0:i64, w0l, w0h, z, z)
    w1l, w1h = call qmat_w8(wb, 1:i64)
    a1l, a1h = call qmat_dot(xb, 1:i64, w1l, w1h, a0l, a0h)
    w2l, w2h = call qmat_w8(wb, 2:i64)
    a2l, a2h = call qmat_dot(xb, 2:i64, w2l, w2h, a1l, a1h)
    w3l, w3h = call qmat_w8(wb, 3:i64)
    a3l, a3h = call qmat_dot(xb, 3:i64, w3l, w3h, a2l, a2h)
    ret a3l, a3h

