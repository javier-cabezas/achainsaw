    bq42 = add bq4, 1:i64
    jmp q4_blocks(bq42, g0q4, g1q4, g2q4, g3q4, g4q4, g5q4, g6q4, g7q4)
  q4_end:
    out_q4 = shl jq4, 2:i64
    py_q4 = add dst, out_q4
    call qmat_st8(py_q4, f0q4, f1q4, f2q4, f3q4, f4q4, f5q4, f6q4, f7q4)
    jq42 = add jq4, w
    jmp q4(jq42)
  q6(jq6:i64):
    more_q6 = lt jq6, 64:i64
    br more_q6, q6_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  q6_blocks(bq6:i64, f0q6:vx, f1q6:vx, f2q6:vx, f3q6:vx, f4q6:vx, f5q6:vx, f6q6:vx, f7q6:vx):
    bmore_q6 = lt bq6, nb
    br bmore_q6, q6_next, q6_end
  q6_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_q6 = eq jq6, 0:i64
    br first_q6, q6_prep, q6_body
  q6_prep:
    call qmat_prep8(tab, bq6, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
    jmp q6_body
  q6_body:
    wbb_q6, sb_q6, xr_q6, e_q6 = call qmat_tile8(wb0, sc, tab, bq6, blk, sc_blk)
    wb_q6, s_q6, unused_q6 = call qmat_strip(wbb_q6, sb_q6, dst, jq6)
    r0q6, r1q6, r2q6, r3q6, r4q6, r5q6, r6q6, r7q6 = call qmat_dots6lox8(wb_q6, xr_q6)
    u0q6, u1q6, u2q6, u3q6, u4q6, u5q6, u6q6, u7q6 = call qmat_acc8(e_q6, 0:i32, s_q6, f0q6, f1q6, f2q6, f3q6, f4q6, f5q6, f6q6, f7q6, r0q6, r1q6, r2q6, r3q6, r4q6, r5q6, r6q6, r7q6)
    h0q6, h1q6, h2q6, h3q6, h4q6, h5q6, h6q6, h7q6 = call qmat_dots6hix8(wb_q6, xr_q6)
    s1_q6 = call qmat_scale1(sb_q6, jq6)
    g0q6, g1q6, g2q6, g3q6, g4q6, g5q6, g6q6, g7q6 = call qmat_acc8(e_q6, 1:i32, s1_q6, u0q6, u1q6, u2q6, u3q6, u4q6, u5q6, u6q6, u7q6, h0q6, h1q6, h2q6, h3q6, h4q6, h5q6, h6q6, h7q6)
    bq62 = add bq6, 1:i64
    jmp q6_blocks(bq62, g0q6, g1q6, g2q6, g3q6, g4q6, g5q6, g6q6, g7q6)
  q6_end:
    out_q6 = shl jq6, 2:i64
    py_q6 = add dst, out_q6
    call qmat_st8(py_q6, f0q6, f1q6, f2q6, f3q6, f4q6, f5q6, f6q6, f7q6)
    jq62 = add jq6, w
    jmp q6(jq62)
  k4(jk4:i64):
    more_k4 = lt jk4, 64:i64
    br more_k4, k4_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  k4_blocks(bk4:i64, f0k4:vx, f1k4:vx, f2k4:vx, f3k4:vx, f4k4:vx, f5k4:vx, f6k4:vx, f7k4:vx):
    bmore_k4 = lt bk4, nb
    br bmore_k4, k4_next, k4_end
  k4_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_k4 = eq jk4, 0:i64
    br first_k4, k4_prep, k4_body
  k4_prep:
    call qmat_prep8(tab, bk4, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
    jmp k4_body
  k4_body:
    wbb_k4, sb_k4, xr_k4, e_k4 = call qmat_tile8(wb0, sc, tab, bk4, blk, sc_blk)
    sd_k4 = call qmat_ksup(sc, nb, bk4)
    wb_k4, s_k4, s1_k4, unused_k4 = call qmat_kstrip(wbb_k4, sb_k4, sd_k4, dst, jk4)
    r0k4, r1k4, r2k4, r3k4, r4k4, r5k4, r6k4, r7k4 = call qmat_dots4x8(wb_k4, xr_k4)
    g0k4, g1k4, g2k4, g3k4, g4k4, g5k4, g6k4, g7k4 = call qmat_accm8(e_k4, s_k4, s1_k4, f0k4, f1k4, f2k4, f3k4, f4k4, f5k4, f6k4, f7k4, r0k4, r1k4, r2k4, r3k4, r4k4, r5k4, r6k4, r7k4)
    bk42 = add bk4, 1:i64
    jmp k4_blocks(bk42, g0k4, g1k4, g2k4, g3k4, g4k4, g5k4, g6k4, g7k4)
  k4_end:
    out_k4 = shl jk4, 2:i64
    py_k4 = add dst, out_k4
    call qmat_st8(py_k4, f0k4, f1k4, f2k4, f3k4, f4k4, f5k4, f6k4, f7k4)
    jk42 = add jk4, w
    jmp k4(jk42)
  k5(jk5:i64):
    more_k5 = lt jk5, 64:i64
    br more_k5, k5_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  k5_blocks(bk5:i64, f0k5:vx, f1k5:vx, f2k5:vx, f3k5:vx, f4k5:vx, f5k5:vx, f6k5:vx, f7k5:vx):
    bmore_k5 = lt bk5, nb
    br bmore_k5, k5_next, k5_end
  k5_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_k5 = eq jk5, 0:i64
    br first_k5, k5_prep, k5_body
  k5_prep:
    call qmat_prep8(tab, bk5, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
    jmp k5_body
  k5_body:
    wbb_k5, sb_k5, xr_k5, e_k5 = call qmat_tile8(wb0, sc, tab, bk5, blk, sc_blk)
    sd_k5 = call qmat_ksup(sc, nb, bk5)
    wb_k5, s_k5, s1_k5, unused_k5 = call qmat_kstrip(wbb_k5, sb_k5, sd_k5, dst, jk5)
    r0k5, r1k5, r2k5, r3k5, r4k5, r5k5, r6k5, r7k5 = call qmat_dots5x8(wb_k5, xr_k5)
    g0k5, g1k5, g2k5, g3k5, g4k5, g5k5, g6k5, g7k5 = call qmat_accm8(e_k5, s_k5, s1_k5, f0k5, f1k5, f2k5, f3k5, f4k5, f5k5, f6k5, f7k5, r0k5, r1k5, r2k5, r3k5, r4k5, r5k5, r6k5, r7k5)
    bk52 = add bk5, 1:i64
    jmp k5_blocks(bk52, g0k5, g1k5, g2k5, g3k5, g4k5, g5k5, g6k5, g7k5)
  k5_end:
    out_k5 = shl jk5, 2:i64
    py_k5 = add dst, out_k5
    call qmat_st8(py_k5, f0k5, f1k5, f2k5, f3k5, f4k5, f5k5, f6k5, f7k5)
    jk52 = add jk5, w
    jmp k5(jk52)
  a4(ja4:i64):
    more_a4 = lt ja4, 64:i64
    br more_a4, a4_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  a4_blocks(ba4:i64, f0a4:vx, f1a4:vx, f2a4:vx, f3a4:vx, f4a4:vx, f5a4:vx, f6a4:vx, f7a4:vx):
    bmore_a4 = lt ba4, nb
    br bmore_a4, a4_next, a4_end
  a4_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_a4 = eq ja4, 0:i64
    br first_a4, a4_prep, a4_body
  a4_prep:
    call qmat_prep8(tab, ba4, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
    jmp a4_body
  a4_body:
    wbb_a4, sb_a4, xr_a4, e_a4 = call qmat_tile8(wb0, sc, tab, ba4, blk, sc_blk)
    wb_a4, s_a4, unused_a4 = call qmat_strip(wbb_a4, sb_a4, dst, ja4)
    s1_a4 = call qmat_scale1(sb_a4, ja4)
