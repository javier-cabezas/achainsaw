# AIR standard library: building blocks that modules import with a top-level `use` line,
#   use quantize_q8, qmat_chunk
# which links these functions (and the library functions they call) into the module.
# Every function here is validated and tested; see crates/achainsaw-ir/src/stdlib.rs.

# dst[0 .. 64] = rows 64c .. 64c + 64 of the quantized matrix `mat` times the int8
# activations xq (block records dx, from quantize_q8); k is the matrix's row length.
# `mat` is a list of parts of 4 words each: packed weights, f16 scales, format (0 Q8_0,
# 1 Q4_0, 2 Q6_K, 3 Q4_K, 4 Q5_K) and the part's number of 64-row chunks; chunk c is in the
# first part whose chunks reach past it, so the parts of a fused matrix (Q, K and V) keep
# their own formats.
# Weights come in chunks of 64 rows, stored unsigned (value + bias); per 32-block of a chunk,
# each group of 4 consecutive values of a row fills one 32-bit lane, so one `vdotu` (x86
# vpdpbusd, Arm usdot) multiplies them by 4 activations:
#   Q8_0 (format 0): 2048 bytes: byte (g * 64 + j) * 4 + q is row j's value 4g + q (g < 8),
#                    plus 128 (the int8 value with its top bit flipped).
#   Q4_0 (format 1): 1024 bytes: byte (g * 64 + j) * 4 + q (g < 4) holds row j's values
#                    4g + q (low nibble) and 16 + 4g + q (high), offset by 8: GGUF's own
#                    nibble bytes, regrouped.
#   Q6_K (format 2): 1536 bytes: the low 4 bits of the values offset by 32, as Q4_0's
#                    nibbles, then 512 bytes whose byte (g * 64 + j) * 4 + q (g < 2) holds
#                    the high 2 bits of row j's value 8p + 4g + q in bit pair p (p < 4).
#   Q4_K (format 3): 1024 bytes: the values 0..15 as Q4_0's nibbles (no offset).
#   Q5_K (format 4): 1280 bytes: the low 4 bits of the values 0..31 as Q4_0's nibbles, then
#                    256 bytes whose byte j * 4 + q holds the top bits of row j's values
#                    4g + q in bit g and 16 + 4g + q in bit 4 + g (g < 4).
# Scales are f16 [64] vectors per block: one for Q8_0 and Q4_0, two for Q6_K (one per 16
# values), and for Q4_K and Q5_K a scale s and a min m, the weight being s * value - m.
# Blocks are the outer loop, so each block's bytes are read in one pass; for each strip of
# `vl i32` rows, two exact int32 dot chains (values 0..15 and 16..31, Q6_K's two scale
# groups) lose bias * sum(x) (the sums from quantize_q8's block records), then are converted
# and added as scale * d * dot into dst; Q4_K and Q5_K, which have no bias, instead subtract
# m * d * sum(x) after. The steps are the inline functions below, shared with qmat_chunk4,
# so both give the same bits per token.
fn qmat_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt, bias = call qmat_layout(c, mat, k)
    is_q4, is_q5, is_q6, two = call qmat_kind(fmt)
    w = vl i32
    zf = splat 0.0:f32:vx
    zi = splat 0:i32:vx
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb = add xq, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    d, c_lo, c_hi = call qmat_block(dx, b, bias)
    jmp strips(0:i64)
  strips(j:i64):
    j_more = lt j, 64:i64
    br j_more, strip_start, block_next
  strip_start:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    br is_q4, q4(0:i64, zi, zi), not_q4
  not_q4:
    br is_q6, q6(0:i64, zi, zi), not_q6
  not_q6:
    br is_q5, q5(0:i64, zi, zi), q8(0:i64, zi, zi)
  q8(g8:i64, a8l:vx, a8h:vx):
    m8 = lt g8, 4:i64
    br m8, q8_body, scale(a8l, a8h)
  q8_body:
    w8l, w8h = call qmat_w8(wb, g8)
    d8l, d8h = call qmat_dot(xb, g8, w8l, w8h, a8l, a8h)
    g8n = add g8, 1:i64
    jmp q8(g8n, d8l, d8h)
  q4(g4:i64, a4l:vx, a4h:vx):
    m4 = lt g4, 4:i64
    br m4, q4_body, scale(a4l, a4h)
  q4_body:
    w4l, w4h = call qmat_w4(wb, g4)
    d4l, d4h = call qmat_dot(xb, g4, w4l, w4h, a4l, a4h)
    g4n = add g4, 1:i64
    jmp q4(g4n, d4l, d4h)
  q6(g6:i64, a6l:vx, a6h:vx):
    m6 = lt g6, 4:i64
    br m6, q6_body, scale(a6l, a6h)
  q6_body:
    w6l, w6h = call qmat_w6(wb, g6)
    d6l, d6h = call qmat_dot(xb, g6, w6l, w6h, a6l, a6h)
    g6n = add g6, 1:i64
    jmp q6(g6n, d6l, d6h)
  q5(g5:i64, a5l:vx, a5h:vx):
    m5 = lt g5, 4:i64
    br m5, q5_body, scale(a5l, a5h)
  q5_body:
    w5l, w5h = call qmat_w5(wb, g5)
    d5l, d5h = call qmat_dot(xb, g5, w5l, w5h, a5l, a5h)
    g5n = add g5, 1:i64
    jmp q5(g5n, d5l, d5h)
  scale(sl:vx, sh:vx):
    rest = sub 64:i64, j
    s = call qmat_scale(sb, j, rest)
    py = add dst, j4
    br two, scale2, scale4
  scale4:
    call qmat_acc1(py, sl, sh, s, d, c_lo, c_hi)
    j2 = add j, w
    jmp strips(j2)
  scale2:
    jh = add j, 64:i64
    s1 = call qmat_scale(sb, jh, rest)
    br is_q6, scale6, scalek
  scale6:
    call qmat_acc2(py, sl, sh, s, s1, d, c_lo, c_hi)
    j3 = add j, w
    jmp strips(j3)
  scalek:
    call qmat_accm(py, sl, sh, s, s1, d, c_lo, c_hi)
    j4k = add j, w
    jmp strips(j4k)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# qmat_chunk for 4 tokens at once: token t's int8 activations at xq + t * xs, its block
# records at dx + t * xs / 2, its 64 results at dst + 256 t. Each weight vector is loaded and
# unpacked once for the four tokens; every token goes through qmat_chunk's steps, so its
# results are exactly qmat_chunk's.
fn qmat_chunk4(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, xs:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt, bias = call qmat_layout(c, mat, k)
    is_q4, is_q5, is_q6, two = call qmat_kind(fmt)
    w = vl i32
    zf = splat 0.0:f32:vx
    zi = splat 0:i32:vx
    xq1 = add xq, xs
    xq2 = add xq1, xs
    xq3 = add xq2, xs
    ds = udiv xs, 2:i64
    dx1 = add dx, ds
    dx2 = add dx1, ds
    dx3 = add dx2, ds
    dst1 = add dst, 256:i64
    dst2 = add dst, 512:i64
    dst3 = add dst, 768:i64
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 256:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb0 = add xq, xo
    xb1 = add xq1, xo
    xb2 = add xq2, xo
    xb3 = add xq3, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    d0, l0, h0 = call qmat_block(dx, b, bias)
    d1, l1, h1 = call qmat_block(dx1, b, bias)
    d2, l2, h2 = call qmat_block(dx2, b, bias)
    d3, l3, h3 = call qmat_block(dx3, b, bias)
    jmp strips(0:i64)
  strips(j:i64):
    j_more = lt j, 64:i64
    br j_more, strip_start, block_next
  strip_start:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    br is_q4, q4(0:i64, zi, zi, zi, zi, zi, zi, zi, zi), not_q4
  not_q4:
    br is_q6, q6(0:i64, zi, zi, zi, zi, zi, zi, zi, zi), not_q6
  not_q6:
    br is_q5, q5(0:i64, zi, zi, zi, zi, zi, zi, zi, zi), q8(0:i64, zi, zi, zi, zi, zi, zi, zi, zi)
  q8(g8:i64, a0l:vx, a0h:vx, a1l:vx, a1h:vx, a2l:vx, a2h:vx, a3l:vx, a3h:vx):
    m8 = lt g8, 4:i64
    br m8, q8_body, scale(a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
  q8_body:
    w8l, w8h = call qmat_w8(wb, g8)
    e0l, e0h = call qmat_dot(xb0, g8, w8l, w8h, a0l, a0h)
    e1l, e1h = call qmat_dot(xb1, g8, w8l, w8h, a1l, a1h)
    e2l, e2h = call qmat_dot(xb2, g8, w8l, w8h, a2l, a2h)
    e3l, e3h = call qmat_dot(xb3, g8, w8l, w8h, a3l, a3h)
    g8n = add g8, 1:i64
    jmp q8(g8n, e0l, e0h, e1l, e1h, e2l, e2h, e3l, e3h)
  q4(g4:i64, b0l:vx, b0h:vx, b1l:vx, b1h:vx, b2l:vx, b2h:vx, b3l:vx, b3h:vx):
    m4 = lt g4, 4:i64
    br m4, q4_body, scale(b0l, b0h, b1l, b1h, b2l, b2h, b3l, b3h)
  q4_body:
    w4l, w4h = call qmat_w4(wb, g4)
    f0l, f0h = call qmat_dot(xb0, g4, w4l, w4h, b0l, b0h)
    f1l, f1h = call qmat_dot(xb1, g4, w4l, w4h, b1l, b1h)
    f2l, f2h = call qmat_dot(xb2, g4, w4l, w4h, b2l, b2h)
    f3l, f3h = call qmat_dot(xb3, g4, w4l, w4h, b3l, b3h)
    g4n = add g4, 1:i64
    jmp q4(g4n, f0l, f0h, f1l, f1h, f2l, f2h, f3l, f3h)
  q6(g6:i64, c0l:vx, c0h:vx, c1l:vx, c1h:vx, c2l:vx, c2h:vx, c3l:vx, c3h:vx):
    m6 = lt g6, 4:i64
    br m6, q6_body, scale(c0l, c0h, c1l, c1h, c2l, c2h, c3l, c3h)
  q6_body:
    w6l, w6h = call qmat_w6(wb, g6)
    h0l, h0h = call qmat_dot(xb0, g6, w6l, w6h, c0l, c0h)
    h1l, h1h = call qmat_dot(xb1, g6, w6l, w6h, c1l, c1h)
    h2l, h2h = call qmat_dot(xb2, g6, w6l, w6h, c2l, c2h)
    h3l, h3h = call qmat_dot(xb3, g6, w6l, w6h, c3l, c3h)
    g6n = add g6, 1:i64
    jmp q6(g6n, h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h)
  q5(g5:i64, e0l_:vx, e0h_:vx, e1l_:vx, e1h_:vx, e2l_:vx, e2h_:vx, e3l_:vx, e3h_:vx):
    m5 = lt g5, 4:i64
    br m5, q5_body, scale(e0l_, e0h_, e1l_, e1h_, e2l_, e2h_, e3l_, e3h_)
  q5_body:
    w5l, w5h = call qmat_w5(wb, g5)
    k0l, k0h = call qmat_dot(xb0, g5, w5l, w5h, e0l_, e0h_)
    k1l, k1h = call qmat_dot(xb1, g5, w5l, w5h, e1l_, e1h_)
    k2l, k2h = call qmat_dot(xb2, g5, w5l, w5h, e2l_, e2h_)
    k3l, k3h = call qmat_dot(xb3, g5, w5l, w5h, e3l_, e3h_)
    g5n = add g5, 1:i64
    jmp q5(g5n, k0l, k0h, k1l, k1h, k2l, k2h, k3l, k3h)
  scale(s0l:vx, s0h:vx, s1l:vx, s1h:vx, s2l:vx, s2h:vx, s3l:vx, s3h:vx):
    rest = sub 64:i64, j
    s = call qmat_scale(sb, j, rest)
    py0 = add dst, j4
    py1 = add dst1, j4
    py2 = add dst2, j4
    py3 = add dst3, j4
    br two, scale2, scale4
  scale4:
    call qmat_acc1(py0, s0l, s0h, s, d0, l0, h0)
    call qmat_acc1(py1, s1l, s1h, s, d1, l1, h1)
    call qmat_acc1(py2, s2l, s2h, s, d2, l2, h2)
    call qmat_acc1(py3, s3l, s3h, s, d3, l3, h3)
    j2 = add j, w
    jmp strips(j2)
  scale2:
    jh = add j, 64:i64
    s1 = call qmat_scale(sb, jh, rest)
    br is_q6, scale6, scalek
  scale6:
    call qmat_acc2(py0, s0l, s0h, s, s1, d0, l0, h0)
    call qmat_acc2(py1, s1l, s1h, s, s1, d1, l1, h1)
    call qmat_acc2(py2, s2l, s2h, s, s1, d2, l2, h2)
    call qmat_acc2(py3, s3l, s3h, s, s1, d3, l3, h3)
    j3 = add j, w
    jmp strips(j3)
  scalek:
    call qmat_accm(py0, s0l, s0h, s, s1, d0, l0, h0)
    call qmat_accm(py1, s1l, s1h, s, s1, d1, l1, h1)
    call qmat_accm(py2, s2l, s2h, s, s1, d2, l2, h2)
    call qmat_accm(py3, s3l, s3h, s, s1, d3, l3, h3)
    j4k = add j, w
    jmp strips(j4k)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# Chunk c of `mat` (see qmat_chunk): its weights, its scales, the number of 32-blocks of a
# row, the bytes per block of weights and of scales, the format, and the bias of its unsigned
# weights (128 for Q8_0, 8 for Q4_0, 32 for Q6_K; 1 for Q4_K and Q5_K, whose weights have no
# offset, so that qmat_block's corrections are the activation sums their mins multiply).
inline fn qmat_layout(c:i64, mat:ptr, k:i64)->(ptr, ptr, i64, i64, i64, i64, i32)
  b0:
    jmp find(mat, c)
  find(part:ptr, pc:i64):
    part_chunks = ld part[3]:i64
    past = uge pc, part_chunks
    br past, next_part, found
  next_part:
    pc2 = sub pc, part_chunks
    part2 = add part, 32:i64
    jmp find(part2, pc2)
  found:
    wq = ld part:ptr
    scales = ld part[1]:ptr
    fmt = ld part[2]:i64
    is_q6 = eq fmt, 2:i64
    is_k = uge fmt, 3:i64
    is_q5 = eq fmt, 4:i64
    nibbles = and fmt, 1:i64
    is_n = eq nibbles, 1:i64
    nb = udiv k, 32:i64
    # Q4_0 and Q4_K (odd formats) 1024 bytes, Q8_0 2048, Q6_K 1536, Q5_K 1280.
    blk_a = select is_n, 1024:i64, 2048:i64
    blk_b = select is_q6, 1536:i64, blk_a
    blk = select is_q5, 1280:i64, blk_b
    two = or is_q6, is_k
    nsub = select two, 2:i64, 1:i64
    sc_blk = shl nsub, 7:i64
    chunk_w = mul nb, blk
    w_off = mul pc, chunk_w
    wc = add wq, w_off
    chunk_s = mul nb, sc_blk
    s_off = mul pc, chunk_s
    sc = add scales, s_off
    bias_a = select is_n, 8:i32, 128:i32
    bias_b = select is_q6, 32:i32, bias_a
    bias = select is_k, 1:i32, bias_b
    ret wc, sc, nb, blk, sc_blk, fmt, bias

# A format's kind (see qmat_chunk): whether its weights unpack as nibbles (Q4_0, Q4_K), as
# Q5_K or as Q6_K, and whether it has two scale vectors per block (Q6_K, Q4_K, Q5_K).
inline fn qmat_kind(fmt:i64)->(i32, i32, i32, i32)
  b0:
    is_q4a = eq fmt, 1:i64
    is_q4k = eq fmt, 3:i64
    is_q4 = or is_q4a, is_q4k
    is_q5 = eq fmt, 4:i64
    is_q6 = eq fmt, 2:i64
    is_k = uge fmt, 3:i64
    two = or is_q6, is_k
    ret is_q4, is_q5, is_q6, two

# Q8_0 weights of groups g and g + 4 for the strip of rows at wb, unsigned (value + 128).
inline fn qmat_w8(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    wl = ld wb[o:i8]:vx
    oh = add o, 1024:i64
    wh = ld wb[oh:i8]:vx
    ret wl, wh

# Q4_0 weights of groups g and g + 4, unsigned (value + 8): the low and high nibbles of one
# byte vector.
inline fn qmat_w4(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    wl = vand nv, mask:i8
    wh = vushr nv, 4:i8
    ret wl, wh

# Q6_K weights of groups g and g + 4, unsigned (value + 32): Q4_0's nibbles with their high
# 2 bits from the second plane (group g % 2, bit pairs g / 2 and g / 2 + 2), each pair moved
# to bits 4..5 with one shift. The shifts run on 16-bit lanes (x86 has no 8-bit ones), which
# is exact here: bits 4..5 of each byte come from bits of the same byte.
inline fn qmat_w6(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    top2 = splat 48:i8:vx
    l4 = vand nv, mask:i8
    h4 = vushr nv, 4:i8
    gp = and g, 1:i64
    po = shl gp, 8:i64
    ho = add po, 1024:i64
    hp = ld wb[ho:i8]:vx
    pair = ushr g, 1:i64
    sh = shl pair, 1:i64
    up = sub 4:i64, sh
    bl0 = vshl hp, up:i16
    bl = vand bl0, top2:i8
    wl = vor l4, bl:i8
    bh0 = vushr hp, sh:i16
    bh = vand bh0, top2:i8
    wh = vor h4, bh:i8
    ret wl, wh

# Q5_K weights of groups g and g + 4, values 0..31: Q4_0's nibbles with their top bits from
# the second plane (bits g and 4 + g, moved to bit 4 by 16-bit lane shifts, as in qmat_w6).
inline fn qmat_w5(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    sixteen = splat 16:i8:vx
    l4 = vand nv, mask:i8
    h4 = vushr nv, 4:i8
    hp = ld wb[1024:i8]:vx
    up = sub 4:i64, g
    bl0 = vshl hp, up:i16
    bl = vand bl0, sixteen:i8
    wl = vor l4, bl:i8
    bh0 = vushr hp, g:i16
    bh = vand bh0, sixteen:i8
    wh = vor h4, bh:i8
    ret wl, wh

# One token's dots for groups g and g + 4: dl += wl . x[4g .. 4g + 4] and dh += wh .
# x[16 + 4g .. 20 + 4g] in every 32-bit lane, x being the token's 32-value block at xb and
# the weights unsigned (one vpdpbusd or usdot each); qmat_acc removes their bias.
inline fn qmat_dot(xb:ptr, g:i64, wl:vx, wh:vx, dl:vx, dh:vx)->(vx, vx)
  b0:
    xl = ld xb[g]:i32
    gh = add g, 4:i64
    xh = ld xb[gh]:i32
    vxl = splat xl:vx
    vxh = splat xh:vx
    dl2 = vdotu dl, wl, vxl:i8
    dh2 = vdotu dh, wh, vxh:i8
    ret dl2, dh2

# f16 scales sb[i ..] of a strip's rows (at most n of them), widened to f32: scale group
# 0 of rows j .. at sb[j], Q6_K's group 1 (the mins of Q4_K and Q5_K) at sb[j + 64].
inline fn qmat_scale(sb:ptr, i:i64, n:i64)->vx
  b0:
    h = ldm sb[i]:vx, n:f16
    s = vfwidenlo h:f16
    ret s

# A token's f32 sums at py += s * d * (dl + dh - c_lo - c_hi): Q8_0 and Q4_0, one scale per
# block; c_lo and c_hi remove the weights' bias from the dots (see qmat_block).
inline fn qmat_acc1(py:ptr, dl:vx, dh:vx, s:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    vd = splat d:vx
    ds = vmul s, vd:f32
    c = add c_lo, c_hi
    vc = splat c:vx
    raw = vadd dl, dh:i32
    dsum = vsub raw, vc:i32
    pf = vitof dsum:f32
    acc2 = vfma pf, ds, acc:f32
    st py, acc2
    ret

# A token's f32 sums at py += s * d * (dl - c_lo), then += s1 * d * (dh - c_hi): Q6_K's two
# scale groups.
inline fn qmat_acc2(py:ptr, dl:vx, dh:vx, s:vx, s1:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    vd = splat d:vx
    ds = vmul s, vd:f32
    vcl = splat c_lo:vx
    vch = splat c_hi:vx
    dlc = vsub dl, vcl:i32
    dhc = vsub dh, vch:i32
    pfl = vitof dlc:f32
    accl = vfma pfl, ds, acc:f32
    ds1 = vmul s1, vd:f32
    pfh = vitof dhc:f32
    acch = vfma pfh, ds1, accl:f32
    st py, acch
    ret

# A token's f32 sums at py += s * d * (dl + dh), then -= m * d * (c_lo + c_hi): Q4_K and
# Q5_K, whose weights s * value - m have a scale s and a min m per block (qmat_layout's bias
# 1 makes c_lo + c_hi the activations' sum).
inline fn qmat_accm(py:ptr, dl:vx, dh:vx, s:vx, m:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    vd = splat d:vx
    ds = vmul s, vd:f32
    raw = vadd dl, dh:i32
    pf = vitof raw:f32
    acc1 = vfma pf, ds, acc:f32
    sum = add c_lo, c_hi
    sumf = itof sum:f32
    dsum = mul d, sumf
    ndsum = neg dsum
    vn = splat ndsum:vx
    acc2 = vfma m, vn, acc1:f32
    st py, acc2
    ret

# Block b's activation record (from quantize_q8) at dx: its scale, and the corrections for
# weights stored with `bias` added: bias times the sums of values 0..15 and 16..31.
inline fn qmat_block(dx:ptr, b:i64, bias:i32)->(f32, i32, i32)
  b0:
    ro = shl b, 4:i64
    rec = add dx, ro
    d = ld rec:f32
    s_lo = ld rec[1]:i32
    s_hi = ld rec[2]:i32
    c_lo = mul bias, s_lo
    c_hi = mul bias, s_hi
    ret d, c_lo, c_hi

# dst[64t .. 64t + 64] = rows 64c .. 64c + 64 of `mat` times token t's int8 activations,
# for n tokens xs bytes apart in xq (their block records xs / 2 bytes apart in dx): four at a time
# with qmat_chunk4, the rest with qmat_chunk, so every result is exactly qmat_chunk's.
fn qmat_batch(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, n:i64, xs:i64)
  b0:
    ds = udiv xs, 2:i64
    jmp tiles(0:i64)
  tiles(t:i64):
    t4 = add t, 4:i64
    full = le t4, n
    br full, tile_body, rest(t)
  tile_body:
    xo = mul t, xs
    pxq = add xq, xo
    dofs = mul t, ds
    pdx = add dx, dofs
    oo = mul t, 256:i64
    po = add dst, oo
    call qmat_chunk4(c, mat, pxq, pdx, po, k, xs)
    jmp tiles(t4)
  rest(r:i64):
    r_more = lt r, n
    br r_more, rest_body, done
  rest_body:
    rxo = mul r, xs
    rxq = add xq, rxo
    rdo = mul r, ds
    rdx = add dx, rdo
    roo = mul r, 256:i64
    ro = add dst, roo
    call qmat_chunk(c, mat, rxq, rdx, ro, k)
    r2 = add r, 1:i64
    jmp rest(r2)
  done:
    ret

# Q8_0 quantization of x[0 .. k] (k a multiple of 32), as llama.cpp's quantize_row_q8_0:
# scale d = max|x in block b| / 127 and xq[32b + t] = round(x[32b + t] / d), halves away
# from zero. At full vector width: |x| with vabs, vround, then vftoi and two saturating
# vnarrows down to i8. Each block's 16-byte record at dx + 16b holds d (f32), the sums of
# its quantized values 0..15 and 16..31 (i32, for dot products with unsigned weights), and
# a zero i32.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    v_zi = splat 0:i32:vx
    v_one8 = splat 1:i8:vx
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = shl b, 5:i64
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    rest = sub 32:i64, t
    i = add base, t
    v = ldm x[i]:vx, rest:f32
    av = vabs v:f32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    ro = shl b, 4:i64
    rec = add dx, ro
    st rec, d
    st rec[3], 0:i32
    v_id = splat id:vx
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    rest_q = sub 32:i64, s
    iq = add base, s
    xv = ldm x[iq]:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    rv = vround sv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    cnt = min rest_q, w
    stm xq[iq], q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  block_next:
    # The block's two half sums: 4-byte sums by `vdot` with ones, over 16 bytes each.
    lo = ldm xq[base]:vx, 16:i8
    sl = vdot v_zi, lo, v_one8:i8
    s_lo = vsum sl:i32
    hb = add base, 16:i64
    hi = ldm xq[hb]:vx, 16:i8
    sh = vdot v_zi, hi, v_one8:i8
    s_hi = vsum sh:i32
    st rec[1], s_lo
    st rec[2], s_hi
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# RoPE ("rotate-half" layout) for one head of hd f32 values, in place: x[j] and x[j + hd/2]
# rotate by the angle whose cos and sin are cos[j] and sin[j] (one row of a RoPE table).
fn rope_half(x:ptr, hd:i64, cos:ptr, sin:ptr)
  b0:
    w = vl f32
    half = udiv hd, 2:i64
    v_zero = splat 0.0:f32:vx
    jmp cols(0:i64)
  cols(j:i64):
    j_more = lt j, half
    br j_more, cols_body, done
  cols_body:
    rest = sub half, j
    jh = add j, half
    x1 = ldm x[j]:vx, rest:f32
    x2 = ldm x[jh]:vx, rest:f32
    c = ldm cos[j]:vx, rest:f32
    s = ldm sin[j]:vx, rest:f32
    x2s = vmul x2, s:f32
    minus_x2s = vsub v_zero, x2s:f32
    y1 = vfma x1, c, minus_x2s:f32
    x2c = vmul x2, c:f32
    y2 = vfma x1, s, x2c:f32
    stm x[j], y1, rest:f32
    stm x[jh], y2, rest:f32
    j2 = add j, w
    jmp cols(j2)
  done:
    ret

# p[i] = exp(p[i] - shift) for i < n (vexp), in place; returns the sum. With shift = max(p),
# the numerators of a numerically stable softmax.
fn exp_shift(p:ptr, n:i64, shift:f32)->f32
  b0:
    w = vl f32
    v_shift = splat shift:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, sum(0:i64, v_zero)
  body:
    rest = sub n, i
    v = ldm p[i]:vx, rest:f32
    x0 = vsub v, v_shift:f32
    e = vexp x0:f32
    stm p[i], e, rest:f32
    i2 = add i, w
    jmp loop(i2)
  # Masked loads zero the lanes past n, so they add nothing.
  sum(j:i64, acc:vx):
    j_more = lt j, n
    br j_more, sum_body, done
  sum_body:
    j_rest = sub n, j
    ev = ldm p[j]:vx, j_rest:f32
    acc2 = vadd acc, ev:f32
    j2 = add j, w
    jmp sum(j2, acc2)
  done:
    total = vsum acc:f32
    ret total

# out = silu(gate) * up = gate * up / (1 + exp(-gate)) for n f32 values: SwiGLU's gating.
fn silu_mul(gate:ptr, up:ptr, out:ptr, n:i64)
  b0:
    w = vl f32
    v_one = splat 1.0:f32:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    g = ldm gate[i]:vx, rest:f32
    u = ldm up[i]:vx, rest:f32
    ng = vsub v_zero, g:f32
    e = vexp ng:f32
    den = vadd e, v_one:f32
    gu = vmul g, u:f32
    y = vdiv gu, den:f32
    stm out[i], y, rest:f32
    i2 = add i, w
    jmp loop(i2)
  done:
    ret

# Attention of `group` query heads (f32 rows of hd at qg) over nt >= 1 positions of one KV
# head, whose K and V rows (hd bf16 values each) start at kb and vb: one split of
# flash-decoding. For head r it writes at pg + r * head_b the max m of its scores (dot
# products times `scale`), the sum of exp(score - m), and the hd outputs sum_t
# exp(score_t - m) V[t], unnormalized; attn_merge combines splits. Heads go 4 at a time with
# their dot products, then their outputs, in registers, so each K and V vector is widened
# from bf16 once for 4 heads (then one head at a time for the rest of the group).
fn attn_split(qg:ptr, kb:ptr, vb:ptr, pg:ptr, group:i64, hd:i64, nt:i64, scale:f32, head_b:i64)
  b0:
    w16 = vl bf16
    w32 = vl f32
    zero = splat 0.0:f32:vx
    low = cst -340282346638528859811704183484516925440.0:f32
    v_low = splat low:vx
    row2 = mul hd, 2:i64
    hd4 = mul hd, 4:i64
    # scores [group x nt]
    ntb = mul nt, 4:i64
    sc_bytes = mul group, ntb
    sc = alloc sc_bytes
    quads_end0 = udiv group, 4:i64
    quads_end = mul quads_end0, 4:i64
    jmp score(0:i64)

  # Scores of position t: 4 heads at a time, each K vector widened once for the 4.
  score(t:i64):
    t_more = lt t, nt
    br t_more, score_start, softmax(0:i64)
  score_start:
    k_off = mul t, row2
    kt = add kb, k_off
    jmp sq_heads(0:i64)
  sq_heads(r:i64):
    r_more = lt r, quads_end
    br r_more, sq_start, ss_heads(r)
  sq_start:
    qr_off = mul r, hd4
    q0 = add qg, qr_off
    q1 = add q0, hd4
    q2 = add q1, hd4
    q3 = add q2, hd4
    jmp sq_dot(0:i64, zero, zero, zero, zero)
  sq_dot(j:i64, a0:vx, a1:vx, a2:vx, a3:vx):
    j_more = lt j, hd
    br j_more, sq_dot_body, sq_store
  sq_dot_body:
    rest = sub hd, j
    kv = ldm kt[j]:vx, rest:bf16
    klo = vfwidenlo kv:bf16
    khi = vfwidenhi kv:bf16
    rest_hi0 = sub rest, w32
    rest_hi = max rest_hi0, 0:i64
    j_hi = add j, w32
    x0l = ldm q0[j]:vx, rest:f32
    x0h = ldm q0[j_hi]:vx, rest_hi:f32
    b0l = vfma klo, x0l, a0:f32
    b0h = vfma khi, x0h, b0l:f32
    x1l = ldm q1[j]:vx, rest:f32
    x1h = ldm q1[j_hi]:vx, rest_hi:f32
    b1l = vfma klo, x1l, a1:f32
    b1h = vfma khi, x1h, b1l:f32
    x2l = ldm q2[j]:vx, rest:f32
    x2h = ldm q2[j_hi]:vx, rest_hi:f32
    b2l = vfma klo, x2l, a2:f32
    b2h = vfma khi, x2h, b2l:f32
    x3l = ldm q3[j]:vx, rest:f32
    x3h = ldm q3[j_hi]:vx, rest_hi:f32
    b3l = vfma klo, x3l, a3:f32
    b3h = vfma khi, x3h, b3l:f32
    j2 = add j, w16
    jmp sq_dot(j2, b0h, b1h, b2h, b3h)
  sq_store:
    si0 = mul r, nt
    si = add si0, t
    e0 = vsum a0:f32
    f0 = mul e0, scale
    st sc[si], f0
    si1 = add si, nt
    e1 = vsum a1:f32
    f1 = mul e1, scale
    st sc[si1], f1
    si2 = add si1, nt
    e2 = vsum a2:f32
    f2 = mul e2, scale
    st sc[si2], f2
    si3 = add si2, nt
    e3 = vsum a3:f32
    f3 = mul e3, scale
    st sc[si3], f3
    r4 = add r, 4:i64
    jmp sq_heads(r4)
  # The rest of the group, one head at a time.
  ss_heads(u:i64):
    u_more = lt u, group
    br u_more, ss_start, score_next
  ss_start:
    qu_off = mul u, hd4
    qu = add qg, qu_off
    jmp ss_dot(0:i64, zero)
  ss_dot(sj:i64, acc:vx):
    sj_more = lt sj, hd
    br sj_more, ss_dot_body, ss_store
  ss_dot_body:
    srest = sub hd, sj
    skv = ldm kt[sj]:vx, srest:bf16
    sklo = vfwidenlo skv:bf16
    skhi = vfwidenhi skv:bf16
    srest_hi0 = sub srest, w32
    srest_hi = max srest_hi0, 0:i64
    sj_hi = add sj, w32
    sxl = ldm qu[sj]:vx, srest:f32
    sxh = ldm qu[sj_hi]:vx, srest_hi:f32
    acc1 = vfma sklo, sxl, acc:f32
    acc2 = vfma skhi, sxh, acc1:f32
    sj2 = add sj, w16
    jmp ss_dot(sj2, acc2)
  ss_store:
    su0 = mul u, nt
    su = add su0, t
    ev = vsum acc:f32
    fv = mul ev, scale
    st sc[su], fv
    u2 = add u, 1:i64
    jmp ss_heads(u2)
  score_next:
    t2 = add t, 1:i64
    jmp score(t2)

  # Per head: the split's max (whole vectors, then the rest one by one), then the
  # exponentials in place and their sum.
  softmax(h:i64):
    h_more = lt h, group
    br h_more, sm_head, pv(0:i64)
  sm_head:
    srow0 = mul h, ntb
    srow = add sc, srow0
    jmp sm_vmax(0:i64, v_low)
  sm_vmax(um:i64, mv:vx):
    u_end = add um, w32
    u_full = le u_end, nt
    br u_full, sm_vmax_body, sm_reduce
  sm_vmax_body:
    sv = ld srow[um:f32]:vx
    mv2 = vmax mv, sv:f32
    jmp sm_vmax(u_end, mv2)
  sm_reduce:
    mr = vmaxr mv:f32
    jmp sm_smax(um, mr)
  sm_smax(uu:i64, mx:f32):
    uu_more = lt uu, nt
    br uu_more, sm_smax_body, sm_exp
  sm_smax_body:
    s1 = ld srow[uu]:f32
    mx2 = max mx, s1
    uu2 = add uu, 1:i64
    jmp sm_smax(uu2, mx2)
  sm_exp:
    total = call exp_shift(srow, nt, mx)
    pr_off = mul h, head_b
    prow = add pg, pr_off
    st prow, mx
    st prow[1], total
    h2 = add h, 1:i64
    jmp softmax(h2)

  # o[r] = sum_t p[r][t] V[t], one vector of V's columns at a time (outer loop), so the 4
  # heads' sums for it stay in registers over all positions of the split.
  pv(c:i64):
    c_more = lt c, hd
    br c_more, pv_cols, done
  pv_cols:
    c_rest = sub hd, c
    c_rest_hi0 = sub c_rest, w32
    c_rest_hi = max c_rest_hi0, 0:i64
    c_hi = add c, w32
    jmp pq_heads(0:i64)
  pq_heads(pr:i64):
    pr_more = lt pr, quads_end
    br pr_more, pq_start, ps_heads(pr)
  pq_start:
    p0 = mul pr, ntb
    pp0 = add sc, p0
    pp1 = add pp0, ntb
    pp2 = add pp1, ntb
    pp3 = add pp2, ntb
    jmp pq_pos(0:i64, zero, zero, zero, zero, zero, zero, zero, zero)
  pq_pos(pt:i64, o0l:vx, o0h:vx, o1l:vx, o1h:vx, o2l:vx, o2h:vx, o3l:vx, o3h:vx):
    pt_more = lt pt, nt
    br pt_more, pq_pos_body, pq_store
  pq_pos_body:
    v_off = mul pt, row2
    vt = add vb, v_off
    vv = ldm vt[c]:vx, c_rest:bf16
    vlo = vfwidenlo vv:bf16
    vhi = vfwidenhi vv:bf16
    y0 = ld pp0[pt]:f32
    vy0 = splat y0:vx
    n0l = vfma vlo, vy0, o0l:f32
    n0h = vfma vhi, vy0, o0h:f32
    y1 = ld pp1[pt]:f32
    vy1 = splat y1:vx
    n1l = vfma vlo, vy1, o1l:f32
    n1h = vfma vhi, vy1, o1h:f32
    y2 = ld pp2[pt]:f32
    vy2 = splat y2:vx
    n2l = vfma vlo, vy2, o2l:f32
    n2h = vfma vhi, vy2, o2h:f32
    y3 = ld pp3[pt]:f32
    vy3 = splat y3:vx
    n3l = vfma vlo, vy3, o3l:f32
    n3h = vfma vhi, vy3, o3h:f32
    pt2 = add pt, 1:i64
    jmp pq_pos(pt2, n0l, n0h, n1l, n1h, n2l, n2h, n3l, n3h)
  pq_store:
    po_off = mul pr, head_b
    or0 = add pg, po_off
    od0 = add or0, 8:i64
    stm od0[c], o0l, c_rest:f32
    stm od0[c_hi], o0h, c_rest_hi:f32
    od1 = add od0, head_b
    stm od1[c], o1l, c_rest:f32
    stm od1[c_hi], o1h, c_rest_hi:f32
    od2 = add od1, head_b
    stm od2[c], o2l, c_rest:f32
    stm od2[c_hi], o2h, c_rest_hi:f32
    od3 = add od2, head_b
    stm od3[c], o3l, c_rest:f32
    stm od3[c_hi], o3h, c_rest_hi:f32
    pr4 = add pr, 4:i64
    jmp pq_heads(pr4)
  ps_heads(ph:i64):
    ph_more = lt ph, group
    br ph_more, ps_start, pv_next
  ps_start:
    ps0 = mul ph, ntb
    pps = add sc, ps0
    jmp ps_pos(0:i64, zero, zero)
  ps_pos(st_:i64, osl:vx, osh:vx):
    st_more = lt st_, nt
    br st_more, ps_pos_body, ps_store
  ps_pos_body:
    sv_off = mul st_, row2
    svt = add vb, sv_off
    svv = ldm svt[c]:vx, c_rest:bf16
    svlo = vfwidenlo svv:bf16
    svhi = vfwidenhi svv:bf16
    ys = ld pps[st_]:f32
    vys = splat ys:vx
    nsl = vfma svlo, vys, osl:f32
    nsh = vfma svhi, vys, osh:f32
    st2 = add st_, 1:i64
    jmp ps_pos(st2, nsl, nsh)
  ps_store:
    pso_off = mul ph, head_b
    psr = add pg, pso_off
    psd = add psr, 8:i64
    stm psd[c], osl, c_rest:f32
    stm psd[c_hi], osh, c_rest_hi:f32
    ph2 = add ph, 1:i64
    jmp ps_heads(ph2)
  pv_next:
    c2 = add c, w16
    jmp pv(c2)
  done:
    free sc
    ret

# Merges `splits` flash-decoding splits of one query head (attn_split's records: max, sum,
# hd outputs; rowb bytes apart from hp) into out[0 .. hd]: each split's outputs and sum are
# rescaled by exp(m_split - m) for the overall max m, added in split order, and the outputs
# divided by the total.
fn attn_merge(hp:ptr, splits:i64, rowb:i64, hd:i64, oh:ptr)
  b0:
    w = vl f32
    z = cst 0.0:f32
    zero = splat z:vx
    m0 = ld hp:f32
    jmp mmax(1:i64, m0)
  mmax(s:i64, mx:f32):
    s_more = lt s, splits
    br s_more, mmax_body, zero_out(0:i64)
  mmax_body:
    ps_off = mul s, rowb
    ps = add hp, ps_off
    ms = ld ps:f32
    mx2 = max mx, ms
    s2 = add s, 1:i64
    jmp mmax(s2, mx2)
  zero_out(zo:i64):
    zo_more = lt zo, hd
    br zo_more, zero_out_body, splits_loop(0:i64, z)
  zero_out_body:
    zo_rest = sub hd, zo
    stm oh[zo], zero, zo_rest:f32
    zo2 = add zo, w
    jmp zero_out(zo2)
  # out += exp(m_s - m) o_s, total += exp(m_s - m) l_s
  splits_loop(sp:i64, tot:f32):
    sp_more = lt sp, splits
    br sp_more, split_start, finish
  split_start:
    sp_off = mul sp, rowb
    sp_row = add hp, sp_off
    m_s = ld sp_row:f32
    l_s = ld sp_row[1]:f32
    dm = sub m_s, mx
    vdm = splat dm:vx
    ve = vexp vdm:f32
    e = extlane ve, 0:f32
    tot2 = fma l_s, e, tot
    o_s = add sp_row, 8:i64
    jmp acc_cols(0:i64)
  acc_cols(c:i64):
    c_more = lt c, hd
    br c_more, acc_body, split_next
  acc_body:
    c_rest = sub hd, c
    ov = ldm o_s[c]:vx, c_rest:f32
    cur = ldm oh[c]:vx, c_rest:f32
    nv = vfma ov, ve, cur:f32
    stm oh[c], nv, c_rest:f32
    c2 = add c, w
    jmp acc_cols(c2)
  split_next:
    sp2 = add sp, 1:i64
    jmp splits_loop(sp2, tot2)
  finish:
    inv = div 1.0:f32, tot
    vinv = splat inv:vx
    jmp scale_cols(0:i64)
  scale_cols(f:i64):
    f_more = lt f, hd
    br f_more, scale_body, done
  scale_body:
    f_rest = sub hd, f
    fv = ldm oh[f]:vx, f_rest:f32
    fv2 = vmul fv, vinv:f32
    stm oh[f], fv2, f_rest:f32
    f2 = add f, w
    jmp scale_cols(f2)
  done:
    ret
