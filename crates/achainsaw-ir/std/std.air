# AIR standard library: building blocks that modules import with a top-level `use` line,
#   use quantize_q8, qmat_chunk
# which links these functions (and the library functions they call) into the module.
# Every function here is validated and tested; see crates/achainsaw-ir/src/stdlib.rs.

# dst[0 .. 64] = rows 64c .. 64c + 64 of the quantized matrix `mat` times the int8
# activations xq (scales dx per 32-block, from quantize_q8); k is the matrix's row length.
# `mat` points to 3 words: packed weights, f16 scales, format (0 Q8_0, 1 Q4_0, 2 Q6_K).
# Per 32-block of a chunk's 64 rows:
#   Q8_0 (format 0): 2048 bytes, k-major int8 [32 x 64], fed to `mm` directly.
#   Q4_0 (format 1): 1024 bytes [16 x 64]: byte t * 64 + j holds row j's value t (low
#                    nibble) and t + 16 (high), each offset by 8.
#   Q6_K (format 2): 1536 bytes: the low 4 bits as Q4_0's nibbles, then a 512-byte plane
#                    [8 x 64] whose byte t * 64 + j holds the high 2 bits of row j's values
#                    t, t + 8, t + 16, t + 24 (bit pairs 0..3); values offset by 32.
# Q4_0 and Q6_K unpack into an int8 tile [32 x 64]. Scales are f16 [64] vectors per block:
# one for Q8_0 and Q4_0, two for Q6_K (one per 16 values, so two `mm`s of k = 16).
fn qmat_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64)
  b0:
    wq = ld mat:ptr
    mat1 = add mat, 8:i64
    scales = ld mat1:ptr
    mat2 = add mat, 16:i64
    fmt = ld mat2:i64
    is_q4 = eq fmt, 1:i64
    is_q6 = eq fmt, 2:i64
    w = vl f32
    w8 = vl i8
    nb = udiv k, 32:i64
    blk_q4 = cst 1024:i64
    blk_q6 = cst 1536:i64
    blk_q8 = cst 2048:i64
    blk_a = select is_q4, blk_q4, blk_q8
    blk_bytes = select is_q6, blk_q6, blk_a
    one = cst 1:i64
    two = cst 2:i64
    nsub = select is_q6, two, one
    chunk_w = mul nb, blk_bytes
    w_off = mul c, chunk_w
    wc = add wq, w_off
    sc_blk = mul nsub, 128:i64
    chunk_s = mul nb, sc_blk
    s_off = mul c, chunk_s
    sc = add scales, s_off
    dots = alloc 256:i64
    tile = alloc 2048:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    lo_mask = cst 15:i8
    v_lo_mask = splat lo_mask:vx
    eight = cst 8:i8
    v_eight = splat eight:vx
    three = cst 3:i8
    v_three = splat three:vx
    off32 = cst 32:i8
    v_32 = splat off32:vx
    four = cst 4:i32
    jmp zero_y(0:i64)
  zero_y(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_y_body, blocks(0:i64)
  zero_y_body:
    z_rest = sub 64:i64, z
    z_off = mul z, 4:i64
    pz = add dst, z_off
    stm pz, v_zero, z_rest:f32
    z2 = add z, w
    jmp zero_y(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk_bytes
    wb = add wc, blk_off
    br is_q4, unpack4(0:i64), not_q4
  not_q4:
    br is_q6, unpack6_lo(0:i64), sub(0:i64, wb)
  unpack4(u:i64):
    u_more = lt u, 1024:i64
    br u_more, unpack4_body, sub(0:i64, tile)
  unpack4_body:
    pn = add wb, u
    nv = ld pn:vx
    lo = vand nv, v_lo_mask:i8
    lo_q = vsub lo, v_eight:i8
    hi = vushr nv, four:i8
    hi_q = vsub hi, v_eight:i8
    plo = add tile, u
    st plo, lo_q
    hi_off = add u, 1024:i64
    phi = add tile, hi_off
    st phi, hi_q
    u2 = add u, w8
    jmp unpack4(u2)
  unpack6_lo(u6:i64):
    u6_more = lt u6, 1024:i64
    br u6_more, unpack6_lo_body, unpack6_hi(0:i64)
  unpack6_lo_body:
    pn6 = add wb, u6
    nv6 = ld pn6:vx
    lo6 = vand nv6, v_lo_mask:i8
    hi6 = vushr nv6, four:i8
    plo6 = add tile, u6
    st plo6, lo6
    hi6_off = add u6, 1024:i64
    phi6 = add tile, hi6_off
    st phi6, hi6
    u6b = add u6, w8
    jmp unpack6_lo(u6b)
  unpack6_hi(uh:i64):
    uh_more = lt uh, 512:i64
    br uh_more, unpack6_hi_body, sub(0:i64, tile)
  unpack6_hi_body:
    hb_base = add wb, 1024:i64
    phb = add hb_base, uh
    hb = ld phb:vx
    hbits0 = vand hb, v_three:i8
    htop0 = vshl hbits0, four:i8
    ht_off0 = add uh, 0:i64
    pt0 = add tile, ht_off0
    tl0 = ld pt0:vx
    tq0 = vor tl0, htop0:i8
    tv0 = vsub tq0, v_32:i8
    st pt0, tv0
    hs1 = vushr hb, 2:i8
    hbits1 = vand hs1, v_three:i8
    htop1 = vshl hbits1, four:i8
    ht_off1 = add uh, 512:i64
    pt1 = add tile, ht_off1
    tl1 = ld pt1:vx
    tq1 = vor tl1, htop1:i8
    tv1 = vsub tq1, v_32:i8
    st pt1, tv1
    hs2 = vushr hb, 4:i8
    hbits2 = vand hs2, v_three:i8
    htop2 = vshl hbits2, four:i8
    ht_off2 = add uh, 1024:i64
    pt2 = add tile, ht_off2
    tl2 = ld pt2:vx
    tq2 = vor tl2, htop2:i8
    tv2 = vsub tq2, v_32:i8
    st pt2, tv2
    hs3 = vushr hb, 6:i8
    hbits3 = vand hs3, v_three:i8
    htop3 = vshl hbits3, four:i8
    ht_off3 = add uh, 1536:i64
    pt3 = add tile, ht_off3
    tl3 = ld pt3:vx
    tq3 = vor tl3, htop3:i8
    tv3 = vsub tq3, v_32:i8
    st pt3, tv3
    uh2 = add uh, w8
    jmp unpack6_hi(uh2)
  sub(si:i64, wt:ptr):
    si_more = lt si, nsub
    br si_more, sub_start, block_next
  sub_start:
    jmp zero_dots(0:i64)
  zero_dots(zd:i64):
    zd_more = lt zd, 64:i64
    br zd_more, zero_dots_body, sub_mm
  zero_dots_body:
    zd_rest = sub 64:i64, zd
    zd_off = mul zd, 4:i64
    pzd = add dots, zd_off
    stm pzd, v_zero, zd_rest:i32
    zd2 = add zd, w
    jmp zero_dots(zd2)
  sub_mm:
    br is_q6, mm16, mm32
  mm32:
    xb_off = mul b, 32:i64
    xb = add xq, xb_off
    mm dots, xb, wt, 1:i64, 64:i64, 32:i64:i8
    jmp sub_scale
  mm16:
    x16_b = mul b, 32:i64
    x16_s = mul si, 16:i64
    x16_off = add x16_b, x16_s
    xb16 = add xq, x16_off
    w16_off = mul si, 1024:i64
    wt16 = add wt, w16_off
    mm dots, xb16, wt16, 1:i64, 64:i64, 16:i64:i8
    jmp sub_scale
  sub_scale:
    d_off = mul b, 4:i64
    pd = add dx, d_off
    d = ld pd:f32
    vd = splat d:vx
    sb_b = mul b, nsub
    sb_i = add sb_b, si
    sb_off = mul sb_i, 128:i64
    sb = add sc, sb_off
    jmp accum(0:i64)
  accum(j:i64):
    j_more = lt j, 64:i64
    br j_more, accum_body, sub_next
  accum_body:
    # Two vectors of outputs per step, from one full vector of f16 scales (its low and high
    # halves widened to f32); a partial load would cost a lane-by-lane copy on Cranelift.
    j_rest = sub 64:i64, j
    sj_off = mul j, 2:i64
    ps = add sb, sj_off
    s16 = ldm ps:vx, j_rest:f16
    j_off = mul j, 4:i64
    pp = add dots, j_off
    py = add dst, j_off
    p = ldm pp:vx, j_rest:i32
    pf = vitof p:f32
    s = vfwidenlo s16:f16
    ds = vmul s, vd:f32
    acc = ldm py:vx, j_rest:f32
    acc2 = vfma pf, ds, acc:f32
    stm py, acc2, j_rest:f32
    jh = add j, w
    jh_rest = sub 64:i64, jh
    jh_off = mul jh, 4:i64
    pph = add dots, jh_off
    pyh = add dst, jh_off
    ph = ldm pph:vx, jh_rest:i32
    pfh = vitof ph:f32
    sh = vfwidenhi s16:f16
    dsh = vmul sh, vd:f32
    acch = ldm pyh:vx, jh_rest:f32
    acc2h = vfma pfh, dsh, acch:f32
    stm pyh, acc2h, jh_rest:f32
    j2 = add jh, w
    jmp accum(j2)
  sub_next:
    si2 = add si, 1:i64
    jmp sub(si2, wt)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    free tile
    free dots
    ret

# Q8_0 quantization of x[0 .. k] (k a multiple of 32), as llama.cpp's quantize_row_q8_0:
# dx[b] = max|x in block b| / 127 and xq[32b + t] = round(x[32b + t] / dx[b]), halves away
# from zero. At full vector width: |x| by clearing the sign bit, rounding by adding 0.5 with
# the value's sign, then vftoi and two saturating vnarrows down to i8.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    abs_bits = cst 2147483647:i32
    v_abs = splat abs_bits:vx
    sign_bits = cst -2147483648:i32
    v_sign = splat sign_bits:vx
    half = cst 0.5:f32
    v_half = splat half:vx
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = mul b, 32:i64
    base4 = mul base, 4:i64
    bx = add x, base4
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    rest = sub 32:i64, t
    to = mul t, 4:i64
    pv = add bx, to
    v = ldm pv:vx, rest:f32
    av = vand v, v_abs:i32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    b_off = mul b, 4:i64
    pd = add dx, b_off
    st pd, d
    v_id = splat id:vx
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    rest_q = sub 32:i64, s
    so = mul s, 4:i64
    pq_in = add bx, so
    xv = ldm pq_in:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    sgn = vand sv, v_sign:i32
    hv = vor sgn, v_half:i32
    rv = vadd sv, hv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    q_off = add base, s
    po = add xq, q_off
    cnt = min rest_q, w
    stm po, q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# RoPE ("rotate-half" layout) for one head of hd f32 values, in place: x[j] and x[j + hd/2]
# rotate by the angle whose cos and sin are cos[j] and sin[j] (one row of a RoPE table).
fn rope_half(x:ptr, hd:i64, cos:ptr, sin:ptr)
  b0:
    w = vl f32
    half = udiv hd, 2:i64
    half_bytes = mul half, 4:i64
    p2 = add x, half_bytes
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    jmp cols(0:i64)
  cols(j:i64):
    j_more = lt j, half
    br j_more, cols_body, done
  cols_body:
    rest = sub half, j
    off = mul j, 4:i64
    q1 = add x, off
    q2 = add p2, off
    qc = add cos, off
    qs = add sin, off
    x1 = ldm q1:vx, rest:f32
    x2 = ldm q2:vx, rest:f32
    c = ldm qc:vx, rest:f32
    s = ldm qs:vx, rest:f32
    x2s = vmul x2, s:f32
    minus_x2s = vsub v_zero, x2s:f32
    y1 = vfma x1, c, minus_x2s:f32
    x2c = vmul x2, c:f32
    y2 = vfma x1, s, x2c:f32
    stm q1, y1, rest:f32
    stm q2, y2, rest:f32
    j2 = add j, w
    jmp cols(j2)
  done:
    ret

# p[i] = exp(p[i] - shift) for i < n (vexp), in place; returns the sum. With shift = max(p),
# the numerators of a numerically stable softmax.
fn exp_shift(p:ptr, n:i64, shift:f32)->f32
  b0:
    w = vl f32
    v_shift = splat shift:vx
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, sum(0:i64, v_zero)
  body:
    rest = sub n, i
    off = mul i, 4:i64
    pi = add p, off
    v = ldm pi:vx, rest:f32
    x0 = vsub v, v_shift:f32
    e = vexp x0:f32
    stm pi, e, rest:f32
    i2 = add i, w
    jmp loop(i2)
  # Masked loads zero the lanes past n, so they add nothing.
  sum(j:i64, acc:vx):
    j_more = lt j, n
    br j_more, sum_body, done
  sum_body:
    j_rest = sub n, j
    j_off = mul j, 4:i64
    pj = add p, j_off
    ev = ldm pj:vx, j_rest:f32
    acc2 = vadd acc, ev:f32
    j2 = add j, w
    jmp sum(j2, acc2)
  done:
    total = vsum acc:f32
    ret total

# out = silu(gate) * up = gate * up / (1 + exp(-gate)) for n f32 values: SwiGLU's gating.
fn silu_mul(gate:ptr, up:ptr, out:ptr, n:i64)
  b0:
    w = vl f32
    one = cst 1.0:f32
    v_one = splat one:vx
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    off = mul i, 4:i64
    pg = add gate, off
    pu = add up, off
    po = add out, off
    g = ldm pg:vx, rest:f32
    u = ldm pu:vx, rest:f32
    ng = vsub v_zero, g:f32
    e = vexp ng:f32
    den = vadd e, v_one:f32
    gu = vmul g, u:f32
    y = vdiv gu, den:f32
    stm po, y, rest:f32
    i2 = add i, w
    jmp loop(i2)
  done:
    ret
