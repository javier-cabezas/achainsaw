# AIR standard library: building blocks that modules import with a top-level `use` line,
#   use quantize_q8, qmat_chunk
# which links these functions (and the library functions they call) into the module.
# Every function here is validated and tested; see crates/achainsaw-ir/src/stdlib.rs.

# dst[0 .. 64] = rows 64c .. 64c + 64 of the quantized matrix `mat` times the int8
# activations xq (block records dx, from quantize_q8); k is the matrix's row length.
# `mat` is a list of parts of 4 words each: packed weights, f16 scales, format (0 Q8_0,
# 1 Q4_0, 2 Q6_K, 3 Q4_K, 4 Q5_K, 5 Q4_1) and the part's number of 64-row chunks; chunk c is in the
# first part whose chunks reach past it, so the parts of a fused matrix (Q, K and V) keep
# their own formats.
# Weights come in chunks of 64 rows, stored unsigned (value + bias); per 32-block of a chunk,
# each group of 4 consecutive values of a row fills one 32-bit lane, so one `vdotu` (x86
# vpdpbusd, Arm usdot) multiplies them by 4 activations:
#   Q8_0 (format 0): 2048 bytes: byte (g * 64 + j) * 4 + q is row j's value 4g + q (g < 8),
#                    plus 128 (the int8 value with its top bit flipped).
#   Q4_0 (format 1): 1024 bytes: byte (g * 64 + j) * 4 + q (g < 4) holds row j's values
#                    4g + q (low nibble) and 16 + 4g + q (high), offset by 8: GGUF's own
#                    nibble bytes, regrouped.
#   Q6_K (format 2): 1536 bytes: the low 4 bits of the values offset by 32, as Q4_0's
#                    nibbles, then 512 bytes whose byte (g * 64 + j) * 4 + q (g < 2) holds
#                    the high 2 bits of row j's value 8p + 4g + q in bit pair p (p < 4).
#   Q4_K (format 3): 1024 bytes: the values 0..15 as Q4_0's nibbles (no offset).
#   Q5_K (format 4): 1280 bytes: the low 4 bits of the values 0..31 as Q4_0's nibbles, then
#                    256 bytes whose byte j * 4 + q holds the top bits of row j's values
#                    4g + q in bit g and 16 + 4g + q in bit 4 + g (g < 4).
#   Q4_1 (format 5): 1024 bytes: the values 0..15 as Q4_0's nibbles (no offset).
# Scales are f16 [64] vectors per block: one for Q8_0 and Q4_0, two for Q6_K (one per 16
# values). Q4_K, Q5_K and Q4_1 weights are s * value - m with a scale s and a min m per
# block. Q4_1 stores both as f16 [64] vectors, s then m (GGUF's min negated); Q4_K and Q5_K
# keep them as GGUF does: per block the 6-bit codes, [64] i16s holding a row's scale code in
# the low byte and its min code in the high one, and after a chunk's blocks the f16 factors
# d and dmin of each 256-value super-block (8 blocks, the last one of a row possibly fewer),
# [64] each, so s = d * code and m = dmin * code (exact in f32).
# Blocks are the outer loop, so each block's bytes are read in one pass; for each strip of
# `vl i32` rows, two exact int32 dot chains (values 0..15 and 16..31, Q6_K's two scale
# groups) lose bias * sum(x) (the sums from quantize_q8's block records), then are converted
# and added as scale * d * dot into dst; the formats with a min, which have no bias, instead
# subtract m * d * sum(x) after. The format is chosen once per block, for a strip loop of
# its own, and a strip's 4 groups are unrolled (qmat_dots*): Cranelift neither hoists a
# branch out of a loop nor unrolls one, and both made the loops faster on LLVM too. The
# steps are the inline functions below, shared with qmat_chunk4, so both give the same bits
# per token.
fn qmat_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt, bias = call qmat_layout(c, mat, k)
    w = vl i32
    zf = splat 0.0:f32:vx
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb = add xq, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    sd = call qmat_ksup(sc, nb, b)
    d, c_lo, c_hi = call qmat_block(dx, b, bias)
    # One strip loop per format, chosen once per block.
    odd = and fmt, 1:i64
    is_n = eq odd, 1:i64
    br is_n, nib, wide
  nib:
    is_q4 = eq fmt, 1:i64
    br is_q4, q4(0:i64), nib2
  nib2:
    is_k4 = eq fmt, 3:i64
    br is_k4, k4(0:i64), a4(0:i64)
  wide:
    is_q8 = eq fmt, 0:i64
    br is_q8, q8(0:i64), wide2
  wide2:
    is_q6 = eq fmt, 2:i64
    br is_q6, q6(0:i64), k5(0:i64)
  q8(jq8:i64):
    m_q8 = lt jq8, 64:i64
    br m_q8, q8_body, block_next
  q8_body:
    wb_q8, s_q8, py_q8 = call qmat_strip(wb0, sb, dst, jq8)
    l_q8, h_q8 = call qmat_dots8(wb_q8, xb)
    call qmat_acc1(py_q8, l_q8, h_q8, s_q8, d, c_lo, c_hi)
    jq8n = add jq8, w
    jmp q8(jq8n)
  q4(jq4:i64):
    m_q4 = lt jq4, 64:i64
    br m_q4, q4_body, block_next
  q4_body:
    wb_q4, s_q4, py_q4 = call qmat_strip(wb0, sb, dst, jq4)
    l_q4, h_q4 = call qmat_dots4(wb_q4, xb)
    call qmat_acc1(py_q4, l_q4, h_q4, s_q4, d, c_lo, c_hi)
    jq4n = add jq4, w
    jmp q4(jq4n)
  q6(jq6:i64):
    m_q6 = lt jq6, 64:i64
    br m_q6, q6_body, block_next
  q6_body:
    wb_q6, s_q6, py_q6 = call qmat_strip(wb0, sb, dst, jq6)
    l_q6, h_q6 = call qmat_dots6(wb_q6, xb)
    s1_q6 = call qmat_scale1(sb, jq6)
    call qmat_acc2(py_q6, l_q6, h_q6, s_q6, s1_q6, d, c_lo, c_hi)
    jq6n = add jq6, w
    jmp q6(jq6n)
  k4(jk4:i64):
    m_k4 = lt jk4, 64:i64
    br m_k4, k4_body, block_next
  k4_body:
    wb_k4, s_k4, s1_k4, py_k4 = call qmat_kstrip(wb0, sb, sd, dst, jk4)
    l_k4, h_k4 = call qmat_dots4(wb_k4, xb)
    call qmat_accm(py_k4, l_k4, h_k4, s_k4, s1_k4, d, c_lo, c_hi)
    jk4n = add jk4, w
    jmp k4(jk4n)
  k5(jk5:i64):
    m_k5 = lt jk5, 64:i64
    br m_k5, k5_body, block_next
  k5_body:
    wb_k5, s_k5, s1_k5, py_k5 = call qmat_kstrip(wb0, sb, sd, dst, jk5)
    l_k5, h_k5 = call qmat_dots5(wb_k5, xb)
    call qmat_accm(py_k5, l_k5, h_k5, s_k5, s1_k5, d, c_lo, c_hi)
    jk5n = add jk5, w
    jmp k5(jk5n)
  a4(ja4:i64):
    m_a4 = lt ja4, 64:i64
    br m_a4, a4_body, block_next
  a4_body:
    wb_a4, s_a4, py_a4 = call qmat_strip(wb0, sb, dst, ja4)
    s1_a4 = call qmat_scale1(sb, ja4)
    l_a4, h_a4 = call qmat_dots4(wb_a4, xb)
    call qmat_accm(py_a4, l_a4, h_a4, s_a4, s1_a4, d, c_lo, c_hi)
    ja4n = add ja4, w
    jmp a4(ja4n)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# qmat_chunk for 4 tokens at once: token t's int8 activations at xq + t * xs, its block
# records at dx + t * xs / 2, its 64 results at dst + 256 t. Each weight vector is loaded and
# unpacked once for the four tokens; every token goes through qmat_chunk's steps, so its
# results are exactly qmat_chunk's.
fn qmat_chunk4(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, xs:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt, bias = call qmat_layout(c, mat, k)
    w = vl i32
    zf = splat 0.0:f32:vx
    xq1 = add xq, xs
    xq2 = add xq1, xs
    xq3 = add xq2, xs
    ds = udiv xs, 2:i64
    dx1 = add dx, ds
    dx2 = add dx1, ds
    dx3 = add dx2, ds
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 256:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb0 = add xq, xo
    xb1 = add xq1, xo
    xb2 = add xq2, xo
    xb3 = add xq3, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    sd = call qmat_ksup(sc, nb, b)
    d0, l0, h0 = call qmat_block(dx, b, bias)
    d1, l1, h1 = call qmat_block(dx1, b, bias)
    d2, l2, h2 = call qmat_block(dx2, b, bias)
    d3, l3, h3 = call qmat_block(dx3, b, bias)
    # One strip loop per format, chosen once per block.
    odd = and fmt, 1:i64
    is_n = eq odd, 1:i64
    br is_n, nib, wide
  nib:
    is_q4 = eq fmt, 1:i64
    br is_q4, q4(0:i64), nib2
  nib2:
    is_k4 = eq fmt, 3:i64
    br is_k4, k4(0:i64), a4(0:i64)
  wide:
    is_q8 = eq fmt, 0:i64
    br is_q8, q8(0:i64), wide2
  wide2:
    is_q6 = eq fmt, 2:i64
    br is_q6, q6(0:i64), k5(0:i64)
  q8(jq8:i64):
    m_q8 = lt jq8, 64:i64
    br m_q8, q8_body, block_next
  q8_body:
    wb_q8, s_q8, py_q8 = call qmat_strip(wb0, sb, dst, jq8)
    q80l, q80h, q81l, q81h, q82l, q82h, q83l, q83h = call qmat_dots8x4(wb_q8, xb0, xb1, xb2, xb3)
    py1_q8 = add py_q8, 256:i64
    py2_q8 = add py_q8, 512:i64
    py3_q8 = add py_q8, 768:i64
    call qmat_acc1(py_q8, q80l, q80h, s_q8, d0, l0, h0)
    call qmat_acc1(py1_q8, q81l, q81h, s_q8, d1, l1, h1)
    call qmat_acc1(py2_q8, q82l, q82h, s_q8, d2, l2, h2)
    call qmat_acc1(py3_q8, q83l, q83h, s_q8, d3, l3, h3)
    jq8n = add jq8, w
    jmp q8(jq8n)
  q4(jq4:i64):
    m_q4 = lt jq4, 64:i64
    br m_q4, q4_body, block_next
  q4_body:
    wb_q4, s_q4, py_q4 = call qmat_strip(wb0, sb, dst, jq4)
    q40l, q40h, q41l, q41h, q42l, q42h, q43l, q43h = call qmat_dots4x4(wb_q4, xb0, xb1, xb2, xb3)
    py1_q4 = add py_q4, 256:i64
    py2_q4 = add py_q4, 512:i64
    py3_q4 = add py_q4, 768:i64
    call qmat_acc1(py_q4, q40l, q40h, s_q4, d0, l0, h0)
    call qmat_acc1(py1_q4, q41l, q41h, s_q4, d1, l1, h1)
    call qmat_acc1(py2_q4, q42l, q42h, s_q4, d2, l2, h2)
    call qmat_acc1(py3_q4, q43l, q43h, s_q4, d3, l3, h3)
    jq4n = add jq4, w
    jmp q4(jq4n)
  q6(jq6:i64):
    m_q6 = lt jq6, 64:i64
    br m_q6, q6_body, block_next
  q6_body:
    wb_q6, s_q6, py_q6 = call qmat_strip(wb0, sb, dst, jq6)
    q60l, q60h, q61l, q61h, q62l, q62h, q63l, q63h = call qmat_dots6x4(wb_q6, xb0, xb1, xb2, xb3)
    py1_q6 = add py_q6, 256:i64
    py2_q6 = add py_q6, 512:i64
    py3_q6 = add py_q6, 768:i64
    s1_q6 = call qmat_scale1(sb, jq6)
    call qmat_acc2(py_q6, q60l, q60h, s_q6, s1_q6, d0, l0, h0)
    call qmat_acc2(py1_q6, q61l, q61h, s_q6, s1_q6, d1, l1, h1)
    call qmat_acc2(py2_q6, q62l, q62h, s_q6, s1_q6, d2, l2, h2)
    call qmat_acc2(py3_q6, q63l, q63h, s_q6, s1_q6, d3, l3, h3)
    jq6n = add jq6, w
    jmp q6(jq6n)
  k4(jk4:i64):
    m_k4 = lt jk4, 64:i64
    br m_k4, k4_body, block_next
  k4_body:
    wb_k4, s_k4, s1_k4, py_k4 = call qmat_kstrip(wb0, sb, sd, dst, jk4)
    k40l, k40h, k41l, k41h, k42l, k42h, k43l, k43h = call qmat_dots4x4(wb_k4, xb0, xb1, xb2, xb3)
    py1_k4 = add py_k4, 256:i64
    py2_k4 = add py_k4, 512:i64
    py3_k4 = add py_k4, 768:i64
    call qmat_accm(py_k4, k40l, k40h, s_k4, s1_k4, d0, l0, h0)
    call qmat_accm(py1_k4, k41l, k41h, s_k4, s1_k4, d1, l1, h1)
    call qmat_accm(py2_k4, k42l, k42h, s_k4, s1_k4, d2, l2, h2)
    call qmat_accm(py3_k4, k43l, k43h, s_k4, s1_k4, d3, l3, h3)
    jk4n = add jk4, w
    jmp k4(jk4n)
  k5(jk5:i64):
    m_k5 = lt jk5, 64:i64
    br m_k5, k5_body, block_next
  k5_body:
    wb_k5, s_k5, s1_k5, py_k5 = call qmat_kstrip(wb0, sb, sd, dst, jk5)
    k50l, k50h, k51l, k51h, k52l, k52h, k53l, k53h = call qmat_dots5x4(wb_k5, xb0, xb1, xb2, xb3)
    py1_k5 = add py_k5, 256:i64
    py2_k5 = add py_k5, 512:i64
    py3_k5 = add py_k5, 768:i64
    call qmat_accm(py_k5, k50l, k50h, s_k5, s1_k5, d0, l0, h0)
    call qmat_accm(py1_k5, k51l, k51h, s_k5, s1_k5, d1, l1, h1)
    call qmat_accm(py2_k5, k52l, k52h, s_k5, s1_k5, d2, l2, h2)
    call qmat_accm(py3_k5, k53l, k53h, s_k5, s1_k5, d3, l3, h3)
    jk5n = add jk5, w
    jmp k5(jk5n)
  a4(ja4:i64):
    m_a4 = lt ja4, 64:i64
    br m_a4, a4_body, block_next
  a4_body:
    wb_a4, s_a4, py_a4 = call qmat_strip(wb0, sb, dst, ja4)
    s1_a4 = call qmat_scale1(sb, ja4)
    a40l, a40h, a41l, a41h, a42l, a42h, a43l, a43h = call qmat_dots4x4(wb_a4, xb0, xb1, xb2, xb3)
    py1_a4 = add py_a4, 256:i64
    py2_a4 = add py_a4, 512:i64
    py3_a4 = add py_a4, 768:i64
    call qmat_accm(py_a4, a40l, a40h, s_a4, s1_a4, d0, l0, h0)
    call qmat_accm(py1_a4, a41l, a41h, s_a4, s1_a4, d1, l1, h1)
    call qmat_accm(py2_a4, a42l, a42h, s_a4, s1_a4, d2, l2, h2)
    call qmat_accm(py3_a4, a43l, a43h, s_a4, s1_a4, d3, l3, h3)
    ja4n = add ja4, w
    jmp a4(ja4n)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# qmat_chunk4 for 8 tokens: each weight vector is loaded and unpacked once for eight. Strips
# of rows are the outer loop and blocks the inner one here, so the 8 tokens' sums of a strip
# stay in registers (the chunk's weights stay in L2 cache across the tiles of a prefill),
# and a token's dots for values 0..15 and 16..31 go into one int32 chain (one scale, except
# in Q6_K, which runs its halves one after the other): 8 int32 and 8 f32 accumulators. The
# first strip copies, per block, the 8 tokens' activations and records into one row of a
# table (qmat_prep8), so that one pointer reaches them all. Each token's int32 sums equal
# qmat_chunk's and its float operations are qmat_chunk's in the same order, so its results
# are exactly qmat_chunk's.
fn qmat_chunk8(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, xs:i64)
  b0:
    wb0, sc, nb, blk, sc_blk, fmt, bias = call qmat_layout(c, mat, k)
    w = vl i32
    xq1 = add xq, xs
    xq2 = add xq1, xs
    xq3 = add xq2, xs
    xq4 = add xq3, xs
    xq5 = add xq4, xs
    xq6 = add xq5, xs
    xq7 = add xq6, xs
    ds = udiv xs, 2:i64
    dx1 = add dx, ds
    dx2 = add dx1, ds
    dx3 = add dx2, ds
    dx4 = add dx3, ds
    dx5 = add dx4, ds
    dx6 = add dx5, ds
    dx7 = add dx6, ds
    is_q6 = eq fmt, 2:i64
    tab_sz = mul nb, 384:i64
    tab = alloc tab_sz
    zf = splat 0.0:f32:vx
    # One strip loop per format, chosen once per chunk.
    odd = and fmt, 1:i64
    is_n = eq odd, 1:i64
    br is_n, nib, wide
  nib:
    is_q4 = eq fmt, 1:i64
    br is_q4, q4(0:i64), nib2
  nib2:
    is_k4 = eq fmt, 3:i64
    br is_k4, k4(0:i64), a4(0:i64)
  wide:
    is_q8 = eq fmt, 0:i64
    br is_q8, q8(0:i64), wide2
  wide2:
    br is_q6, q6(0:i64), k5(0:i64)
  q8(jq8:i64):
    more_q8 = lt jq8, 64:i64
    br more_q8, q8_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  q8_blocks(bq8:i64, f0q8:vx, f1q8:vx, f2q8:vx, f3q8:vx, f4q8:vx, f5q8:vx, f6q8:vx, f7q8:vx):
    bmore_q8 = lt bq8, nb
    br bmore_q8, q8_next, q8_end
  q8_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_q8 = eq jq8, 0:i64
    br first_q8, q8_prep, q8_body
  q8_prep:
    call qmat_prep8(tab, bq8, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
    jmp q8_body
  q8_body:
    wbb_q8, sb_q8, xr_q8, e_q8 = call qmat_tile8(wb0, sc, tab, bq8, blk, sc_blk)
    wb_q8, s_q8, unused_q8 = call qmat_strip(wbb_q8, sb_q8, dst, jq8)
    r0q8, r1q8, r2q8, r3q8, r4q8, r5q8, r6q8, r7q8 = call qmat_dots8x8(wb_q8, xr_q8)
    g0q8, g1q8, g2q8, g3q8, g4q8, g5q8, g6q8, g7q8 = call qmat_acc8(e_q8, 0:i32, s_q8, f0q8, f1q8, f2q8, f3q8, f4q8, f5q8, f6q8, f7q8, r0q8, r1q8, r2q8, r3q8, r4q8, r5q8, r6q8, r7q8)
    bq82 = add bq8, 1:i64
    jmp q8_blocks(bq82, g0q8, g1q8, g2q8, g3q8, g4q8, g5q8, g6q8, g7q8)
  q8_end:
    out_q8 = shl jq8, 2:i64
    py_q8 = add dst, out_q8
    call qmat_st8(py_q8, f0q8, f1q8, f2q8, f3q8, f4q8, f5q8, f6q8, f7q8)
    jq82 = add jq8, w
    jmp q8(jq82)
  q4(jq4:i64):
    more_q4 = lt jq4, 64:i64
    br more_q4, q4_blocks(0:i64, zf, zf, zf, zf, zf, zf, zf, zf), done
  q4_blocks(bq4:i64, f0q4:vx, f1q4:vx, f2q4:vx, f3q4:vx, f4q4:vx, f5q4:vx, f6q4:vx, f7q4:vx):
    bmore_q4 = lt bq4, nb
    br bmore_q4, q4_next, q4_end
  q4_next:
    # The first strip fills the tile's row for the block; the others read it.
    first_q4 = eq jq4, 0:i64
    br first_q4, q4_prep, q4_body
  q4_prep:
    call qmat_prep8(tab, bq4, xq, xq1, xq2, xq3, xq4, xq5, xq6, xq7, dx, dx1, dx2, dx3, dx4, dx5, dx6, dx7, bias, is_q6)
