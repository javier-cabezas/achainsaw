    a1_0, a1_1, a1_2, a1_3, a1_4, a1_5, a1_6, a1_7 = call qmat_dot8(xr, 1:i64, w1, a0_0, a0_1, a0_2, a0_3, a0_4, a0_5, a0_6, a0_7)
    w2, w2h = call qmat_w6(wb, 2:i64)
    a2_0, a2_1, a2_2, a2_3, a2_4, a2_5, a2_6, a2_7 = call qmat_dot8(xr, 2:i64, w2, a1_0, a1_1, a1_2, a1_3, a1_4, a1_5, a1_6, a1_7)
    w3, w3h = call qmat_w6(wb, 3:i64)
    a3_0, a3_1, a3_2, a3_3, a3_4, a3_5, a3_6, a3_7 = call qmat_dot8(xr, 3:i64, w3, a2_0, a2_1, a2_2, a2_3, a2_4, a2_5, a2_6, a2_7)
    ret a3_0, a3_1, a3_2, a3_3, a3_4, a3_5, a3_6, a3_7

# qmat_dots6's sums of values 16..31 for the 8 tokens of a qmat_chunk8 row at xr.
inline fn qmat_dots6hix8(wb:ptr, xr:ptr)->(vx, vx, vx, vx, vx, vx, vx, vx)
  b0:
    z = splat 0:i32:vx
    w0l, w0 = call qmat_w6(wb, 0:i64)
    a0_0, a0_1, a0_2, a0_3, a0_4, a0_5, a0_6, a0_7 = call qmat_dot8(xr, 4:i64, w0, z, z, z, z, z, z, z, z)
    w1l, w1 = call qmat_w6(wb, 1:i64)
    a1_0, a1_1, a1_2, a1_3, a1_4, a1_5, a1_6, a1_7 = call qmat_dot8(xr, 5:i64, w1, a0_0, a0_1, a0_2, a0_3, a0_4, a0_5, a0_6, a0_7)
    w2l, w2 = call qmat_w6(wb, 2:i64)
    a2_0, a2_1, a2_2, a2_3, a2_4, a2_5, a2_6, a2_7 = call qmat_dot8(xr, 6:i64, w2, a1_0, a1_1, a1_2, a1_3, a1_4, a1_5, a1_6, a1_7)
    w3l, w3 = call qmat_w6(wb, 3:i64)
    a3_0, a3_1, a3_2, a3_3, a3_4, a3_5, a3_6, a3_7 = call qmat_dot8(xr, 7:i64, w3, a2_0, a2_1, a2_2, a2_3, a2_4, a2_5, a2_6, a2_7)
    ret a3_0, a3_1, a3_2, a3_3, a3_4, a3_5, a3_6, a3_7

# Block b of a qmat_chunk8 tile: its weights and scales, and the tile's row for it (384 bytes
# per block: the 8 tokens' 32 activations, then their 16-byte records from qmat_rec).
inline fn qmat_tile8(wb0:ptr, sc:ptr, tab:ptr, b:i64, blk:i64, sc_blk:i64)->(ptr, ptr, ptr, ptr)
  b0:
    bo = mul b, blk
    wb = add wb0, bo
    so = mul b, sc_blk
    sb = add sc, so
    eo = mul b, 384:i64
    xr = add tab, eo
    e = add xr, 256:i64
    ret wb, sb, xr, e

# Block b's row of a qmat_chunk8 tile at tab (see qmat_tile8): the 8 tokens' activations
# (from xq0 .. xq7) and records (qmat_rec, from dx0 .. dx7).
inline fn qmat_prep8(tab:ptr, b:i64, xq0:ptr, xq1:ptr, xq2:ptr, xq3:ptr, xq4:ptr, xq5:ptr, xq6:ptr, xq7:ptr, dx0:ptr, dx1:ptr, dx2:ptr, dx3:ptr, dx4:ptr, dx5:ptr, dx6:ptr, dx7:ptr, bias:i32, is_q6:i32)
  b0:
    eo = mul b, 384:i64
    pe = add tab, eo
    pr = add pe, 256:i64
    px = shl b, 5:i64
    px0 = add xq0, px
    call qmat_copyx(pe, 0:i64, px0)
    px1 = add xq1, px
    call qmat_copyx(pe, 1:i64, px1)
    px2 = add xq2, px
    call qmat_copyx(pe, 2:i64, px2)
    px3 = add xq3, px
    call qmat_copyx(pe, 3:i64, px3)
    px4 = add xq4, px
    call qmat_copyx(pe, 4:i64, px4)
    px5 = add xq5, px
    call qmat_copyx(pe, 5:i64, px5)
    px6 = add xq6, px
    call qmat_copyx(pe, 6:i64, px6)
    px7 = add xq7, px
    call qmat_copyx(pe, 7:i64, px7)
    call qmat_rec(pr, 0:i64, dx0, b, bias, is_q6)
    call qmat_rec(pr, 1:i64, dx1, b, bias, is_q6)
    call qmat_rec(pr, 2:i64, dx2, b, bias, is_q6)
    call qmat_rec(pr, 3:i64, dx3, b, bias, is_q6)
    call qmat_rec(pr, 4:i64, dx4, b, bias, is_q6)
    call qmat_rec(pr, 5:i64, dx5, b, bias, is_q6)
    call qmat_rec(pr, 6:i64, dx6, b, bias, is_q6)
    call qmat_rec(pr, 7:i64, dx7, b, bias, is_q6)
    ret

# Token t's 32 activations of a block (at xb) into their place in a qmat_chunk8 row at pe.
inline fn qmat_copyx(pe:ptr, t:i64, xb:ptr)
  b0:
    o = shl t, 5:i64
    q = add pe, o
    lo = ld xb:v128
    hi = ld xb[16:i8]:v128
    st q, lo
    st q[16:i8], hi
    ret

# Token t's 16-byte entry in the row of block b at pe: from its activation record (qmat_block),
# the scale d, the correction c of qmat_accr (c_lo for Q6_K's first half, c_lo + c_hi
# otherwise), Q6_K's c_hi, and -d * (c_lo + c_hi) for the mins of Q4_K, Q5_K and Q4_1
# (qmat_accm's).
inline fn qmat_rec(pe:ptr, t:i64, dx:ptr, b:i64, bias:i32, is_q6:i32)
  b0:
    d, c_lo, c_hi = call qmat_block(dx, b, bias)
    c_all = add c_lo, c_hi
    c = select is_q6, c_lo, c_all
    nd = call qmat_negsum(d, c_all)
    eo = shl t, 4:i64
    e = add pe, eo
    st e, d
    st e[1], c
    st e[2], c_hi
    st e[3], nd
    ret

# Token t's entry (qmat_rec) in a block's row of records at e.
inline fn qmat_rec_ld(e:ptr, t:i64)->(f32, i32, i32, f32)
  b0:
    eo = shl t, 4:i64
    p = add e, eo
    d = ld p:f32
    c = ld p[1]:i32
    h = ld p[2]:i32
    nd = ld p[3]:f32
    ret d, c, h, nd

# qmat_accr for the 8 tokens of a strip, with their records at e (qmat_rec): c removes
# the bias of the whole block (Q8_0, Q4_0) or of Q6_K's first half, or with half = 1 of
# Q6_K's second.
inline fn qmat_acc8(e:ptr, half:i32, s:vx, f0:vx, f1:vx, f2:vx, f3:vx, f4:vx, f5:vx, f6:vx, f7:vx, r0:vx, r1:vx, r2:vx, r3:vx, r4:vx, r5:vx, r6:vx, r7:vx)->(vx, vx, vx, vx, vx, vx, vx, vx)
  b0:
    d0, c0, h0, n0 = call qmat_rec_ld(e, 0:i64)
    k0 = select half, h0, c0
    g0 = call qmat_accr(f0, r0, s, d0, k0)
    d1, c1, h1, n1 = call qmat_rec_ld(e, 1:i64)
    k1 = select half, h1, c1
    g1 = call qmat_accr(f1, r1, s, d1, k1)
    d2, c2, h2, n2 = call qmat_rec_ld(e, 2:i64)
    k2 = select half, h2, c2
    g2 = call qmat_accr(f2, r2, s, d2, k2)
    d3, c3, h3, n3 = call qmat_rec_ld(e, 3:i64)
    k3 = select half, h3, c3
    g3 = call qmat_accr(f3, r3, s, d3, k3)
    d4, c4, h4, n4 = call qmat_rec_ld(e, 4:i64)
    k4 = select half, h4, c4
    g4 = call qmat_accr(f4, r4, s, d4, k4)
    d5, c5, h5, n5 = call qmat_rec_ld(e, 5:i64)
    k5 = select half, h5, c5
    g5 = call qmat_accr(f5, r5, s, d5, k5)
    d6, c6, h6, n6 = call qmat_rec_ld(e, 6:i64)
    k6 = select half, h6, c6
    g6 = call qmat_accr(f6, r6, s, d6, k6)
    d7, c7, h7, n7 = call qmat_rec_ld(e, 7:i64)
    k7 = select half, h7, c7
    g7 = call qmat_accr(f7, r7, s, d7, k7)
    ret g0, g1, g2, g3, g4, g5, g6, g7

# qmat_accmr for the 8 tokens of a strip (Q4_K, Q5_K and Q4_1), with their records at e.
inline fn qmat_accm8(e:ptr, s:vx, m:vx, f0:vx, f1:vx, f2:vx, f3:vx, f4:vx, f5:vx, f6:vx, f7:vx, r0:vx, r1:vx, r2:vx, r3:vx, r4:vx, r5:vx, r6:vx, r7:vx)->(vx, vx, vx, vx, vx, vx, vx, vx)
  b0:
    d0, c0, h0, n0 = call qmat_rec_ld(e, 0:i64)
    g0 = call qmat_accmr(f0, r0, s, m, d0, n0)
    d1, c1, h1, n1 = call qmat_rec_ld(e, 1:i64)
    g1 = call qmat_accmr(f1, r1, s, m, d1, n1)
    d2, c2, h2, n2 = call qmat_rec_ld(e, 2:i64)
    g2 = call qmat_accmr(f2, r2, s, m, d2, n2)
    d3, c3, h3, n3 = call qmat_rec_ld(e, 3:i64)
    g3 = call qmat_accmr(f3, r3, s, m, d3, n3)
    d4, c4, h4, n4 = call qmat_rec_ld(e, 4:i64)
    g4 = call qmat_accmr(f4, r4, s, m, d4, n4)
    d5, c5, h5, n5 = call qmat_rec_ld(e, 5:i64)
    g5 = call qmat_accmr(f5, r5, s, m, d5, n5)
    d6, c6, h6, n6 = call qmat_rec_ld(e, 6:i64)
    g6 = call qmat_accmr(f6, r6, s, m, d6, n6)
    d7, c7, h7, n7 = call qmat_rec_ld(e, 7:i64)
    g7 = call qmat_accmr(f7, r7, s, m, d7, n7)
    ret g0, g1, g2, g3, g4, g5, g6, g7

# The 8 tokens' sums of a strip, 64 floats (one token's results) apart from py.
inline fn qmat_st8(py:ptr, f0:vx, f1:vx, f2:vx, f3:vx, f4:vx, f5:vx, f6:vx, f7:vx)
  b0:
    st py, f0
    st py[64:f32], f1
    st py[128:f32], f2
    st py[192:f32], f3
    st py[256:f32], f4
    st py[320:f32], f5
    st py[384:f32], f6
    st py[448:f32], f7
    ret

# f16 scales sb[i ..] of a strip's rows (at most n of them), widened to f32: scale group
# 0 of rows j .. at sb[j], Q6_K's group 1 at sb[j + 64] (and Q4_K's and Q5_K's factors).
inline fn qmat_scale(sb:ptr, i:i64, n:i64)->vx
  b0:
    h = ldm sb[i]:vx, n:f16
    s = vfwidenlo h:f16
    ret s

# A token's f32 sums at py += s * d * (dl + dh - c_lo - c_hi): Q8_0 and Q4_0, one scale per
# block; c_lo and c_hi remove the weights' bias from the dots (see qmat_block).
inline fn qmat_acc1(py:ptr, dl:vx, dh:vx, s:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    raw = vadd dl, dh:i32
    c = add c_lo, c_hi
    acc2 = call qmat_accr(acc, raw, s, d, c)
    st py, acc2
    ret

# A token's f32 sums at py += s * d * (dl - c_lo), then += s1 * d * (dh - c_hi): Q6_K's two
# scale groups.
inline fn qmat_acc2(py:ptr, dl:vx, dh:vx, s:vx, s1:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    accl = call qmat_accr(acc, dl, s, d, c_lo)
    acch = call qmat_accr(accl, dh, s1, d, c_hi)
    st py, acch
    ret

# acc + s * d * (dot - c), the step of qmat_acc1 and qmat_acc2 (and of qmat_chunk8, whose sums
# stay in registers).
inline fn qmat_accr(acc:vx, dot:vx, s:vx, d:f32, c:i32)->vx
  b0:
    vd = splat d:vx
    ds = vmul s, vd:f32
    vc = splat c:vx
    dc = vsub dot, vc:i32
    pf = vitof dc:f32
    acc2 = vfma pf, ds, acc:f32
    ret acc2

# A token's f32 sums at py += s * d * (dl + dh), then -= m * d * (c_lo + c_hi): Q4_K, Q5_K
# and Q4_1, whose weights s * value - m have a scale s and a min m per block (qmat_layout's
# bias 1 makes c_lo + c_hi the activations' sum).
inline fn qmat_accm(py:ptr, dl:vx, dh:vx, s:vx, m:vx, d:f32, c_lo:i32, c_hi:i32)
  b0:
    acc = ld py:vx
    raw = vadd dl, dh:i32
    sum = add c_lo, c_hi
    nd = call qmat_negsum(d, sum)
    acc2 = call qmat_accmr(acc, raw, s, m, d, nd)
    st py, acc2
    ret

# -d * sum, the factor of a block's mins in qmat_accmr.
inline fn qmat_negsum(d:f32, sum:i32)->f32
  b0:
    sumf = itof sum:f32
    dsum = mul d, sumf
    nd = neg dsum
    ret nd

# (acc + s * d * dot) + m * nd, nd being -d * sum (qmat_negsum).
inline fn qmat_accmr(acc:vx, dot:vx, s:vx, m:vx, d:f32, nd:f32)->vx
  b0:
    vd = splat d:vx
    ds = vmul s, vd:f32
    pf = vitof dot:f32
    acc1 = vfma pf, ds, acc:f32
    vn = splat nd:vx
    acc2 = vfma m, vn, acc1:f32
    ret acc2

# Block b's activation record (from quantize_q8) at dx: its scale, and the corrections for
# weights stored with `bias` added: bias times the sums of values 0..15 and 16..31.
inline fn qmat_block(dx:ptr, b:i64, bias:i32)->(f32, i32, i32)
  b0:
    ro = shl b, 4:i64
    rec = add dx, ro
    d = ld rec:f32
    s_lo = ld rec[1]:i32
    s_hi = ld rec[2]:i32
    c_lo = mul bias, s_lo
    c_hi = mul bias, s_hi
    ret d, c_lo, c_hi

# dst[64t .. 64t + 64] = rows 64c .. 64c + 64 of `mat` times token t's int8 activations,
# for n tokens xs bytes apart in xq (their block records xs / 2 bytes apart in dx): eight at a
# time with qmat_chunk8 when vectors are 256 bits or wider, then four at a time with
# qmat_chunk4, the rest with qmat_chunk, so every result is exactly qmat_chunk's.
fn qmat_batch(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, n:i64, xs:i64)
  b0:
    ds = udiv xs, 2:i64
    # Tiles of 8 need 16 vector registers for their sums and weights: only with 256-bit
    # vectors or wider (x86 AVX2 and AVX-512, SVE), not 128-bit ones (Cranelift, NEON).
    w = vl i32
    wide = uge w, 8:i64
    br wide, tiles(0:i64), quad(0:i64)
  tiles(t:i64):
    t8 = add t, 8:i64
    full = le t8, n
    br full, tile_body, quad(t)
  tile_body:
    po, pxq, pdx = call qmat_tok(t, xq, dx, dst, xs, ds)
    call qmat_chunk8(c, mat, pxq, pdx, po, k, xs)
    jmp tiles(t8)
  quad(q:i64):
    q4 = add q, 4:i64
    four = le q4, n
    br four, quad_body, rest(q)
  quad_body:
    qo, qxq, qdx = call qmat_tok(q, xq, dx, dst, xs, ds)
    call qmat_chunk4(c, mat, qxq, qdx, qo, k, xs)
    jmp quad(q4)
  rest(r:i64):
    r_more = lt r, n
    br r_more, rest_body, done
  rest_body:
    ro, rxq, rdx = call qmat_tok(r, xq, dx, dst, xs, ds)
    call qmat_chunk(c, mat, rxq, rdx, ro, k)
    r2 = add r, 1:i64
    jmp rest(r2)
  done:
    ret

# Token t's results, int8 activations and block records for qmat_batch.
inline fn qmat_tok(t:i64, xq:ptr, dx:ptr, dst:ptr, xs:i64, ds:i64)->(ptr, ptr, ptr)
  b0:
    oo = mul t, 256:i64
    po = add dst, oo
    xo = mul t, xs
    pxq = add xq, xo
    dofs = mul t, ds
    pdx = add dx, dofs
    ret po, pxq, pdx

# Q8_0 quantization of x[0 .. k] (k a multiple of 32), as llama.cpp's quantize_row_q8_0:
# scale d = max|x in block b| / 127 and xq[32b + t] = round(x[32b + t] / d), halves away
# from zero. At full vector width: |x| with vabs, vround, then vftoi and two saturating
# vnarrows down to i8. Each block's 16-byte record at dx + 16b holds d (f32), the sums of
# its quantized values 0..15 and 16..31 (i32, for dot products with unsigned weights), and
# a zero i32.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    v_zi = splat 0:i32:vx
    v_one8 = splat 1:i8:vx
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = shl b, 5:i64
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    rest = sub 32:i64, t
    i = add base, t
    v = ldm x[i]:vx, rest:f32
    av = vabs v:f32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    ro = shl b, 4:i64
    rec = add dx, ro
    st rec, d
    st rec[3], 0:i32
    v_id = splat id:vx
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    rest_q = sub 32:i64, s
    iq = add base, s
    xv = ldm x[iq]:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    rv = vround sv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    cnt = min rest_q, w
    stm xq[iq], q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  block_next:
    # The block's two half sums: 4-byte sums by `vdot` with ones, over 16 bytes each.
    lo = ldm xq[base]:vx, 16:i8
    sl = vdot v_zi, lo, v_one8:i8
    s_lo = vsum sl:i32
    hb = add base, 16:i64
    hi = ldm xq[hb]:vx, 16:i8
    sh = vdot v_zi, hi, v_one8:i8
    s_hi = vsum sh:i32
    st rec[1], s_lo
    st rec[2], s_hi
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# RoPE ("rotate-half" layout) for one head of hd f32 values, in place: x[j] and x[j + hd/2]
# rotate by the angle whose cos and sin are cos[j] and sin[j] (one row of a RoPE table).
fn rope_half(x:ptr, hd:i64, cos:ptr, sin:ptr)
  b0:
    w = vl f32
    half = udiv hd, 2:i64
    v_zero = splat 0.0:f32:vx
    jmp cols(0:i64)
  cols(j:i64):
    j_more = lt j, half
    br j_more, cols_body, done
  cols_body:
    rest = sub half, j
    jh = add j, half
    x1 = ldm x[j]:vx, rest:f32
    x2 = ldm x[jh]:vx, rest:f32
    c = ldm cos[j]:vx, rest:f32
    s = ldm sin[j]:vx, rest:f32
    x2s = vmul x2, s:f32
    minus_x2s = vsub v_zero, x2s:f32
    y1 = vfma x1, c, minus_x2s:f32
    x2c = vmul x2, c:f32
    y2 = vfma x1, s, x2c:f32
    stm x[j], y1, rest:f32
    stm x[jh], y2, rest:f32
    j2 = add j, w
    jmp cols(j2)
  done:
    ret

# p[i] = exp(p[i] - shift) for i < n (vexp), in place; returns the sum. With shift = max(p),
# the numerators of a numerically stable softmax.
fn exp_shift(p:ptr, n:i64, shift:f32)->f32
  b0:
    w = vl f32
    v_shift = splat shift:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, sum(0:i64, v_zero)
  body:
    rest = sub n, i
    v = ldm p[i]:vx, rest:f32
    x0 = vsub v, v_shift:f32
    e = vexp x0:f32
    stm p[i], e, rest:f32
    i2 = add i, w
    jmp loop(i2)
  # Masked loads zero the lanes past n, so they add nothing.
  sum(j:i64, acc:vx):
    j_more = lt j, n
    br j_more, sum_body, done
  sum_body:
    j_rest = sub n, j
    ev = ldm p[j]:vx, j_rest:f32
    acc2 = vadd acc, ev:f32
    j2 = add j, w
    jmp sum(j2, acc2)
  done:
    total = vsum acc:f32
    ret total

# out = silu(gate) * up = gate * up / (1 + exp(-gate)) for n f32 values: SwiGLU's gating.
fn silu_mul(gate:ptr, up:ptr, out:ptr, n:i64)
  b0:
    w = vl f32
    v_one = splat 1.0:f32:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    g = ldm gate[i]:vx, rest:f32
    u = ldm up[i]:vx, rest:f32
    ng = vsub v_zero, g:f32
    e = vexp ng:f32
    den = vadd e, v_one:f32
    gu = vmul g, u:f32
    y = vdiv gu, den:f32
    stm out[i], y, rest:f32
    i2 = add i, w
    jmp loop(i2)
  done:
    ret

# Attention of `group` query heads (f32 rows of hd at qg) over nt >= 1 positions of one KV
# head: one split of flash-decoding. K is stored in tiles of 32 positions, each [hd x 32]
# bf16 (value j of position t at (t / 32 * 32 * hd + 32 j + t mod 32) * 2 bytes from kb),
# so a vector holds one value of consecutive positions; V in rows of hd bf16 from vb. For
# head r it writes at pg + r * head_b the max m of its scores (dot products times `scale`),
# the sum of exp(score - m), and the hd outputs sum_t exp(score_t - m) V[t], unnormalized;
# attn_merge combines splits. Scores take positions in lanes: each K vector, widened from
# bf16 once, gets 4 heads' FMAs with their query values broadcast (then one head at a time
# for the rest of the group), and no score needs a horizontal sum. Outputs take V's columns
# in lanes, 4 heads' sums in registers over all positions of the split.
fn attn_split(qg:ptr, kb:ptr, vb:ptr, pg:ptr, group:i64, hd:i64, nt:i64, scale:f32, head_b:i64)
  b0:
    w16 = vl bf16
    w32 = vl f32
    zero = splat 0.0:f32:vx
    v_scale = splat scale:vx
    low = cst -340282346638528859811704183484516925440.0:f32
    v_low = splat low:vx
    row2 = mul hd, 2:i64
    hd4 = mul hd, 4:i64
    tile_b = mul hd, 64:i64
    # positions per K load: all lanes up to a tile's 32, or 16 if they do not divide 32 (a
    # 384-bit SVE vector), so a load stays in one row of a tile; and the f32 lanes of each half
    lb0 = min w16, 32:i64
    lb_rem = urem 32:i64, lb0
    lb_fits = eq lb_rem, 0:i64
    lb = select lb_fits, lb0, 16:i64
    n_lo = min w32, lb
    n_hi = sub lb, n_lo
    # scores [group x ntp], ntp = nt rounded up to a tile
    nt31 = add nt, 31:i64
    ntp0 = ushr nt31, 5:i64
    ntp = mul ntp0, 32:i64
    ntb = mul ntp, 4:i64
    sc_bytes = mul group, ntb
    sc = alloc sc_bytes
    quads_end0 = udiv group, 4:i64
    quads_end = mul quads_end0, 4:i64
    jmp score(0:i64)

  # Scores of positions t .. t + lb: 4 heads at a time, each K vector widened once for the 4.
  score(t:i64):
    t_more = lt t, nt
    br t_more, score_start, softmax(0:i64)
  score_start:
    tile = ushr t, 5:i64
    tin = and t, 31:i64
    k_off0 = mul tile, tile_b
    k_off1 = mul tin, 2:i64
    k_off = add k_off0, k_off1
    kt = add kb, k_off
    jmp sq_heads(0:i64)
  sq_heads(r:i64):
    r_more = lt r, quads_end
    br r_more, sq_start, ss_heads(r)
  sq_start:
    qr_off = mul r, hd4
    q0 = add qg, qr_off
    q1 = add q0, hd4
    q2 = add q1, hd4
    q3 = add q2, hd4
    jmp sq_dot(0:i64, kt, zero, zero, zero, zero, zero, zero, zero, zero)
  sq_dot(j:i64, kj:ptr, a0l:vx, a0h:vx, a1l:vx, a1h:vx, a2l:vx, a2h:vx, a3l:vx, a3h:vx):
    j_more = lt j, hd
    br j_more, sq_dot_body, sq_store
  sq_dot_body:
    kv = ldm kj:vx, lb:bf16
    klo = vfwidenlo kv:bf16
    khi = vfwidenhi kv:bf16
    x0 = ld q0[j]:f32
    qy0 = splat x0:vx
    b0l = vfma klo, qy0, a0l:f32
    b0h = vfma khi, qy0, a0h:f32
    x1 = ld q1[j]:f32
    qy1 = splat x1:vx
    b1l = vfma klo, qy1, a1l:f32
    b1h = vfma khi, qy1, a1h:f32
    x2 = ld q2[j]:f32
    qy2 = splat x2:vx
    b2l = vfma klo, qy2, a2l:f32
    b2h = vfma khi, qy2, a2h:f32
    x3 = ld q3[j]:f32
    qy3 = splat x3:vx
    b3l = vfma klo, qy3, a3l:f32
    b3h = vfma khi, qy3, a3h:f32
    j2 = add j, 1:i64
    kj2 = add kj, 64:i64
    jmp sq_dot(j2, kj2, b0l, b0h, b1l, b1h, b2l, b2h, b3l, b3h)
  sq_store:
    si0 = mul r, ntp
    si = add si0, t
    call score_store(sc, si, w32, a0l, a0h, v_scale, n_lo, n_hi)
    si1 = add si, ntp
    call score_store(sc, si1, w32, a1l, a1h, v_scale, n_lo, n_hi)
    si2 = add si1, ntp
    call score_store(sc, si2, w32, a2l, a2h, v_scale, n_lo, n_hi)
    si3 = add si2, ntp
    call score_store(sc, si3, w32, a3l, a3h, v_scale, n_lo, n_hi)
    r4 = add r, 4:i64
    jmp sq_heads(r4)
  # The rest of the group, one head at a time.
  ss_heads(u:i64):
    u_more = lt u, group
    br u_more, ss_start, score_next
  ss_start:
    qu_off = mul u, hd4
    qu = add qg, qu_off
    jmp ss_dot(0:i64, kt, zero, zero)
  ss_dot(sj:i64, skj:ptr, accl:vx, acch:vx):
    sj_more = lt sj, hd
    br sj_more, ss_dot_body, ss_store
  ss_dot_body:
    skv = ldm skj:vx, lb:bf16
    sklo = vfwidenlo skv:bf16
    skhi = vfwidenhi skv:bf16
    sx = ld qu[sj]:f32
    sy = splat sx:vx
    accl2 = vfma sklo, sy, accl:f32
    acch2 = vfma skhi, sy, acch:f32
    sj2 = add sj, 1:i64
    skj2 = add skj, 64:i64
    jmp ss_dot(sj2, skj2, accl2, acch2)
  ss_store:
    su0 = mul u, ntp
    su = add su0, t
    call score_store(sc, su, w32, accl, acch, v_scale, n_lo, n_hi)
    u2 = add u, 1:i64
    jmp ss_heads(u2)
  score_next:
    t2 = add t, lb
    jmp score(t2)

  # Per head: the split's max (whole vectors, then the rest one by one), then the
  # exponentials in place and their sum.
  softmax(h:i64):
    h_more = lt h, group
    br h_more, sm_head, pv(0:i64)
  sm_head:
    srow0 = mul h, ntb
    srow = add sc, srow0
    jmp sm_vmax(0:i64, v_low)
  sm_vmax(um:i64, mv:vx):
    u_end = add um, w32
    u_full = le u_end, nt
    br u_full, sm_vmax_body, sm_reduce
  sm_vmax_body:
    sv = ld srow[um:f32]:vx
    mv2 = vmax mv, sv:f32
    jmp sm_vmax(u_end, mv2)
  sm_reduce:
    mr = vmaxr mv:f32
    jmp sm_smax(um, mr)
  sm_smax(uu:i64, mx:f32):
    uu_more = lt uu, nt
    br uu_more, sm_smax_body, sm_exp
  sm_smax_body:
    s1 = ld srow[uu]:f32
    mx2 = max mx, s1
    uu2 = add uu, 1:i64
    jmp sm_smax(uu2, mx2)
  sm_exp:
    total = call exp_shift(srow, nt, mx)
    pr_off = mul h, head_b
    prow = add pg, pr_off
    st prow, mx
    st prow[1], total
    h2 = add h, 1:i64
    jmp softmax(h2)

  # o[r] = sum_t p[r][t] V[t], one vector of V's columns at a time (outer loop), so the 4
  # heads' sums for it stay in registers over all positions of the split.
  pv(c:i64):
    c_more = lt c, hd
    br c_more, pv_cols, done
  pv_cols:
    c_rest = sub hd, c
    c_rest_hi0 = sub c_rest, w32
    c_rest_hi = max c_rest_hi0, 0:i64
    c_hi = add c, w32
    jmp pq_heads(0:i64)
  pq_heads(pr:i64):
    pr_more = lt pr, quads_end
    br pr_more, pq_start, ps_heads(pr)
  pq_start:
    p0 = mul pr, ntb
    pp0 = add sc, p0
    pp1 = add pp0, ntb
    pp2 = add pp1, ntb
    pp3 = add pp2, ntb
    jmp pq_pos(0:i64, zero, zero, zero, zero, zero, zero, zero, zero)
  pq_pos(pt:i64, o0l:vx, o0h:vx, o1l:vx, o1h:vx, o2l:vx, o2h:vx, o3l:vx, o3h:vx):
    pt_more = lt pt, nt
    br pt_more, pq_pos_body, pq_store
  pq_pos_body:
    v_off = mul pt, row2
    vt = add vb, v_off
    vv = ldm vt[c]:vx, c_rest:bf16
    vlo = vfwidenlo vv:bf16
    vhi = vfwidenhi vv:bf16
    y0 = ld pp0[pt]:f32
    vy0 = splat y0:vx
    n0l = vfma vlo, vy0, o0l:f32
    n0h = vfma vhi, vy0, o0h:f32
    y1 = ld pp1[pt]:f32
    vy1 = splat y1:vx
    n1l = vfma vlo, vy1, o1l:f32
    n1h = vfma vhi, vy1, o1h:f32
    y2 = ld pp2[pt]:f32
    vy2 = splat y2:vx
    n2l = vfma vlo, vy2, o2l:f32
    n2h = vfma vhi, vy2, o2h:f32
    y3 = ld pp3[pt]:f32
    vy3 = splat y3:vx
    n3l = vfma vlo, vy3, o3l:f32
    n3h = vfma vhi, vy3, o3h:f32
    pt2 = add pt, 1:i64
    jmp pq_pos(pt2, n0l, n0h, n1l, n1h, n2l, n2h, n3l, n3h)
  pq_store:
    po_off = mul pr, head_b
    or0 = add pg, po_off
    od0 = add or0, 8:i64
    stm od0[c], o0l, c_rest:f32
    stm od0[c_hi], o0h, c_rest_hi:f32
    od1 = add od0, head_b
    stm od1[c], o1l, c_rest:f32
    stm od1[c_hi], o1h, c_rest_hi:f32
    od2 = add od1, head_b
    stm od2[c], o2l, c_rest:f32
    stm od2[c_hi], o2h, c_rest_hi:f32
    od3 = add od2, head_b
    stm od3[c], o3l, c_rest:f32
    stm od3[c_hi], o3h, c_rest_hi:f32
    pr4 = add pr, 4:i64
    jmp pq_heads(pr4)
  ps_heads(ph:i64):
    ph_more = lt ph, group
    br ph_more, ps_start, pv_next
  ps_start:
    ps0 = mul ph, ntb
    pps = add sc, ps0
    jmp ps_pos(0:i64, zero, zero)
  ps_pos(st_:i64, osl:vx, osh:vx):
    st_more = lt st_, nt
    br st_more, ps_pos_body, ps_store
  ps_pos_body:
    sv_off = mul st_, row2
    svt = add vb, sv_off
    svv = ldm svt[c]:vx, c_rest:bf16
    svlo = vfwidenlo svv:bf16
    svhi = vfwidenhi svv:bf16
    ys = ld pps[st_]:f32
    vys = splat ys:vx
    nsl = vfma svlo, vys, osl:f32
    nsh = vfma svhi, vys, osh:f32
    st2 = add st_, 1:i64
    jmp ps_pos(st2, nsl, nsh)
  ps_store:
    pso_off = mul ph, head_b
    psr = add pg, pso_off
    psd = add psr, 8:i64
    stm psd[c], osl, c_rest:f32
    stm psd[c_hi], osh, c_rest_hi:f32
    ph2 = add ph, 1:i64
    jmp ps_heads(ph2)
  pv_next:
    c2 = add c, w16
    jmp pv(c2)
  done:
    free sc
    ret

# Stores the scores of attn_split's lb positions from its two f32 halves (lo, hi; n_lo and
# n_hi lanes) at sc[si ..], times scale.
inline fn score_store(sc:ptr, si:i64, w32:i64, lo:vx, hi:vx, v_scale:vx, n_lo:i64, n_hi:i64)
  b0:
    slo = vmul lo, v_scale:f32
    stm sc[si], slo, n_lo:f32
    si_hi = add si, w32
    shi = vmul hi, v_scale:f32
    stm sc[si_hi], shi, n_hi:f32
    ret

# Merges `splits` flash-decoding splits of one query head (attn_split's records: max, sum,
# hd outputs; rowb bytes apart from hp) into out[0 .. hd]: each split's outputs and sum are
# rescaled by exp(m_split - m) for the overall max m, added in split order, and the outputs
# divided by the total.
fn attn_merge(hp:ptr, splits:i64, rowb:i64, hd:i64, oh:ptr)
  b0:
    w = vl f32
    z = cst 0.0:f32
    zero = splat z:vx
    m0 = ld hp:f32
    jmp mmax(1:i64, m0)
  mmax(s:i64, mx:f32):
    s_more = lt s, splits
    br s_more, mmax_body, zero_out(0:i64)
  mmax_body:
    ps_off = mul s, rowb
    ps = add hp, ps_off
    ms = ld ps:f32
    mx2 = max mx, ms
    s2 = add s, 1:i64
    jmp mmax(s2, mx2)
  zero_out(zo:i64):
    zo_more = lt zo, hd
    br zo_more, zero_out_body, splits_loop(0:i64, z)
  zero_out_body:
    zo_rest = sub hd, zo
    stm oh[zo], zero, zo_rest:f32
    zo2 = add zo, w
    jmp zero_out(zo2)
  # out += exp(m_s - m) o_s, total += exp(m_s - m) l_s
  splits_loop(sp:i64, tot:f32):
    sp_more = lt sp, splits
    br sp_more, split_start, finish
  split_start:
    sp_off = mul sp, rowb
    sp_row = add hp, sp_off
    m_s = ld sp_row:f32
    l_s = ld sp_row[1]:f32
    dm = sub m_s, mx
    vdm = splat dm:vx
    ve = vexp vdm:f32
    e = extlane ve, 0:f32
    tot2 = fma l_s, e, tot
    o_s = add sp_row, 8:i64
    jmp acc_cols(0:i64)
  acc_cols(c:i64):
    c_more = lt c, hd
    br c_more, acc_body, split_next
  acc_body:
    c_rest = sub hd, c
    ov = ldm o_s[c]:vx, c_rest:f32
    cur = ldm oh[c]:vx, c_rest:f32
    nv = vfma ov, ve, cur:f32
    stm oh[c], nv, c_rest:f32
    c2 = add c, w
    jmp acc_cols(c2)
  split_next:
    sp2 = add sp, 1:i64
    jmp splits_loop(sp2, tot2)
  finish:
    inv = div 1.0:f32, tot
    vinv = splat inv:vx
    jmp scale_cols(0:i64)
  scale_cols(f:i64):
    f_more = lt f, hd
    br f_more, scale_body, done
  scale_body:
    f_rest = sub hd, f
    fv = ldm oh[f]:vx, f_rest:f32
    fv2 = vmul fv, vinv:f32
    stm oh[f], fv2, f_rest:f32
    f2 = add f, w
    jmp scale_cols(f2)
  done:
    ret

# Adds x to the f32 at p, which other `par` calls may update at the same time, and returns
# the value it replaced. p must be 4-byte aligned. A `cas` loop on the bits: it retries
# while another call changes the value between its read and its swap.
inline fn atomic_add_f32(p:ptr, x:f32)->f32
  b0:
    jmp retry
  retry:
    bits = atomic ld p:i32
    old = bitcast bits:f32
    sum = add old, x
    new = bitcast sum:i32
    seen = atomic cas p, bits, new
    swapped = eq seen, bits
    br swapped, done, retry
  done:
    ret old

# atomic_add_f32 for the f64 at p (8-byte aligned).
inline fn atomic_add_f64(p:ptr, x:f64)->f64
  b0:
    jmp retry
  retry:
    bits = atomic ld p:i64
    old = bitcast bits:f64
    sum = add old, x
    new = bitcast sum:i64
    seen = atomic cas p, bits, new
    swapped = eq seen, bits
    br swapped, done, retry
  done:
    ret old
