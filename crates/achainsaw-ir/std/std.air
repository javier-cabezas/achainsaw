# AIR standard library: building blocks that modules import with a top-level `use` line,
#   use quantize_q8, qmat_chunk
# which links these functions (and the library functions they call) into the module.
# Every function here is validated and tested; see crates/achainsaw-ir/src/stdlib.rs.

# dst[0 .. 64] = rows 64c .. 64c + 64 of the quantized matrix `mat` times the int8
# activations xq (scales dx per 32-block, from quantize_q8); k is the matrix's row length.
# `mat` points to 3 words: packed weights, f16 scales, format (0 Q8_0, 1 Q4_0, 2 Q6_K).
# Weights come in chunks of 64 rows; per 32-block of a chunk, each group of 4 consecutive
# values of a row fills one 32-bit lane, so `vdot` multiplies them by 4 activations:
#   Q8_0 (format 0): 2048 bytes: byte (g * 64 + j) * 4 + q is row j's value 4g + q (g < 8).
#   Q4_0 (format 1): 1024 bytes: byte (g * 64 + j) * 4 + q (g < 4) holds row j's values
#                    4g + q (low nibble) and 16 + 4g + q (high), offset by 8: GGUF's own
#                    nibble bytes, regrouped.
#   Q6_K (format 2): 1536 bytes: the low 4 bits of the values offset by 32, as Q4_0's
#                    nibbles, then 512 bytes whose byte (g * 64 + j) * 4 + q (g < 2) holds
#                    the high 2 bits of row j's value 8p + 4g + q in bit pair p (p < 4).
# Scales are f16 [64] vectors per block: one for Q8_0 and Q4_0, two for Q6_K (one per 16
# values). Blocks are the outer loop, so each block's bytes are read in one pass; for each
# strip of `vl i32` rows, two exact int32 dot chains (values 0..15 and 16..31, Q6_K's two
# scale groups) are converted and added as scale * dx * dot into dst. The steps are the
# inline functions below, shared with qmat_chunk4, so both give the same bits per token.
fn qmat_chunk(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt = call qmat_layout(c, mat, k)
    is_q4 = eq fmt, 1:i64
    is_q6 = eq fmt, 2:i64
    w = vl i32
    zf = splat 0.0:f32:vx
    zi = splat 0:i32:vx
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 64:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb = add xq, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    d = ld dx[b]:f32
    jmp strips(0:i64)
  strips(j:i64):
    j_more = lt j, 64:i64
    br j_more, strip_start, block_next
  strip_start:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    br is_q4, q4(0:i64, zi, zi), not_q4
  not_q4:
    br is_q6, q6(0:i64, zi, zi), q8(0:i64, zi, zi)
  q8(g8:i64, a8l:vx, a8h:vx):
    m8 = lt g8, 4:i64
    br m8, q8_body, scale(a8l, a8h)
  q8_body:
    w8l, w8h = call qmat_w8(wb, g8)
    d8l, d8h = call qmat_dot(xb, g8, w8l, w8h, a8l, a8h)
    g8n = add g8, 1:i64
    jmp q8(g8n, d8l, d8h)
  q4(g4:i64, a4l:vx, a4h:vx):
    m4 = lt g4, 4:i64
    br m4, q4_body, scale(a4l, a4h)
  q4_body:
    w4l, w4h = call qmat_w4(wb, g4)
    d4l, d4h = call qmat_dot(xb, g4, w4l, w4h, a4l, a4h)
    g4n = add g4, 1:i64
    jmp q4(g4n, d4l, d4h)
  q6(g6:i64, a6l:vx, a6h:vx):
    m6 = lt g6, 4:i64
    br m6, q6_body, scale(a6l, a6h)
  q6_body:
    w6l, w6h = call qmat_w6(wb, g6)
    d6l, d6h = call qmat_dot(xb, g6, w6l, w6h, a6l, a6h)
    g6n = add g6, 1:i64
    jmp q6(g6n, d6l, d6h)
  scale(sl:vx, sh:vx):
    rest = sub 64:i64, j
    s = call qmat_scale(sb, j, rest)
    py = add dst, j4
    br is_q6, scale6, scale4
  scale4:
    call qmat_acc1(py, sl, sh, s, d)
    j2 = add j, w
    jmp strips(j2)
  scale6:
    jh = add j, 64:i64
    s1 = call qmat_scale(sb, jh, rest)
    call qmat_acc2(py, sl, sh, s, s1, d)
    j3 = add j, w
    jmp strips(j3)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# qmat_chunk for 4 tokens at once: token t's int8 activations at xq + t * xs, its scales
# at dx + t * xs / 8, its 64 results at dst + 256 t. Each weight vector is loaded and
# unpacked once for the four tokens; every token goes through qmat_chunk's steps, so its
# results are exactly qmat_chunk's.
fn qmat_chunk4(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, xs:i64)
  b0:
    wb0_, sc, nb, blk, sc_blk, fmt = call qmat_layout(c, mat, k)
    is_q4 = eq fmt, 1:i64
    is_q6 = eq fmt, 2:i64
    w = vl i32
    zf = splat 0.0:f32:vx
    zi = splat 0:i32:vx
    xq1 = add xq, xs
    xq2 = add xq1, xs
    xq3 = add xq2, xs
    ds = udiv xs, 8:i64
    dx1 = add dx, ds
    dx2 = add dx1, ds
    dx3 = add dx2, ds
    dst1 = add dst, 256:i64
    dst2 = add dst, 512:i64
    dst3 = add dst, 768:i64
    jmp zero(0:i64)
  zero(z:i64):
    z_more = lt z, 256:i64
    br z_more, zero_body, blocks(0:i64)
  zero_body:
    st dst[z:f32], zf
    z2 = add z, w
    jmp zero(z2)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    blk_off = mul b, blk
    wb0 = add wb0_, blk_off
    xo = shl b, 5:i64
    xb0 = add xq, xo
    xb1 = add xq1, xo
    xb2 = add xq2, xo
    xb3 = add xq3, xo
    sb_off = mul b, sc_blk
    sb = add sc, sb_off
    d0 = ld dx[b]:f32
    d1 = ld dx1[b]:f32
    d2 = ld dx2[b]:f32
    d3 = ld dx3[b]:f32
    jmp strips(0:i64)
  strips(j:i64):
    j_more = lt j, 64:i64
    br j_more, strip_start, block_next
  strip_start:
    j4 = shl j, 2:i64
    wb = add wb0, j4
    br is_q4, q4(0:i64, zi, zi, zi, zi, zi, zi, zi, zi), not_q4
  not_q4:
    br is_q6, q6(0:i64, zi, zi, zi, zi, zi, zi, zi, zi), q8(0:i64, zi, zi, zi, zi, zi, zi, zi, zi)
  q8(g8:i64, a0l:vx, a0h:vx, a1l:vx, a1h:vx, a2l:vx, a2h:vx, a3l:vx, a3h:vx):
    m8 = lt g8, 4:i64
    br m8, q8_body, scale(a0l, a0h, a1l, a1h, a2l, a2h, a3l, a3h)
  q8_body:
    w8l, w8h = call qmat_w8(wb, g8)
    e0l, e0h = call qmat_dot(xb0, g8, w8l, w8h, a0l, a0h)
    e1l, e1h = call qmat_dot(xb1, g8, w8l, w8h, a1l, a1h)
    e2l, e2h = call qmat_dot(xb2, g8, w8l, w8h, a2l, a2h)
    e3l, e3h = call qmat_dot(xb3, g8, w8l, w8h, a3l, a3h)
    g8n = add g8, 1:i64
    jmp q8(g8n, e0l, e0h, e1l, e1h, e2l, e2h, e3l, e3h)
  q4(g4:i64, b0l:vx, b0h:vx, b1l:vx, b1h:vx, b2l:vx, b2h:vx, b3l:vx, b3h:vx):
    m4 = lt g4, 4:i64
    br m4, q4_body, scale(b0l, b0h, b1l, b1h, b2l, b2h, b3l, b3h)
  q4_body:
    w4l, w4h = call qmat_w4(wb, g4)
    f0l, f0h = call qmat_dot(xb0, g4, w4l, w4h, b0l, b0h)
    f1l, f1h = call qmat_dot(xb1, g4, w4l, w4h, b1l, b1h)
    f2l, f2h = call qmat_dot(xb2, g4, w4l, w4h, b2l, b2h)
    f3l, f3h = call qmat_dot(xb3, g4, w4l, w4h, b3l, b3h)
    g4n = add g4, 1:i64
    jmp q4(g4n, f0l, f0h, f1l, f1h, f2l, f2h, f3l, f3h)
  q6(g6:i64, c0l:vx, c0h:vx, c1l:vx, c1h:vx, c2l:vx, c2h:vx, c3l:vx, c3h:vx):
    m6 = lt g6, 4:i64
    br m6, q6_body, scale(c0l, c0h, c1l, c1h, c2l, c2h, c3l, c3h)
  q6_body:
    w6l, w6h = call qmat_w6(wb, g6)
    h0l, h0h = call qmat_dot(xb0, g6, w6l, w6h, c0l, c0h)
    h1l, h1h = call qmat_dot(xb1, g6, w6l, w6h, c1l, c1h)
    h2l, h2h = call qmat_dot(xb2, g6, w6l, w6h, c2l, c2h)
    h3l, h3h = call qmat_dot(xb3, g6, w6l, w6h, c3l, c3h)
    g6n = add g6, 1:i64
    jmp q6(g6n, h0l, h0h, h1l, h1h, h2l, h2h, h3l, h3h)
  scale(s0l:vx, s0h:vx, s1l:vx, s1h:vx, s2l:vx, s2h:vx, s3l:vx, s3h:vx):
    rest = sub 64:i64, j
    s = call qmat_scale(sb, j, rest)
    py0 = add dst, j4
    py1 = add dst1, j4
    py2 = add dst2, j4
    py3 = add dst3, j4
    br is_q6, scale6, scale4
  scale4:
    call qmat_acc1(py0, s0l, s0h, s, d0)
    call qmat_acc1(py1, s1l, s1h, s, d1)
    call qmat_acc1(py2, s2l, s2h, s, d2)
    call qmat_acc1(py3, s3l, s3h, s, d3)
    j2 = add j, w
    jmp strips(j2)
  scale6:
    jh = add j, 64:i64
    s1 = call qmat_scale(sb, jh, rest)
    call qmat_acc2(py0, s0l, s0h, s, s1, d0)
    call qmat_acc2(py1, s1l, s1h, s, s1, d1)
    call qmat_acc2(py2, s2l, s2h, s, s1, d2)
    call qmat_acc2(py3, s3l, s3h, s, s1, d3)
    j3 = add j, w
    jmp strips(j3)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# Chunk c of `mat` (see qmat_chunk): its weights, its scales, the number of 32-blocks of a
# row, the bytes per block of weights and of scales, and the format.
inline fn qmat_layout(c:i64, mat:ptr, k:i64)->(ptr, ptr, i64, i64, i64, i64)
  b0:
    wq = ld mat:ptr
    scales = ld mat[1]:ptr
    fmt = ld mat[2]:i64
    is_q4 = eq fmt, 1:i64
    is_q6 = eq fmt, 2:i64
    nb = udiv k, 32:i64
    blk_a = select is_q4, 1024:i64, 2048:i64
    blk = select is_q6, 1536:i64, blk_a
    nsub = select is_q6, 2:i64, 1:i64
    sc_blk = shl nsub, 7:i64
    chunk_w = mul nb, blk
    w_off = mul c, chunk_w
    wc = add wq, w_off
    chunk_s = mul nb, sc_blk
    s_off = mul c, chunk_s
    sc = add scales, s_off
    ret wc, sc, nb, blk, sc_blk, fmt

# Q8_0 weights of groups g and g + 4 for the strip of rows at wb (int8 lanes).
inline fn qmat_w8(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    wl = ld wb[o:i8]:vx
    oh = add o, 1024:i64
    wh = ld wb[oh:i8]:vx
    ret wl, wh

# Q4_0 weights of groups g and g + 4: the low and high nibbles of one byte vector, minus 8.
inline fn qmat_w4(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    eight = splat 8:i8:vx
    lo = vand nv, mask:i8
    wl = vsub lo, eight:i8
    hi = vushr nv, 4:i8
    wh = vsub hi, eight:i8
    ret wl, wh

# Q6_K weights of groups g and g + 4: Q4_0's nibbles with their high 2 bits from the
# second plane (group g % 2, bit pairs g / 2 and g / 2 + 2), minus 32.
inline fn qmat_w6(wb:ptr, g:i64)->(vx, vx)
  b0:
    o = shl g, 8:i64
    nv = ld wb[o:i8]:vx
    mask = splat 15:i8:vx
    three = splat 3:i8:vx
    off = splat 32:i8:vx
    l4 = vand nv, mask:i8
    h4 = vushr nv, 4:i8
    gp = and g, 1:i64
    po = shl gp, 8:i64
    ho = add po, 1024:i64
    hp = ld wb[ho:i8]:vx
    pair = ushr g, 1:i64
    shl_lo = shl pair, 1:i64
    shl_hi = add shl_lo, 4:i64
    bl0 = vushr hp, shl_lo:i8
    bl = vand bl0, three:i8
    bl4 = vshl bl, 4:i8
    wla = vor l4, bl4:i8
    wl = vsub wla, off:i8
    bh0 = vushr hp, shl_hi:i8
    bh = vand bh0, three:i8
    bh4 = vshl bh, 4:i8
    wha = vor h4, bh4:i8
    wh = vsub wha, off:i8
    ret wl, wh

# One token's dots for groups g and g + 4: dl += wl . x[4g .. 4g + 4] and dh += wh .
# x[16 + 4g .. 20 + 4g] in every 32-bit lane, x being the token's 32-value block at xb.
inline fn qmat_dot(xb:ptr, g:i64, wl:vx, wh:vx, dl:vx, dh:vx)->(vx, vx)
  b0:
    xl = ld xb[g]:i32
    gh = add g, 4:i64
    xh = ld xb[gh]:i32
    vxl = splat xl:vx
    vxh = splat xh:vx
    dl2 = vdot dl, wl, vxl:i8
    dh2 = vdot dh, wh, vxh:i8
    ret dl2, dh2

# f16 scales sb[i ..] of a strip's rows (at most n of them), widened to f32: scale group
# 0 of rows j .. at sb[j], Q6_K's group 1 at sb[j + 64].
inline fn qmat_scale(sb:ptr, i:i64, n:i64)->vx
  b0:
    h = ldm sb[i]:vx, n:f16
    s = vfwidenlo h:f16
    ret s

# A token's f32 sums at py += s * d * (dl + dh): Q8_0 and Q4_0, one scale per block.
inline fn qmat_acc1(py:ptr, dl:vx, dh:vx, s:vx, d:f32)
  b0:
    acc = ld py:vx
    vd = splat d:vx
    ds = vmul s, vd:f32
    dsum = vadd dl, dh:i32
    pf = vitof dsum:f32
    acc2 = vfma pf, ds, acc:f32
    st py, acc2
    ret

# A token's f32 sums at py += s * d * dl, then += s1 * d * dh: Q6_K's two scale groups.
inline fn qmat_acc2(py:ptr, dl:vx, dh:vx, s:vx, s1:vx, d:f32)
  b0:
    acc = ld py:vx
    vd = splat d:vx
    ds = vmul s, vd:f32
    pfl = vitof dl:f32
    accl = vfma pfl, ds, acc:f32
    ds1 = vmul s1, vd:f32
    pfh = vitof dh:f32
    acch = vfma pfh, ds1, accl:f32
    st py, acch
    ret

# dst[64t .. 64t + 64] = rows 64c .. 64c + 64 of `mat` times token t's int8 activations,
# for n tokens xs bytes apart in xq (their scales xs / 8 bytes apart in dx): four at a time
# with qmat_chunk4, the rest with qmat_chunk, so every result is exactly qmat_chunk's.
fn qmat_batch(c:i64, mat:ptr, xq:ptr, dx:ptr, dst:ptr, k:i64, n:i64, xs:i64)
  b0:
    ds = udiv xs, 8:i64
    jmp tiles(0:i64)
  tiles(t:i64):
    t4 = add t, 4:i64
    full = le t4, n
    br full, tile_body, rest(t)
  tile_body:
    xo = mul t, xs
    pxq = add xq, xo
    dofs = mul t, ds
    pdx = add dx, dofs
    oo = mul t, 256:i64
    po = add dst, oo
    call qmat_chunk4(c, mat, pxq, pdx, po, k, xs)
    jmp tiles(t4)
  rest(r:i64):
    r_more = lt r, n
    br r_more, rest_body, done
  rest_body:
    rxo = mul r, xs
    rxq = add xq, rxo
    rdo = mul r, ds
    rdx = add dx, rdo
    roo = mul r, 256:i64
    ro = add dst, roo
    call qmat_chunk(c, mat, rxq, rdx, ro, k)
    r2 = add r, 1:i64
    jmp rest(r2)
  done:
    ret

# Q8_0 quantization of x[0 .. k] (k a multiple of 32), as llama.cpp's quantize_row_q8_0:
# dx[b] = max|x in block b| / 127 and xq[32b + t] = round(x[32b + t] / dx[b]), halves away
# from zero. At full vector width: |x| with vabs, vround, then vftoi and two saturating
# vnarrows down to i8.
fn quantize_q8(x:ptr, xq:ptr, dx:ptr, k:i64)
  b0:
    w = vl f32
    nb = udiv k, 32:i64
    zf = cst 0.0:f32
    v_zero = splat zf:vx
    jmp blocks(0:i64)
  blocks(b:i64):
    b_more = lt b, nb
    br b_more, block_start, done
  block_start:
    base = shl b, 5:i64
    jmp amax(0:i64, v_zero)
  amax(t:i64, a:vx):
    t_more = lt t, 32:i64
    br t_more, amax_body, scale
  amax_body:
    rest = sub 32:i64, t
    i = add base, t
    v = ldm x[i]:vx, rest:f32
    av = vabs v:f32
    a2 = vmax a, av:f32
    t2 = add t, w
    jmp amax(t2, a2)
  scale:
    am = vmaxr a:f32
    d = div am, 127.0:f32
    pos = gt d, zf
    inv = div 1.0:f32, d
    id = select pos, inv, zf
    st dx[b], d
    v_id = splat id:vx
    jmp quant(0:i64)
  quant(s:i64):
    s_more = lt s, 32:i64
    br s_more, quant_body, block_next
  quant_body:
    rest_q = sub 32:i64, s
    iq = add base, s
    xv = ldm x[iq]:vx, rest_q:f32
    sv = vmul xv, v_id:f32
    rv = vround sv:f32
    qi = vftoi rv:i32
    q16 = vnarrow qi, qi:i16
    q8 = vnarrow q16, q16:i8
    cnt = min rest_q, w
    stm xq[iq], q8, cnt:i8
    s2 = add s, w
    jmp quant(s2)
  block_next:
    b2 = add b, 1:i64
    jmp blocks(b2)
  done:
    ret

# RoPE ("rotate-half" layout) for one head of hd f32 values, in place: x[j] and x[j + hd/2]
# rotate by the angle whose cos and sin are cos[j] and sin[j] (one row of a RoPE table).
fn rope_half(x:ptr, hd:i64, cos:ptr, sin:ptr)
  b0:
    w = vl f32
    half = udiv hd, 2:i64
    v_zero = splat 0.0:f32:vx
    jmp cols(0:i64)
  cols(j:i64):
    j_more = lt j, half
    br j_more, cols_body, done
  cols_body:
    rest = sub half, j
    jh = add j, half
    x1 = ldm x[j]:vx, rest:f32
    x2 = ldm x[jh]:vx, rest:f32
    c = ldm cos[j]:vx, rest:f32
    s = ldm sin[j]:vx, rest:f32
    x2s = vmul x2, s:f32
    minus_x2s = vsub v_zero, x2s:f32
    y1 = vfma x1, c, minus_x2s:f32
    x2c = vmul x2, c:f32
    y2 = vfma x1, s, x2c:f32
    stm x[j], y1, rest:f32
    stm x[jh], y2, rest:f32
    j2 = add j, w
    jmp cols(j2)
  done:
    ret

# p[i] = exp(p[i] - shift) for i < n (vexp), in place; returns the sum. With shift = max(p),
# the numerators of a numerically stable softmax.
fn exp_shift(p:ptr, n:i64, shift:f32)->f32
  b0:
    w = vl f32
    v_shift = splat shift:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, sum(0:i64, v_zero)
  body:
    rest = sub n, i
    v = ldm p[i]:vx, rest:f32
    x0 = vsub v, v_shift:f32
    e = vexp x0:f32
    stm p[i], e, rest:f32
    i2 = add i, w
    jmp loop(i2)
  # Masked loads zero the lanes past n, so they add nothing.
  sum(j:i64, acc:vx):
    j_more = lt j, n
    br j_more, sum_body, done
  sum_body:
    j_rest = sub n, j
    ev = ldm p[j]:vx, j_rest:f32
    acc2 = vadd acc, ev:f32
    j2 = add j, w
    jmp sum(j2, acc2)
  done:
    total = vsum acc:f32
    ret total

# out = silu(gate) * up = gate * up / (1 + exp(-gate)) for n f32 values: SwiGLU's gating.
fn silu_mul(gate:ptr, up:ptr, out:ptr, n:i64)
  b0:
    w = vl f32
    v_one = splat 1.0:f32:vx
    v_zero = splat 0.0:f32:vx
    jmp loop(0:i64)
  loop(i:i64):
    more = lt i, n
    br more, body, done
  body:
    rest = sub n, i
    g = ldm gate[i]:vx, rest:f32
    u = ldm up[i]:vx, rest:f32
    ng = vsub v_zero, g:f32
    e = vexp ng:f32
    den = vadd e, v_one:f32
    gu = vmul g, u:f32
    y = vdiv gu, den:f32
    stm out[i], y, rest:f32
    i2 = add i, w
    jmp loop(i2)
  done:
    ret
