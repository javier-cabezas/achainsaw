    g0a4, g1a4, g2a4, g3a4, g4a4, g5a4, g6a4, g7a4 = call qmat_accm8(e_a4, s_a4, s1_a4, f0a4, f1a4, f2a4, f3a4, f4a4, f5a4, f6a4, f7a4, r0a4, r1a4, r2a4, r3a4, r4a4, r5a4, r6a4, r7a4)
    ba42 = add ba4, 1:i64
